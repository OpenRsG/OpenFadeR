import { Chip, Dropdown, Fader, Icon, IconButton, Knob, Meter } from "widgets.slint";
import { Theme } from "theme.slint";
import { DeckState } from "deck-state.slint";
import { MixerState, ChannelView } from "mixer.slint";

/// Transport and crossfader stay available while browsing any full-app workspace.
export component TouchTransport inherits Rectangle {
    property <int> columns: root.width < 440px ? 1 : 2;
    height: ceil(DeckState.count / root.columns) * (Theme.touch-target + 2px) + Theme.touch-target + 8px;
    background: Theme.panel;
    for i in DeckState.count: HorizontalLayout {
        property <int> d: DeckState.slots[i];
        x: Math.mod(i, root.columns) * root.width / root.columns + 4px;
        y: Math.floor(i / root.columns) * (Theme.touch-target + 2px) + 4px;
        width: root.width / root.columns - 8px; height: Theme.touch-target;
        spacing: 4px;
        Chip { text: ["A", "B", "C", "D"][d] + (DeckState.decks[d].playing ? @tr(" Pause") : @tr(" Play")); width: 64px; horizontal-stretch: 0; active: DeckState.decks[d].playing; active-color: Theme.play; enabled: DeckState.decks[d].loaded; clicked => { DeckState.play-pause(d); } }
        Chip { text: @tr("CUE"); width: Theme.touch-target; horizontal-stretch: 0; active: DeckState.decks[d].at-cue; active-color: Theme.cue; enabled: DeckState.decks[d].loaded; property <int> owner: -1; pressed => { self.owner = d; DeckState.cue(self.owner); } released => { let owner = self.owner; self.owner = -1; if (owner >= 0) { DeckState.cue-released(owner); } } }
        Fader { value: MixerState.channels[d].fader; edited(v) => { MixerState.fader(d, v); } }
        IconButton { icon: Icon.headphones; tooltip: @tr("Headphone cue deck {}", ["A", "B", "C", "D"][d]); active: MixerState.channels[d].cue; clicked => { MixerState.cue-toggled(d); } }
    }
    HorizontalLayout {
        x: 8px; y: root.height - Theme.touch-target - 4px;
        width: root.width - 16px; height: Theme.touch-target; spacing: 8px;
        Text { text: "A"; color: Theme.deck1; horizontal-stretch: 0; vertical-alignment: center; }
        Fader { value: MixerState.crossfader; detent: true; edited(v) => { MixerState.crossfader = v; MixerState.crossfade(v); } }
        Text { text: "B"; color: Theme.deck2; horizontal-stretch: 0; vertical-alignment: center; }
        Chip { text: @tr("Mid"); width: 52px; horizontal-stretch: 0; tooltip: @tr("Center crossfader"); clicked => { MixerState.crossfader = 0.5; MixerState.crossfade(0.5); } }
    }
}

component TouchChannel inherits Rectangle {
    in property <int> index;
    property <ChannelView> ch: MixerState.channels[root.index];
    /// Channel 4 is the AUX strip: no crossfader or STEM ISO, the CFX knob is its FILTER and the ON switch takes STEM ISO's place.
    property <bool> aux: root.index >= 4;
    height: controls.preferred-height + 16px;
    background: Theme.panel;
    controls := VerticalLayout {
        x: 8px; y: 8px; width: parent.width - 16px; height: self.preferred-height;
        spacing: 8px; alignment: start;
        Text { text: root.aux ? @tr("AUX") : @tr("Deck {}", ["A", "B", "C", "D"][root.index]); color: Theme.text-bright; font-size: Theme.font-lg; font-weight: Theme.weight-bold; }
        HorizontalLayout {
            height: 80px; spacing: 8px;
            for label[p] in [@tr("Trim"), @tr("High"), @tr("Mid"), @tr("Low"), root.aux ? @tr("Filter") : @tr("CFX")]: VerticalLayout {
                spacing: 4px; alignment: center;
                Text { height: 20px; text: root.ch.iso && p >= 1 && p <= 3 ? ["", @tr("Inst"), @tr("Vocal"), @tr("Drums")][p] : label; color: Theme.text; font-size: Theme.font-sm; horizontal-alignment: center; overflow: elide; }
                HorizontalLayout {
                    height: 48px; alignment: center;
                    Knob { width: 48px; height: 48px; horizontal-stretch: 0; value: root.ch.iso && p >= 1 && p <= 3 ? root.ch.iso-knobs[p - 1] : root.ch.knobs[p]; detent: true; stop: p == 4 && !root.aux ? MixerState.cfx-stop : -1; edited(v) => { MixerState.knob(root.index, p, v); } }
                }
            }
        }
        HorizontalLayout {
            Chip { text: @tr("CUE"); active: root.ch.cue; clicked => { MixerState.cue-toggled(root.index); } }
            if !root.aux: Chip { text: @tr("STEM ISO"); active: root.ch.iso; enabled: DeckState.decks[root.index].stems; clicked => { MixerState.iso-toggled(root.index); } }
            if root.aux: Chip { text: @tr("AUX ON"); active: root.ch.on; clicked => { MixerState.aux-toggled(); } }
        }
        if !root.aux: Dropdown { options: [@tr("Crossfader A"), @tr("Through"), @tr("Crossfader B")]; current: root.ch.xf; chose(n) => { if n != root.ch.xf { MixerState.xf-assigned(root.index, n == 1 ? root.ch.xf : n); } } }
        Fader { height: Theme.touch-target; value: root.ch.fader; edited(v) => { MixerState.fader(root.index, v); } }
        Meter { level: root.ch.level; peak: root.ch.peak; height: 8px; }
    }
}

export component TouchMixer inherits Rectangle {
    property <int> channel;
    property <int> channel-count: DeckState.count;
    changed channel-count => { if root.channel < 4 { root.channel = min(root.channel, root.channel-count - 1); } }
    changed aux-shown => { if !MixerState.aux-shown && root.channel >= 4 { root.channel = 0; } }
    property <bool> aux-shown: MixerState.aux-shown;
    height: body.preferred-height + 16px;
    background: Theme.bg;
    body := VerticalLayout {
        x: 8px; y: 8px; width: parent.width - 16px; spacing: 8px; alignment: start;
        Dropdown { options: MixerState.cfx-names; current: MixerState.cfx-type; chose(n) => { MixerState.cfx-selected(n); } }
        HorizontalLayout {
            for i in DeckState.count: Chip { text: @tr("Deck {}", ["A", "B", "C", "D"][DeckState.slots[i]]); active: root.channel == i; clicked => { root.channel = i; } }
            if MixerState.aux-shown: Chip { text: @tr("AUX"); active: root.channel >= 4; clicked => { root.channel = 4; } }
        }
        TouchChannel { index: root.channel >= 4 ? 4 : DeckState.slots[min(root.channel, DeckState.count - 1)]; }
        HorizontalLayout {
            height: 104px; spacing: 8px;
            for label[p] in [@tr("Master"), @tr("Headphone mix"), @tr("Headphone level")]: VerticalLayout {
                spacing: 4px; alignment: center;
                Text { height: 32px; text: label; color: Theme.text; font-size: Theme.font-sm; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    height: 48px; alignment: center;
                    Knob { width: 48px; height: 48px; horizontal-stretch: 0; value: MixerState.bus.knobs[p]; reset: p == 1 ? 0 : 0.5; detent: true; edited(v) => { MixerState.bus-knob(p, v); } }
                }
                Text { height: 16px; text: MixerState.bus.readouts[p]; color: Theme.text; font-size: Theme.font-xs; horizontal-alignment: center; }
            }
        }
        HorizontalLayout {
            Chip { text: @tr("Split cue"); active: MixerState.bus.split; clicked => { MixerState.split-toggled(); } }
            Chip { text: MixerState.bus.rec ? @tr("Stop recording") : @tr("Record"); active: MixerState.bus.rec; active-color: Theme.rec; clicked => { MixerState.rec-toggled(); } }
        }
        Chip { text: @tr("Crossfader: {}", [@tr("Smooth"), @tr("Sharp"), @tr("Constant")][MixerState.curve]); clicked => { MixerState.curve-cycled(); } }
        Text { text: MixerState.bus.status; color: Theme.text; font-size: Theme.font-size; wrap: word-wrap; }
    }
}
