import { Chip, Fader, Knob } from "widgets.slint";
import { Theme } from "theme.slint";
import { DeckState } from "deck.slint";

/// One of the 16 sampler slots, as the pads show it. `band` is the slice's dominant frequency band (0 low, 1 mid, 2 high) for the
/// SYNC WITH FREQUENCY colour (VIEW > Color > Sampler).
export struct SlotView { loaded: bool, playing: bool, looped: bool, band: int, muted: bool }

/// Sampler (src/app/sampler/, audio in src/audio/sampler/). Rust owns every value here; the callbacks
/// carry the user's request and Rust writes the result back. The controls after the pads act on the
/// selected slot (the last pad pressed).
export global SamplerState {
    /// Panel shown (in place of the Beat FX row), toggled by `SamplerTab` and the keyboard.
    in-out property <bool> open;
    out property <length> panel-h: Theme.layout-profile == 1 ? max(Theme.h-sampler, 7 * Theme.touch-target) : Theme.h-sampler;
    /// 16 entries; the pads show the current bank of eight.
    in-out property <[SlotView]> slots;
    /// 0 = slots 1-8, 1 = slots 9-16.
    in-out property <int> bank;
    in-out property <int> selected;
    /// CONTROLLER > Sampler > SLOT: the first N slots are the ones in use (4, 8 or 16); the rest are not shown.
    in-out property <int> slot-count: 16;
    /// VIEW > Color > SAMPLER COLOR: one fixed purple instead of the slice's frequency colour.
    in-out property <bool> purple;
    /// Selected slot: GATE (plays while held) / BPM SYNC, and its volume (0..1, 0.5 = unity).
    in-out property <bool> gate;
    in-out property <bool> sync;
    in-out property <float> volume: 0.5;
    /// Sampler master volume (0..1, 0.5 = unity) and its headphone (CUE) switch.
    in-out property <float> master: 0.5;
    in-out property <bool> cue;
    /// Where LOAD takes the slice from: 0..3 = deck A..D's playhead, 4 = the selected browser track (first 30 s).
    in-out property <int> source;
    /// "4" beats the deck sources capture.
    in-out property <string> beats-text;
    /// What the last action did / the selected slot holds.
    in-out property <string> status;
    callback pad-pressed(int);
    callback pad-released(int);
    /// Shift + pad on a controller: stop that slot.
    callback pad-stopped(int);
    callback bank-toggled();
    /// ONE-SHOT / LOOP of the selected slot.
    callback loop-toggled();
    callback gate-toggled();
    callback sync-toggled();
    callback volume-edited(float);
    callback master-edited(float);
    callback cue-toggled();
    callback source-selected(int);
    callback beats-step(int);
    /// Fill the selected slot from `source`.
    callback load-clicked();
    callback clear-clicked();
    /// (deck) Export Loop As Wav: that deck's active loop (-1, or a deck without one: the selected slot) to a WAV file at the ADVANCED sampling frequency.
    callback export-loop(int);
    /// SEQUENCER (src/app/sampler/seq.rs): 0 stopped, 1 playing, 2 REC standby, 3 recording; length in bars (1, 2, 4).
    in-out property <int> seq-mode;
    in-out property <int> seq-bars: 1;
    /// MUTE / ERASE lit: a slot pad mutes / erases its events instead of playing.
    in-out property <bool> seq-mute;
    in-out property <bool> seq-erase;
    /// The saved sequence in view (0..7) and which of the 8 are saved; the recorded pattern has not been saved (red dot).
    in-out property <int> seq-slot;
    in-out property <[bool]> seq-saved;
    in-out property <bool> seq-unsaved;
    /// Where the pattern clock is, 0..1 of its length.
    in-out property <float> seq-pos;
    callback seq-rec();
    callback seq-play();
    callback seq-bars-selected(int);
    callback seq-mute-toggled();
    callback seq-erase-toggled();
    callback seq-save();
    /// ◀ ▶ over the saved sequences (-1 / +1).
    callback seq-pick(int);
    callback seq-delete();
}

/// One slot tile: number, loop mark and a play arrow (lit while playing). Click = pad (press / release), selected = blue frame.
component Slot inherits Rectangle {
    in property <int> slot;
    property <SlotView> v: SamplerState.slots[root.slot];
    property <color> tone: SamplerState.purple ? Theme.sampler : [Theme.wave-low, Theme.wave-mid, Theme.wave-high][root.v.band];
    background: Theme.bg-deep;
    border-width: 1px;
    border-color: SamplerState.selected == root.slot ? Theme.accent : Theme.line;
    border-radius: Theme.radius;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;
        Text {
            text: (root.slot + 1) + (root.v.looped ? " ∞" : "") + (root.v.muted ? " M" : "");
            color: root.v.loaded ? Theme.text : Theme.text-faint;
            font-family: Theme.font;
            font-size: Theme.font-size;
            font-weight: Theme.weight-bold;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 22px;
            horizontal-stretch: 0;
            Rectangle {
                width: 22px;
                height: 14px;
                border-radius: Theme.radius;
                background: root.v.playing ? root.tone : root.v.loaded ? root.tone.with-alpha(0.35) : Theme.panel-raised;
                Path {
                    width: 10px;
                    height: 10px;
                    x: 6px;
                    y: 2px;
                    viewbox-width: 10;
                    viewbox-height: 10;
                    commands: "M 1 0 L 9 5 L 1 10 Z";
                    fill: root.v.loaded ? Theme.text-bright : Theme.text-faint;
                }
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) { SamplerState.pad-pressed(root.slot); }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { SamplerState.pad-released(root.slot); }
            }
        }
    }
}

/// 2 rows x 4 slots (`first` .. `first + 7`).
component SlotGrid inherits VerticalLayout {
    in property <int> first;
    spacing: Theme.layout-profile == 1 ? 4px : 2px;
    for r in SamplerState.slot-count - root.first > 4 ? 2 : 1: HorizontalLayout {
        spacing: Theme.layout-profile == 1 ? 4px : 2px;
        for c in 4: Slot { slot: root.first + r * 4 + c; }
    }
}

/// SEQUENCER (src/app/sampler/seq.rs): REC / PLAY, 1 2 4 bars; MUTE / ERASE (then a slot pad), SAVE; ◀ n ▶ over the 8 saved sequences (lit = saved,
/// red dot = the pattern is recorded and unsaved) and × to delete; the thin bar is the pattern clock.
component SeqBlock inherits VerticalLayout {
    property <bool> touch: Theme.layout-profile == 1;
    spacing: root.touch ? 4px : 2px;
    HorizontalLayout {
        height: root.touch ? Theme.touch-target : 20px;
        spacing: root.touch ? 4px : 2px;
        Chip { text: SamplerState.seq-mode == 2 ? @tr("REC…") : @tr("REC"); font-size: Theme.font-xs; min-width: root.touch ? 64px : 40px; active: SamplerState.seq-mode >= 2; active-color: Theme.rec; tooltip: @tr("Record: the first pad hit starts it, REC again stops recording"); clicked => { SamplerState.seq-rec(); } }
        Chip { text: SamplerState.seq-mode == 1 || SamplerState.seq-mode == 3 ? @tr("STOP") : @tr("PLAY"); font-size: Theme.font-xs; min-width: root.touch ? 64px : 40px; active: SamplerState.seq-mode == 1 || SamplerState.seq-mode == 3; active-color: Theme.play; clicked => { SamplerState.seq-play(); } }
        for b in [1, 2, 4]: Chip { text: b == 1 ? @tr("1 BAR") : "" + b; font-size: Theme.font-xs; min-width: root.touch ? (b == 1 ? 64px : Theme.touch-target) : (b == 1 ? 40px : 22px); active: SamplerState.seq-bars == b; clicked => { SamplerState.seq-bars-selected(b); } }
    }
    HorizontalLayout {
        height: root.touch ? Theme.touch-target : 20px;
        spacing: root.touch ? 4px : 2px;
        Chip { text: @tr("MUTE"); font-size: Theme.font-xs; min-width: 40px; active: SamplerState.seq-mute; tooltip: @tr("Then press a slot: its sequence is muted / unmuted"); clicked => { SamplerState.seq-mute-toggled(); } }
        Chip { text: @tr("ERASE"); font-size: Theme.font-xs; min-width: 40px; active: SamplerState.seq-erase; active-color: Theme.danger; tooltip: @tr("Then press a slot: its events are erased"); clicked => { SamplerState.seq-erase-toggled(); } }
        Chip { text: SamplerState.seq-unsaved ? @tr("SAVE ●") : @tr("SAVE"); font-size: Theme.font-xs; min-width: 52px; tooltip: @tr("Save the sequence in the slot in view"); clicked => { SamplerState.seq-save(); } }
    }
    HorizontalLayout {
        height: root.touch ? Theme.touch-target : 20px;
        spacing: root.touch ? 4px : 2px;
        Chip { text: "◀"; font-size: Theme.font-xs; min-width: root.touch ? Theme.touch-target : 20px; max-width: root.touch ? Theme.touch-target : 20px; horizontal-stretch: 0; clicked => { SamplerState.seq-pick(-1); } }
        Text { text: @tr("SEQ {}", SamplerState.seq-slot + 1) + (SamplerState.seq-saved[SamplerState.seq-slot] ? " ✓" : ""); color: SamplerState.seq-saved[SamplerState.seq-slot] ? Theme.text-bright : Theme.text-faint; font-family: Theme.font; font-size: Theme.font-xs; font-weight: Theme.weight-bold; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 1; }
        Chip { text: "▶"; font-size: Theme.font-xs; min-width: root.touch ? Theme.touch-target : 20px; max-width: root.touch ? Theme.touch-target : 20px; horizontal-stretch: 0; clicked => { SamplerState.seq-pick(1); } }
        Chip { text: "×"; font-size: Theme.font-xs; min-width: root.touch ? Theme.touch-target : 22px; max-width: root.touch ? Theme.touch-target : 22px; horizontal-stretch: 0; tooltip: @tr("Delete the saved sequence in view"); enabled: SamplerState.seq-saved[SamplerState.seq-slot]; clicked => { SamplerState.seq-delete(); } }
    }
    Rectangle {
        height: 3px;
        background: Theme.bg-deep;
        Rectangle { x: 0; width: parent.width * SamplerState.seq-pos; background: SamplerState.seq-mode == 3 ? Theme.rec : Theme.play; }
    }
}

/// Sampler deck (src/app/sampler/): the slots in use (`slot-count`: 4, 8 or 16) as groups of 2 x 4 around the GAIN knob; under them BANK (16 slots only), the
/// selected slot's SHOT/LOOP, GATE, SYNC and volume, where LOAD takes the slice from, and the status line.
export component SamplerPanel inherits Rectangle {
    property <bool> touch: Theme.layout-profile == 1;
    background: Theme.panel;
    VerticalLayout {
        padding: 0px;
        spacing: root.touch ? 6px : 2px;
        HorizontalLayout {
            height: root.touch ? 3 * Theme.touch-target + 16px : 68px;
            spacing: root.touch ? 6px : 2px;
            SlotGrid { first: 0; }
            VerticalLayout {
                width: root.touch ? 64px : 56px;
                horizontal-stretch: 0;
                spacing: 2px;
                alignment: center;
                Text { text: @tr("GAIN"); color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-xs; font-weight: Theme.weight-bold; horizontal-alignment: center; }
                HorizontalLayout {
                    alignment: center;
                    Knob { width: root.touch ? Theme.touch-target : 30px; height: root.touch ? Theme.touch-target : 30px; detent: true; value: SamplerState.master; edited(v) => { SamplerState.master-edited(v); } }
                }
                Chip { text: @tr("CUE"); font-size: Theme.font-xs; height: root.touch ? Theme.touch-target : 18px; min-width: 0px; active: SamplerState.cue; tooltip: @tr("Sampler to headphones"); clicked => { SamplerState.cue-toggled(); } }
            }
            if SamplerState.slot-count > 8: SlotGrid { first: 8; }
            SeqBlock { width: root.touch ? 300px : 176px; horizontal-stretch: 0; }
        }
        if !root.touch: HorizontalLayout {
            height: 26px;
            padding: 2px;
            spacing: 3px;
            if SamplerState.slot-count > 8: Text { text: @tr("BANK"); color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-xs; font-weight: Theme.weight-bold; vertical-alignment: center; horizontal-stretch: 0; }
            for b in SamplerState.slot-count > 8 ? 2 : 0: Chip { text: "" + (b + 1); font-size: Theme.font-xs; min-width: 24px; max-width: 24px; horizontal-stretch: 0; active: SamplerState.bank == b; clicked => { if (SamplerState.bank != b) { SamplerState.bank-toggled(); } } }
            Rectangle { width: 6px; horizontal-stretch: 0; }
            Chip { text: SamplerState.slots[SamplerState.selected].looped ? @tr("LOOP") : @tr("SHOT"); font-size: Theme.font-xs; min-width: 40px; horizontal-stretch: 0; active: SamplerState.slots[SamplerState.selected].looped; clicked => { SamplerState.loop-toggled(); } }
            Chip { text: @tr("GATE"); font-size: Theme.font-xs; min-width: 38px; horizontal-stretch: 0; active: SamplerState.gate; clicked => { SamplerState.gate-toggled(); } }
            Chip { text: @tr("SYNC"); font-size: Theme.font-xs; min-width: 38px; horizontal-stretch: 0; active: SamplerState.sync; active-color: Theme.bpm-sync; tooltip: @tr("BPM SYNC"); clicked => { SamplerState.sync-toggled(); } }
            Fader { min-width: 60px; max-width: 90px; detent: true; value: SamplerState.volume; edited(v) => { SamplerState.volume-edited(v); } }
            Rectangle { width: 6px; horizontal-stretch: 0; }
            Text { text: @tr("FROM"); color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-xs; font-weight: Theme.weight-bold; vertical-alignment: center; horizontal-stretch: 0; }
            for name[i] in DeckState.count == 4 ? ["1", "2", "3", "4", "TRK"] : ["1", "2", "TRK"]: Chip {
                property <int> src: name == "TRK" ? 4 : i;
                text: name == "TRK" ? @tr("TRK") : name;
                font-size: Theme.font-xs;
                min-width: name == "TRK" ? 32px : 22px;
                horizontal-stretch: 0;
                active: SamplerState.source == self.src;
                clicked => { SamplerState.source-selected(self.src); }
            }
            Chip { text: "◀"; font-size: Theme.font-xs; min-width: 20px; max-width: 20px; horizontal-stretch: 0; enabled: SamplerState.source < 4; clicked => { SamplerState.beats-step(-1); } }
            Text { text: SamplerState.source < 4 ? SamplerState.beats-text : "30s"; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.font-md; font-weight: Theme.weight-bold; horizontal-alignment: center; vertical-alignment: center; min-width: 26px; horizontal-stretch: 0; }
            Chip { text: "▶"; font-size: Theme.font-xs; min-width: 20px; max-width: 20px; horizontal-stretch: 0; enabled: SamplerState.source < 4; clicked => { SamplerState.beats-step(1); } }
            Chip { text: @tr("LOAD"); font-size: Theme.font-xs; min-width: 40px; horizontal-stretch: 0; clicked => { SamplerState.load-clicked(); } }
            Chip { text: "×"; font-size: Theme.font-xs; min-width: 22px; horizontal-stretch: 0; tooltip: @tr("Clear slot"); enabled: SamplerState.slots[SamplerState.selected].loaded; clicked => { SamplerState.clear-clicked(); } }
            Chip { text: "WAV"; font-size: Theme.font-xs; min-width: 32px; horizontal-stretch: 0; tooltip: @tr("Export the FROM deck's loop (else this slot) as a WAV file"); clicked => { SamplerState.export-loop(SamplerState.source < 4 ? SamplerState.source : -1); } }
            Text { text: SamplerState.status; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-size; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; }
        }
        if root.touch: VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                height: Theme.touch-target;
                spacing: 6px;
                alignment: start;
                if SamplerState.slot-count > 8: Text { text: @tr("BANK"); color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-xs; font-weight: Theme.weight-bold; vertical-alignment: center; horizontal-stretch: 0; }
                for b in SamplerState.slot-count > 8 ? 2 : 0: Chip { text: "" + (b + 1); width: Theme.touch-target; horizontal-stretch: 0; active: SamplerState.bank == b; clicked => { if (SamplerState.bank != b) { SamplerState.bank-toggled(); } } }
                Chip { text: SamplerState.slots[SamplerState.selected].looped ? @tr("LOOP") : @tr("SHOT"); width: 64px; horizontal-stretch: 0; active: SamplerState.slots[SamplerState.selected].looped; clicked => { SamplerState.loop-toggled(); } }
                Chip { text: @tr("GATE"); width: 64px; horizontal-stretch: 0; active: SamplerState.gate; clicked => { SamplerState.gate-toggled(); } }
                Chip { text: @tr("SYNC"); width: 64px; horizontal-stretch: 0; active: SamplerState.sync; active-color: Theme.bpm-sync; tooltip: @tr("BPM SYNC"); clicked => { SamplerState.sync-toggled(); } }
                Fader { width: 150px; height: Theme.touch-target; horizontal-stretch: 0; detent: true; value: SamplerState.volume; edited(v) => { SamplerState.volume-edited(v); } }
            }
            HorizontalLayout {
                height: Theme.touch-target;
                spacing: 6px;
                alignment: start;
                Text { text: @tr("FROM"); color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-xs; font-weight: Theme.weight-bold; vertical-alignment: center; horizontal-stretch: 0; }
                for name[i] in DeckState.count == 4 ? ["1", "2", "3", "4", "TRK"] : ["1", "2", "TRK"]: Chip {
                    property <int> src: name == "TRK" ? 4 : i;
                    text: name == "TRK" ? @tr("TRK") : name;
                    width: Theme.touch-target;
                    horizontal-stretch: 0;
                    active: SamplerState.source == self.src;
                    clicked => { SamplerState.source-selected(self.src); }
                }
                Chip { text: "◀"; width: Theme.touch-target; horizontal-stretch: 0; enabled: SamplerState.source < 4; clicked => { SamplerState.beats-step(-1); } }
                Text { text: SamplerState.source < 4 ? SamplerState.beats-text : "30s"; width: 44px; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.font-md; font-weight: Theme.weight-bold; horizontal-alignment: center; vertical-alignment: center; horizontal-stretch: 0; }
                Chip { text: "▶"; width: Theme.touch-target; horizontal-stretch: 0; enabled: SamplerState.source < 4; clicked => { SamplerState.beats-step(1); } }
                Chip { text: @tr("LOAD"); width: 64px; horizontal-stretch: 0; clicked => { SamplerState.load-clicked(); } }
                Chip { text: "×"; width: Theme.touch-target; horizontal-stretch: 0; tooltip: @tr("Clear slot"); enabled: SamplerState.slots[SamplerState.selected].loaded; clicked => { SamplerState.clear-clicked(); } }
                Chip { text: "WAV"; width: 64px; horizontal-stretch: 0; tooltip: @tr("Export the FROM deck's loop (else this slot) as a WAV file"); clicked => { SamplerState.export-loop(SamplerState.source < 4 ? SamplerState.source : -1); } }
            }
            Text { text: SamplerState.status; height: 24px; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-size; vertical-alignment: center; overflow: elide; }
        }
    }
}
