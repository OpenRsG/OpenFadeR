import { ListView } from "std-widgets.slint";
import { Glyph, Icon } from "widgets.slint";
import { Theme } from "theme.slint";

/// One mounted device in the DEVICES list (src/app/device/): `summary` is "FAT32 · 3.2 GB free of 14.9 GB", `warning` the file
/// system warning ("" = none), `library` what it holds (the plugin's library names, "no library"), `used` the filled part 0..1;
/// the `can-` flags are what the device's plugin offers for it.
export struct DeviceItem {
    id: string,
    name: string,
    summary: string,
    warning: string,
    library: string,
    used: float,
    writable: bool,
    has-library: bool,
    can-export: bool,
    can-update: bool,
    can-histories: bool,
    can-backup: bool,
    can-settings: bool,
}

/// One button a device's plugin lists (`DeviceState.run-action`): `help` is the line under it, `enabled` whether it can run now,
/// `writes` that it needs a writable device.
export struct ActionItem {
    id: string,
    label: string,
    help: string,
    enabled: bool,
    writes: bool,
}

/// A playlist or folder in the EXPORT / SYNC MANAGER lists.
export struct PickRow {
    name: string,
    depth: int,
    folder: bool,
    ticked: bool,
}

/// A backup in the backup list (date and time, computer name, device name, file system).
export struct BackupItem {
    when: string,
    computer: string,
    device: string,
    fs: string,
    selected: bool,
}

/// A device option of a library format: a switch (`choices` empty, `on`) or one of `choices` (`current`); `hint` explains it.
export struct FormatOption {
    label: string,
    hint: string,
    on: bool,
    choices: [string],
    current: int,
}

/// A library format a plugin can write to the chosen device: `title` and `about` (what reads it) are the plugin's, `held` what
/// of it the device holds ("" = nothing yet), `on` = exports write it, `options` how it is written there.
export struct FormatItem {
    title: string,
    about: string,
    held: string,
    on: bool,
    options: [FormatOption],
}

// Prepare: a track of the preview card's lists; `detail` is its size ("" = none).
export struct PreviewRow {
    title: string,
    detail: string,
}

// Checker: what the stick check shows (src/app/device/check.rs).
/// A library of the stick: when it was written and what it holds ("–" = not known); `state` 0 on the stick, 1 not on it, 2 unreadable.
export struct CheckLib {
    name: string,
    written: string,
    tracks: string,
    playlists: string,
    cues: string,
    state: int,
}

/// What is wrong, worded cause / consequence / action; `severity` 0 info, 1 warning, 2 error, 3 unreadable.
export struct CheckProblem {
    severity: int,
    cause: string,
    consequence: string,
    action: string,
}

/// A player model and whether it reads the stick: `fit` 0 OK, 1 not confirmed, 2 NO, 3 unknown; `reason` says why not or what the
/// maker's notes say.
export struct CheckPlayer {
    model: string,
    fit: int,
    reason: string,
}

/// A set of player models for the booth profile.
export struct CheckPreset {
    id: string,
    label: string,
    on: bool,
}

/// One row of the review dialog (BringBack, DeviceState.review-rows): `title` a track or history, `detail` what changes, `note` a
/// dim second line, `ticked` for the lists with ticks, `enabled` whether the row's buttons work.
export struct ReviewRow {
    title: string,
    detail: string,
    note: string,
    ticked: bool,
    enabled: bool,
}

/// One line of the compare view: what is compared, the collection's copy, the stick's copy.
export struct CompareRow {
    what: string,
    mine: string,
    stick: string,
}

/// The device windows (src/app/device/): detection, EXPORT to a device (create / add / update), SYNC MANAGER, backups, eject.
/// Rust owns every value; the callbacks are the user's actions.
export global DeviceState {
    in-out property <bool> visible;
    /// 0 DEVICES, 1 EXPORT, 2 SYNC MANAGER, 3 BACKUPS.
    in-out property <int> tab;
    in property <[DeviceItem]> devices;
    /// A device plugin is on: without one no device is listed, and the empty list says so.
    in property <bool> has-plugin: true;
    in property <[string]> device-names;
    /// Index into `devices` of the chosen device, -1 none.
    in-out property <int> current: -1;
    in property <[PickRow]> export-rows;
    /// The library formats of the chosen device; an export, SYNC and the cue sync write the ones that are on.
    in property <[FormatItem]> formats;
    /// Every format of the chosen device is on: it works with every app and player the formats list.
    in property <bool> universal;
    /// Export to a folder instead of a device (any folder that is not a mounted device).
    in-out property <string> folder;
    in property <[PickRow]> sync-rows;
    /// Whether the Sync Manager keeps the chosen device in sync.
    in property <bool> sync-on;
    in property <[BackupItem]> backups;
    /// The buttons the chosen device's plugin lists (`run-action` takes the id).
    in property <[ActionItem]> actions;
    in-out property <string> backup-dir;
    /// A job runs: `phase`, `progress` 0..1 and the cancel button show.
    in property <bool> busy;
    in property <string> phase;
    in property <float> progress;
    in property <string> status;
    in property <bool> failed;
    /// A question is open: `confirm-text` with a yes button labelled `confirm-yes` and a cancel button.
    in property <bool> confirm-open;
    in property <string> confirm-text;
    in property <string> confirm-yes;

    /// The window was opened or a tab changed: Rust refreshes the lists.
    callback opened();
    callback select(int);
    callback eject();
    callback export-toggle(int);
    callback export-clear();
    callback export-start();
    /// Switches format `i` of `formats` for the chosen device.
    callback format-toggle(int);
    /// `true`: every format on; `false`: only the format that handles the device (the user then ticks the others).
    callback format-universal(bool);
    /// Format `i`, its option `k`: a switch gets 1 / 0, a choice the index of the chosen entry.
    callback format-option(int, int, int);
    callback sync-toggle(int);
    callback sync-set-on(bool);
    callback sync-start();
    callback backup-now();
    callback backup-toggle(int);
    callback restore();
    callback backup-delete();
    callback run-action(string);
    callback update-collection();
    callback import-histories();
    /// Opens Preferences > DJ SYSTEM for the chosen device.
    callback edit-settings();
    callback cancel();
    callback confirmed(bool);

    // Hooks for the browser's Devices tree and the menus.
    /// Device id, playlist id (as `Library::playlists` names them on that device).
    callback import-playlist(string, string);
    callback delete-playlist(string, string);
    callback import-history(string, string);
    /// Device id, path of the track's audio file on the device (`Track::file`).
    callback delete-track(string, string);
    /// Snapshot playlist id of the collection: opens EXPORT with it ticked.
    callback export-playlists(string);
    /// File > Library > Backed up device library management.
    callback manage-backups();

    // Prepare: the preview card before a write, and the question a plugged-in device asks (src/app/device/preview.rs).
    in property <bool> preview-open;
    in property <string> preview-title;
    /// "FAT32 · 3.2 GB free of 14.9 GB · FORMAT + FORMAT".
    in property <string> preview-device;
    /// "12 new tracks to copy (480 MB)" and its list; `preview-update` "" = no list.
    in property <string> preview-add;
    in property <[PreviewRow]> preview-add-rows;
    in property <string> preview-update;
    in property <[PreviewRow]> preview-update-rows;
    /// What else the write does: analyses, playlists, the time, the backup, that the music is not changed.
    in property <[string]> preview-lines;
    /// Why tracks are left out or the write cannot run (error colour).
    in property <[string]> preview-blocked;
    in property <bool> preview-can-start;
    callback preview-answer(bool);
    in property <bool> sync-ask-open;
    in property <string> sync-ask-text;
    callback sync-ask-answer(bool);

    // Checker: the stick check of the chosen device (src/app/device/check.rs). `check-state`: -1 checking, 0 READY, 1 NEEDS FIXING,
    // 2 UNREADABLE, 3 EMPTY; `check-title` and `check-line` are the words for it.
    in property <int> check-state: -1;
    in property <string> check-title;
    in property <string> check-line;
    in property <[CheckLib]> check-libs;
    in property <[CheckProblem]> check-problems;
    in property <[CheckPlayer]> check-players;
    in property <[CheckPreset]> check-presets;
    /// Every player model the plugins know, ticked when the booth profile holds it.
    in property <[PickRow]> booth-rows;
    /// The booth profile is empty: the stick is judged for every known model.
    in property <bool> booth-all: true;
    /// FIX THE STICK has something to do.
    in property <bool> fixable;
    /// The DEVICES tab shows the check details instead of the setup.
    in-out property <bool> check-details;
    /// Per device of `devices`: its check state (as `check-state`) and the short label of it.
    in property <[int]> device-checks;
    in property <[string]> device-check-labels;
    /// A second answer of the open question (EJECT ANYWAY / FIX THE STICK): its label, "" = none.
    in property <string> confirm-alt;
    callback check-again();
    callback fix-stick();
    callback booth-toggle(int);
    callback booth-preset(string);
    callback booth-everything();
    callback confirmed-alt();
    /// The colour of a check state.
    public pure function state-color(state: int) -> color {
        return state == 0 ? Theme.play : state == 1 ? Theme.cue : state == 2 ? Theme.danger : Theme.text-dim;
    }

    // Formatter: the FORMAT… dialog (src/app/device/format.rs, ui/device-format.slint).
    in-out property <bool> format-open;
    /// The consequence line, and what is about to be erased: "SanDisk Ultra · 14.9 GB" and one line per volume.
    in property <string> format-warning;
    in property <string> format-disk;
    in property <[string]> format-volumes;
    /// What the user types to confirm: the device's label, ERASE when it has none.
    in property <string> format-word;
    in-out property <string> format-typed;
    in-out property <string> format-label;
    /// 0 FAT32, 1 exFAT; `format-exfat` = exFAT is offered (not on an SD card).
    in-out property <int> format-fs;
    in property <bool> format-exfat;
    /// The device holds a library the device backup can keep; `format-backup` = back it up first.
    in property <bool> format-can-backup;
    in-out property <bool> format-backup;
    /// What a safeguard refuses, shown in the dialog.
    in property <string> format-problem;
    /// FORMAT… on the chosen device: reads its disk, then opens the dialog.
    callback format-ask();
    callback format-go();
    callback format-cancel();

    // BringBack: review before an import, the way back, and the cues that differ (src/app/device/review.rs, ui/device-review.slint).
    /// What the review dialog shows: 0 closed, 1 UPDATE COLLECTION (ticks), 2 IMPORT HISTORIES (ticks), 3 CUES THAT DIFFER (a choice
    /// per row), 4 RECENT IMPORTS (UNDO per row).
    in property <int> review-mode;
    in property <string> review-title;
    in property <string> review-text;
    in property <[ReviewRow]> review-rows;
    /// Ticked rows (modes 1 and 2): the APPLY button counts them.
    in property <int> review-ticked;
    /// A conflict row's KEEP MINE writes to the device: false while it is read-only or busy (`review-why` says why).
    in property <bool> review-can-write;
    in property <string> review-why;
    callback review-toggle(int);
    callback review-all(bool);
    callback review-apply();
    callback review-close();
    /// Modes 3 and 4: row, then 0 KEEP MINE / UNDO, 1 TAKE THE STICK'S, 2 COMPARE.
    callback review-row(int, int);
    /// Mode 3: 0 KEEP ALL MINE, 1 TAKE ALL THE STICK'S.
    callback review-bulk(int);
    /// The compare view of one track with different cues.
    in property <bool> compare-open;
    in property <string> compare-title;
    in property <[CompareRow]> compare-rows;
    callback compare-close();
    /// The bar after an import, with UNDO.
    in property <bool> undo-shown;
    in property <string> undo-text;
    callback undo-now();
    callback undo-dismiss();
    /// Of the chosen device: tracks whose cues differ between the collection and it; imports kept to undo.
    in property <int> differ-count;
    in property <int> undo-count;
    callback open-differ();
    callback open-recent();
}

/// Checkbox rows for playlists and folders.
export component PickList inherits Rectangle {
    in property <[PickRow]> rows;
    callback toggled(int);
    min-height: Theme.layout-profile == 1 ? 4 * Theme.target-size(Theme.h-row) : 0px;
    background: Theme.bg-deep;
    border-color: Theme.line-strong;
    border-width: 1px;
    ListView {
        for row[i] in root.rows: Rectangle {
            height: Theme.target-size(Theme.h-row);
            background: area.has-hover ? Theme.hover-row : transparent;
            HorizontalLayout {
                padding-left: Theme.space-md + row.depth * 16px;
                spacing: Theme.space-md;
                Rectangle {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    border-width: 1px;
                    border-color: Theme.line-strong;
                    border-radius: Theme.radius;
                    background: row.ticked ? Theme.accent : Theme.panel-raised;
                    horizontal-stretch: 0;
                    if row.ticked: Glyph { width: 12px; height: 12px; icon: Icon.check; tint: Theme.text-bright; stroke-width: 2px; }
                }
                Text {
                    text: (row.folder ? "▸ " : "") + row.name;
                    color: row.folder ? Theme.text-dim : Theme.text;
                    font-family: Theme.font;
                    font-size: Theme.font-size;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            area := TouchArea { clicked => { root.toggled(i); } }
        }
    }
}

/// A dim bold caption over a block.
export component Caption inherits Text {
    color: Theme.text-dim;
    font-family: Theme.font;
    font-size: Theme.font-md;
    font-weight: Theme.weight-bold;
    vertical-alignment: center;
    vertical-stretch: 0;
}
