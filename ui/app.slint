import { DeckCompact, DeckDetail, DeckDetailV, DeckPanel, DeckState, DeckView } from "deck.slint";
import { FxPanel, FxSlot, FxState, FxUnit } from "fx.slint";
import { FxRackState, RackView } from "fxrack.slint";
