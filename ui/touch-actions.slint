import { Chip } from "widgets.slint";
import { Theme } from "theme.slint";
import { LibraryState } from "library.slint";
import { BrowserState, AutomixState } from "browser.slint";
import { DeviceState } from "device.slint";
import { PrefsState } from "prefs.slint";
import { MidiState } from "midi.slint";
import { PluginState } from "plugins.slint";
import { KeysState } from "help.slint";
import { AboutState } from "about.slint";
import { WelcomeState } from "welcome.slint";
import { LayoutState } from "split.slint";

component Action inherits Chip {
    in property <string> action;
    clicked => { LibraryState.action(root.action); }
}

/// The desktop commands remain available without a mouse or keyboard-sized menu bar.
export component TouchActions inherits Rectangle {
    callback fullscreen-toggled();
    callback zoom-all(int);
    height: items.preferred-height + 16px;
    items := VerticalLayout {
        x: 8px; y: 8px; width: parent.width - 16px; spacing: 8px; alignment: start;
        Text { text: @tr("Application"); color: Theme.text-bright; font-size: Theme.font-lg; }
        Chip { text: @tr("Preferences / themes / extensions"); clicked => { PrefsState.visible = true; } }
        Chip { text: @tr("MIDI and controllers"); clicked => { MidiState.captured = ""; MidiState.visible = true; } }
        Chip { text: @tr("Devices and export"); clicked => { DeviceState.visible = true; DeviceState.opened(); } }
        Chip { text: @tr("Full screen"); clicked => { root.fullscreen-toggled(); } }
        Chip { text: LayoutState.split-open ? @tr("Close split screen") : @tr("Split screen"); clicked => { LayoutState.split-toggle(); } }
        Chip { text: @tr("Switch split-screen window"); enabled: LayoutState.split-open; clicked => { LayoutState.split-switch(); } }
        HorizontalLayout {
            Chip { text: @tr("Zoom −"); clicked => { root.zoom-all(-1); } }
            Chip { text: @tr("Reset zoom"); clicked => { root.zoom-all(0); } }
            Chip { text: @tr("Zoom +"); clicked => { root.zoom-all(1); } }
        }
        Text { text: @tr("Import & collection"); color: Theme.text-bright; font-size: Theme.font-lg; }
        Action { text: @tr("Import track"); action: "import-track"; }
        Action { text: @tr("Import folder"); action: "import-folder"; }
        Action { text: @tr("Import playlist"); action: "import-playlist"; }
        for label[i] in LibraryState.import-readers: Action { text: @tr("Import {}", label); action: "import-collection:" + i; }
        for label[i] in LibraryState.export-writers: Action { text: @tr("Export {}", label); action: "export-collection:" + i; }
        Action { text: @tr("Find missing files"); action: "missing"; }
        Action { text: @tr("Find duplicates"); action: "dupes"; }
        Action { text: @tr("Back up library"); action: "backup"; }
        Action { text: @tr("Restore library"); action: "restore"; }
        Chip { text: @tr("Manage device backups"); clicked => { DeviceState.manage-backups(); } }
        Action { text: LibraryState.undo-label == "" ? @tr("Undo") : @tr("Undo {}", LibraryState.undo-label); enabled: LibraryState.undo-label != ""; action: "undo"; }
        Action { text: LibraryState.redo-label == "" ? @tr("Redo") : @tr("Redo {}", LibraryState.redo-label); enabled: LibraryState.redo-label != ""; action: "redo"; }
        Text { text: @tr("Selected track"); color: Theme.text-bright; font-size: Theme.font-lg; }
        Action { text: @tr("Edit track details"); action: "track-edit"; }
        Action { text: @tr("Import to collection"); action: "track-import"; }
        Action { text: @tr("Analyze track"); action: "track-analyze"; }
        Action { text: @tr("Analysis lock"); action: "track-lock"; }
        Action { text: @tr("Reload tags"); action: "track-reload-tag"; }
        Action { text: @tr("Show in file manager"); action: "track-show"; }
        Action { text: @tr("Relocate track"); action: "track-relocate"; }
        Action { text: @tr("Auto relocate"); action: "track-auto-relocate"; }
        Action { text: @tr("Remove from collection"); action: "track-remove"; }
        Chip { text: @tr("Add to tag list"); clicked => { BrowserState.tag-add(); } }
        Chip { text: @tr("Add to playlist"); clicked => { BrowserState.panel-request(0); } }
        Chip { text: @tr("Track tags"); clicked => { BrowserState.panel-request(1); } }
        Text { text: @tr("Playlists & mixing"); color: Theme.text-bright; font-size: Theme.font-lg; }
        Action { text: @tr("New playlist"); action: "playlist-new"; }
        Action { text: @tr("New intelligent playlist"); action: "playlist-new-smart"; }
        Action { text: @tr("New folder"); action: "playlist-new-folder"; }
        Action { text: @tr("Delete playlist"); action: "playlist-delete"; }
        for label[i] in [@tr("Title"), @tr("Artist"), @tr("Genre"), "BPM", @tr("Key"), @tr("Time"), @tr("Rating"), @tr("Comments")]: Action { text: @tr("Sort playlist by {}", label); action: "playlist-sort-" + ["title", "artist", "genre", "bpm", "key", "time", "rating", "comment"][i]; }
        Action { text: @tr("Renumber playlist"); action: "playlist-renumber"; }
        for label[i] in ["M3U8", "PLS", @tr("Text")]: Action { text: @tr("Export playlist as {}", label); action: "playlist-export-" + ["m3u8", "pls", "text"][i]; }
        Action { text: @tr("Export playlist to device"); action: "playlist-export-device"; }
        Action { text: @tr("Import playlist"); action: "playlist-import"; }
        Chip { text: @tr("Automix"); active: AutomixState.running; clicked => { AutomixState.toggled(); } }
        Chip { text: @tr("Related tracks"); active: BrowserState.related; clicked => { BrowserState.related-toggled(!BrowserState.related); } }
        for label[i] in PluginState.actions: Chip { text: label; clicked => { PluginState.run(i); } }
        Chip { text: @tr("Keyboard shortcuts"); clicked => { KeysState.help-visible = true; } }
        Chip { text: @tr("Welcome / suggested extensions"); clicked => { WelcomeState.show(); } }
        Chip { text: @tr("About / updates"); clicked => { AboutState.visible = true; } }
        Action { text: @tr("Exit OpenFadeR"); action: "exit"; }
    }
}
