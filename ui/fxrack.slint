import { Chip, Dropdown, Fader, Knob } from "widgets.slint";
import { Theme } from "theme.slint";
import { DeckState } from "deck.slint";

/// One plugin rack's values (src/app/fxrack/mod.rs): SEND FX, LEVER FX or MIC FX.
export struct RackView {
    /// Selector labels from the plugins of the rack's slot; `has` is false when there are none ("no plugin" is shown, disabled).
    names: [string],
    has: bool,
    effect: int,
    on: bool,
    /// RETURN level (SEND) / MIC FX LEVEL, 0..1.
    level: float,
    /// The plugin's parameter, 0..1 (PITCH: centre = no shift).
    param: float,
    beat-text: string,
}

/// The three plugin racks. Rack 0 = SEND FX, 1 = LEVER FX, 2 = MIC FX; every callback names its rack.
export global FxRackState {
    in-out property <[RackView]> racks;
    /// SEND knob of each channel, 0..1.
    in-out property <[float]> sends;
    /// Lever position, 0 (rest)..1; it springs back to 0 when released.
    in-out property <float> lever;
    callback effect-selected(int, int);
    callback toggled(int);
    callback level-edited(int, float);
    callback param-edited(int, float);
    callback beat-step(int, int);
    callback send-edited(int, float);
    callback lever-edited(float);
}

/// Dim caption naming the control group it precedes (FX panel).
export component FxLabel inherits Text {
    color: Theme.text-dim;
    font-family: Theme.font;
    font-size: Theme.font-xs;
    font-weight: Theme.weight-bold;
    vertical-alignment: center;
    horizontal-stretch: 0;
}

/// Hairline between two control groups of the FX panel.
export component FxDivider inherits Rectangle {
    width: 1px;
    horizontal-stretch: 0;
    background: Theme.line;
}

/// SEND FX / LEVER FX / MIC FX in the FX panel's slot of the two Beat FX units (`FxState.view` 3, 4, 5; `rack` = view - 3).
/// Centred control groups use the same native controls at the current input profile's target size.
export component FxRack inherits Rectangle {
    in property <int> rack;
    property <RackView> r: FxRackState.racks[root.rack];
    property <bool> touch: Theme.layout-profile == 1;
    property <length> ctl-h: root.touch ? Theme.touch-target : 20px;
    background: Theme.panel;
    VerticalLayout {
        alignment: center;
        padding-left: 8px;
        padding-right: 8px;
        HorizontalLayout {
            height: root.ctl-h;
            spacing: 10px;
            HorizontalLayout {
                spacing: 6px;
                horizontal-stretch: 0;
                FxLabel { text: "EFFECT"; }
                Dropdown {
                    options: r.has ? r.names : ["no plugin"];
                    current: r.effect;
                    enabled: r.has;
                    font-size: Theme.font-xs;
                    min-width: root.touch ? 4 * root.ctl-h : 140px;
                    list-width: root.touch ? 6 * root.ctl-h : 0px;
                    horizontal-stretch: 0;
                    height: root.ctl-h;
                    chose(i) => { FxRackState.effect-selected(root.rack, i); }
                }
                if root.rack != 1: Chip {
                    text: "ON";
                    font-size: Theme.font-xs;
                    min-width: root.touch ? root.ctl-h : 34px;
                    max-width: root.touch ? root.ctl-h : 34px;
                    horizontal-stretch: 0;
                    height: root.ctl-h;
                    enabled: r.has;
                    active: r.on;
                    active-color: Theme.play;
                    clicked => { FxRackState.toggled(root.rack); }
                }
            }
            FxDivider { }
            if root.rack != 1: HorizontalLayout {
                spacing: 4px;
                horizontal-stretch: 0;
                FxLabel { text: root.rack == 0 ? "RETURN" : "LEVEL"; }
                Knob { width: root.ctl-h; height: root.ctl-h; value: r.level; opacity: r.has ? 1 : 0.4; edited(v) => { if r.has { FxRackState.level-edited(root.rack, v); } } }
                Rectangle { width: 6px; }
                FxLabel { text: "PARAM"; }
                Knob { width: root.ctl-h; height: root.ctl-h; value: r.param; detent: root.rack == 2; opacity: r.has ? 1 : 0.4; edited(v) => { if r.has { FxRackState.param-edited(root.rack, v); } } }
            }
            if root.rack == 0: FxDivider { }
            if root.rack == 0: HorizontalLayout {
                spacing: 4px;
                horizontal-stretch: 0;
                FxLabel { text: "SEND"; }
                for n in DeckState.count: HorizontalLayout {
                    spacing: 2px;
                    FxLabel { text: "" + (n + 1); }
                    Knob { width: root.ctl-h; height: root.ctl-h; value: FxRackState.sends[n]; reset: 0; opacity: r.has ? 1 : 0.4; edited(v) => { if r.has { FxRackState.send-edited(n, v); } } }
                }
            }
            if root.rack == 1: HorizontalLayout {
                spacing: 6px;
                horizontal-stretch: 0;
                FxLabel { text: "LEVER"; }
                Fader {
                    width: root.touch ? 6 * root.ctl-h : 160px;
                    height: root.ctl-h;
                    value: FxRackState.lever;
                    opacity: r.has ? 1 : 0.4;
                    edited(v) => { if r.has { FxRackState.lever-edited(v); } }
                    released => { FxRackState.lever-edited(0); }
                }
            }
            if root.rack == 1: FxDivider { }
            if root.rack == 1: HorizontalLayout {
                spacing: 3px;
                horizontal-stretch: 0;
                FxLabel { text: "BEAT"; }
                Rectangle { width: 3px; }
                Chip { text: "◀"; font-size: Theme.font-xs; min-width: root.ctl-h; max-width: root.ctl-h; horizontal-stretch: 0; height: root.ctl-h; clicked => { FxRackState.beat-step(root.rack, -1); } }
                Text { text: r.beat-text; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.font-md; font-weight: Theme.weight-bold; horizontal-alignment: center; vertical-alignment: center; min-width: 30px; }
                Chip { text: "▶"; font-size: Theme.font-xs; min-width: root.ctl-h; max-width: root.ctl-h; horizontal-stretch: 0; height: root.ctl-h; clicked => { FxRackState.beat-step(root.rack, 1); } }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}
