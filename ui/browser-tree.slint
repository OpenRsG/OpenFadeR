import { ListView } from "std-widgets.slint";
import { Chip, Glyph, IconButton, Icon, TextField } from "widgets.slint";
import { Theme } from "theme.slint";
import { BrowserState } from "browser-state.slint";
import { DragState, TreeDropTarget } from "dnd.slint";

/// The playlist tree: `h-row` rows with the glyph of what each list is, the selected one on `select`. Headings (My
/// Playlists, History, Devices …) are taller and bold; a click on one folds or unfolds the rows under it.
export component TreeView inherits Rectangle {
    property <length> head-extra: Theme.tree-heading-extra;
    pure function row-y(i: int) -> length { return i * Theme.h-row + BrowserState.playlists[i].heads * root.head-extra; }
    pure function row-h(i: int) -> length { return Theme.h-row + (BrowserState.playlists[i].head ? root.head-extra : 0px); }
    in-out property <int> current-item: -1;
    /// The chosen row changed by click, key or `set-current-item`.
    callback item-changed(int);
    callback focused;
    out property <bool> has-focus: fs.has-focus;
    background: Theme.panel;
    clip: true;

    forward-focus: fs;
    /// Chooses row `i` (clamped), scrolls it into view and reports it, as the std list view did.
    public function set-current-item(i: int) {
        if (BrowserState.playlists.length == 0) { return; }
        root.current-item = max(0, min(BrowserState.playlists.length - 1, i));
        if (root.row-y(root.current-item) + list.content-y < 0) { list.content-y = -root.row-y(root.current-item); }
        else if (root.row-y(root.current-item) + root.row-h(root.current-item) + list.content-y > list.height) { list.content-y = list.height - root.row-y(root.current-item) - root.row-h(root.current-item); }
        root.item-changed(root.current-item);
    }

    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.UpArrow) { root.set-current-item(root.current-item - 1); return accept; }
            if (e.text == Key.DownArrow) { root.set-current-item(root.current-item + 1); return accept; }
            // Right unfolds the chosen heading; Left folds the section of the chosen row and goes to its heading.
            if (e.text == Key.RightArrow && BrowserState.playlists[root.current-item].head && !BrowserState.playlists[root.current-item].open) {
                BrowserState.tree-toggle(root.current-item);
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                let r = BrowserState.tree-back(root.current-item);
                if (r != root.current-item) { root.set-current-item(r); }
                return accept;
            }
            reject
        }
        list := ListView {
            for item[i] in BrowserState.playlists: Rectangle {
                property <length> indent: Theme.space-md + item.depth * Theme.tree-indent;
                property <length> glyph: item.head ? 16px : 14px;
                height: Theme.h-row + (item.head ? root.head-extra : 0px);
                background: i == root.current-item ? Theme.select : (ta.has-hover ? Theme.hover-row : transparent);
                // A hairline above each heading but the first keeps the sections apart.
                if item.head && item.heads > 0 && Theme.tree-lines == 1: Rectangle { y: 0; height: 1px; background: Theme.line; }
                if item.head: Glyph {
                    x: Theme.space-sm;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    icon: item.open ? Icon.chevron-down : Icon.chevron-right;
                    tint: Theme.text-dim;
                    stroke-width: 2px;
                }
                if item.head || Theme.tree-icons == 1: Glyph {
                    x: parent.indent + (item.head ? 12px : 0px);
                    y: (parent.height - self.height) / 2;
                    width: parent.glyph;
                    height: parent.glyph;
                    icon: item.icon;
                    tint: item.head ? Theme.tree-heading-icon : (i == root.current-item ? Theme.text-bright : Theme.text-faint);
                }
                Text {
                    x: parent.indent + (item.head ? 12px + parent.glyph + Theme.space-md : (Theme.tree-icons == 1 ? parent.glyph + Theme.space-md : 0px));
                    width: parent.width - self.x - Theme.space-md;
                    height: parent.height;
                    text: item.text;
                    vertical-alignment: center;
                    overflow: elide;
                    color: item.head ? Theme.tree-heading : (i == root.current-item ? Theme.text-bright : Theme.text-dim);
                    font-family: Theme.font;
                    font-size: item.head ? Theme.list-font + Theme.tree-heading-grow : Theme.list-font;
                    font-weight: item.head ? Theme.weight-bold : Theme.list-weight;
                }
                // Dragging a playlist onto a palette (Playlist Palette) shows it there.
                DragArea {
                    data: BrowserState.drag-tree(i);
                    allow-copy: true;
                    changed dragging => { DragState.drag-changed(self.dragging, BrowserState.drag-tree(i)); }
                    ta := TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                root.focused();
                                fs.focus();
                                root.set-current-item(i);
                                if (item.head) { BrowserState.tree-toggle(i); }
                            }
                        }
                        // Preferences > Advanced > Browse > Edit Library: rename by double click.
                        double-clicked => { if (BrowserState.edit-library) { BrowserState.side-rename(); } }
                    }
                }
                TreeDropTarget { tree-row: i; }
            }
        }
    }
    Rectangle { border-width: 1px; border-color: fs.has-focus ? Theme.accent : transparent; }
}

/// The picker on the table's right edge (ADD TO playlist, tags of the track, tag filter, NEW, MORE).
export component PickerPanel inherits Rectangle {
    background: Theme.panel-raised;
    border-width: 1px;
    border-color: Theme.line-strong;
    VerticalLayout {
        padding: Theme.space-sm;
        spacing: Theme.space-sm;
        HorizontalLayout {
            spacing: Theme.space-sm;
            Text { text: BrowserState.panel-title; color: Theme.text; font-family: Theme.font; font-size: Theme.font-sm; font-weight: Theme.weight-bold; vertical-alignment: center; overflow: elide; }
            IconButton { icon: Icon.close; tooltip: @tr("Close"); clicked => { BrowserState.panel-close(); } }
        }
        ListView {
            for item[i] in BrowserState.panel-rows: Rectangle {
                height: Theme.h-row;
                background: ta.has-hover ? Theme.select : transparent;
                Text { x: Theme.space-md; width: parent.width - 2 * Theme.space-md; height: parent.height; text: item.text; vertical-alignment: center; overflow: elide; color: Theme.text; font-family: Theme.font; font-size: Theme.font-size; }
                ta := TouchArea { clicked => { BrowserState.panel-row(i); } }
            }
        }
    }
}

/// Smart playlist editor: match all / any, one row per condition (kind, first and second box).
export component SmartEditor inherits Rectangle {
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line-strong;
    property <[string]> kinds: ["BPM", @tr("Key"), @tr("Rating ≥"), @tr("Genre contains"), @tr("Tags"), @tr("Date added")];
    property <[string]> hints-a: [@tr("BPM min"), "8A / Am / …", @tr("1-5 stars"), @tr("text"), @tr("tag name"), @tr("from YYYY-MM-DD")];
    property <[string]> hints-b: [@tr("BPM max"), "", "", "", "", @tr("to YYYY-MM-DD")];
    VerticalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-sm;
        HorizontalLayout {
            spacing: Theme.space-sm;
            Text { text: @tr("SMART PLAYLIST: {}", BrowserState.editor-title); color: Theme.text; font-family: Theme.font; font-size: Theme.font-sm; font-weight: Theme.weight-bold; vertical-alignment: center; overflow: elide; }
            Chip { text: BrowserState.editor-any ? @tr("MATCH ANY") : @tr("MATCH ALL"); width: 84px; horizontal-stretch: 0; clicked => { BrowserState.editor-any = !BrowserState.editor-any; } }
            Chip { text: @tr("+ CONDITION"); width: 88px; horizontal-stretch: 0; clicked => { BrowserState.cond-add(); } }
            Chip { text: @tr("SAVE"); width: 54px; horizontal-stretch: 0; active: true; clicked => { BrowserState.editor-save(); } }
            Chip { text: @tr("CANCEL"); width: 64px; horizontal-stretch: 0; clicked => { BrowserState.editor-cancel(); } }
        }
        if BrowserState.editor-error != "": Text { text: BrowserState.editor-error; color: Theme.danger; font-family: Theme.font; font-size: Theme.font-size; overflow: elide; vertical-stretch: 0; }
        ListView {
            for kind[i] in BrowserState.cond-kinds: HorizontalLayout {
                spacing: Theme.space-sm;
                height: Theme.h-ctl + Theme.space-sm;
                padding-bottom: Theme.space-sm;
                Chip { text: kinds[kind]; width: 110px; horizontal-stretch: 0; clicked => { BrowserState.cond-kind(i); } }
                TextField { placeholder-text: hints-a[kind]; text: BrowserState.cond-a[i]; edited(t) => { BrowserState.cond-edit(i, 0, t); } }
                if kind == 0 || kind == 5: TextField { placeholder-text: hints-b[kind]; text: BrowserState.cond-b[i]; edited(t) => { BrowserState.cond-edit(i, 1, t); } }
                IconButton { icon: Icon.close; tooltip: @tr("Remove condition"); clicked => { BrowserState.cond-remove(i); } }
            }
        }
    }
}
