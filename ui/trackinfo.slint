import { Chip, Glyph, Icon, IconButton, TextField } from "widgets.slint";
import { Theme } from "theme.slint";
import { DialogFrame, Note } from "dialog.slint";
import { LibraryState } from "library.slint";

/// Details of the selected track. Rust fills it through this global (src/app/trackinfo.rs).
export global TrackInfoState {
    in property <bool> has-track;
    in property <image> cover;
    in property <bool> has-cover;
    in property <string> title;
    in property <string> artist;
    in property <string> genre;
    in property <string> key;
    in property <string> bpm;
    in property <string> length;
    /// Bit rate, sample rate, date added.
    in property <string> details;
    in-out property <string> comment;
    /// "Phrases: High · 9" (mood, sections), empty when the track has no phrase analysis.
    in property <string> phrases;
    /// "Stem file: Drums · Bass · Melody · Vocals" for a stem file, else empty.
    in property <string> stems;
    /// "detected 125.00 BPM (library 128.00) · detected 9A (library 8A)": what our own analysis found where it differs from
    /// the library; empty when it agrees or nothing was analysed.
    in property <string> detected;
    /// Bulk analysis: "analyzing 3/12" while it runs, then "analyzed 12 …"; shown at the right end of the status bar.
    in property <string> progress;
    /// Stars, 0..5; click on a star.
    in property <int> rating;
    callback rating-set(int);
    /// Track colour: 0 = none, else colour id 1..8 (an index + 1 into `color-palette`).
    in property <int> color;
    in property <[color]> color-palette;
    callback color-set(int);
    /// The comment is edited in place: Enter saves it.
    callback comment-edited(string);
    in property <bool> editor-open;
    in property <string> edit-status;
    callback editor-closed();
    in property <bool> metadata-writable;
    in-out property <string> edit-title;
    in-out property <string> edit-artist;
    in-out property <string> edit-album;
    in-out property <string> edit-genre;
    in-out property <string> edit-label;
    callback metadata-edited(string, string, string, string, string);
}

component Line inherits Text {
    color: Theme.text-dim;
    font-family: Theme.font;
    font-size: Theme.font-size;
    overflow: elide;
}

/// Selected-track panel under the playlist tree (about 172 px wide): jacket + title block, key / BPM / time, tags, stars,
/// colour and the comment box.
export component TrackInfo inherits Rectangle {
    in property <bool> expanded;
    preferred-height: root.expanded ? content.preferred-height : 0px;
    background: Theme.panel;
    public function save-details() {
        if TrackInfoState.metadata-writable {
            TrackInfoState.metadata-edited(TrackInfoState.edit-title, TrackInfoState.edit-artist, TrackInfoState.edit-album, TrackInfoState.edit-genre, TrackInfoState.edit-label);
        } else {
            TrackInfoState.comment-edited(TrackInfoState.comment);
        }
    }

    if !TrackInfoState.has-track: Text {
        text: @tr("Select a track");
        color: Theme.text-faint;
        font-family: Theme.font;
        font-size: Theme.font-size;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    content := VerticalLayout {
        visible: TrackInfoState.has-track;
        padding: Theme.space-md;
        spacing: Theme.space-sm;
        alignment: start;
        HorizontalLayout {
            spacing: Theme.space-md;
            height: 56px;
            Rectangle {
                width: 56px;
                height: 56px;
                background: Theme.bg-deep;
                border-width: 1px;
                border-color: Theme.line;
                if TrackInfoState.has-cover: Image {
                    width: parent.width;
                    height: parent.height;
                    source: TrackInfoState.cover;
                    image-fit: contain;
                }
                if !TrackInfoState.has-cover: Glyph { icon: Icon.tag; tint: Theme.line-strong; width: 20px; height: 20px; }
            }
            VerticalLayout {
                spacing: 1px;
                alignment: start;
                Text { text: TrackInfoState.title; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.font-md; font-weight: Theme.weight-bold; wrap: word-wrap; max-height: 30px; overflow: elide; }
                Line { text: TrackInfoState.artist; }
                Line { text: TrackInfoState.genre; }
            }
        }
        Text { text: TrackInfoState.key + "  ·  " + TrackInfoState.bpm + " BPM  ·  " + TrackInfoState.length; color: Theme.text; font-family: Theme.font; font-size: Theme.font-size; font-weight: Theme.weight-bold; overflow: elide; }
        Text { text: TrackInfoState.details; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-size; wrap: word-wrap; max-height: 28px; overflow: elide; }
        if TrackInfoState.detected != "": Text { text: TrackInfoState.detected; color: Theme.cue; font-family: Theme.font; font-size: Theme.font-size; wrap: word-wrap; max-height: 28px; overflow: elide; }
        if TrackInfoState.phrases != "": Line { text: TrackInfoState.phrases; }
        if TrackInfoState.stems != "": Line { text: TrackInfoState.stems; }
        HorizontalLayout {
            alignment: start;
            Chip { text: @tr("FIND ARTWORK"); min-width: self.fit-width; tooltip: @tr("Look the cover up online"); clicked => { LibraryState.action("track-artwork"); } }
        }
        if !root.expanded: HorizontalLayout {
            alignment: start;
            spacing: 1px;
            height: Theme.h-ctl-sm;
            // Click star n = n stars; the current rating's star again = no rating.
            for i in 5: Rectangle {
                width: 15px;
                Glyph { icon: Icon.star; width: 12px; height: 12px; x: 1px; y: (parent.height - self.height) / 2; tint: i < TrackInfoState.rating ? Theme.text : Theme.text-faint; }
                TouchArea { clicked => { TrackInfoState.rating-set(i + 1); } }
            }
            Rectangle { width: 6px; }
            // Track colour chip (hollow = none); click opens the 8 colours, the set one again clears it.
            Rectangle {
                width: 14px;
                height: 14px;
                background: TrackInfoState.color > 0 ? TrackInfoState.color-palette[TrackInfoState.color - 1] : transparent;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.line-strong;
                TouchArea { clicked => { colors.show(); } }
                colors := PopupWindow {
                    x: 0px;
                    y: parent.height + 2px;
                    width: 8 * 20px + 8px;
                    height: 28px;
                    Rectangle {
                        background: Theme.panel-raised;
                        border-color: Theme.line-strong;
                        border-width: 1px;
                        border-radius: Theme.radius-lg;
                        HorizontalLayout {
                            padding: Theme.space-sm;
                            spacing: Theme.gap;
                            for c[k] in TrackInfoState.color-palette: Rectangle {
                                background: c;
                                border-radius: Theme.radius;
                                border-width: TrackInfoState.color == k + 1 ? 2px : 0px;
                                border-color: Theme.text-bright;
                                TouchArea { clicked => { TrackInfoState.color-set(k + 1); colors.close(); } }
                            }
                        }
                    }
                }
            }
        }
        if root.expanded: VerticalLayout {
            spacing: Theme.space-sm;
            Line { text: @tr("Rating (select the current star again to clear)"); }
            HorizontalLayout {
                alignment: start;
                spacing: Theme.space-sm;
                for i in 5: IconButton {
                    icon: Icon.star;
                    solid: true;
                    active: i < TrackInfoState.rating;
                    tooltip: @tr("Rating: {} stars", i + 1);
                    clicked => { TrackInfoState.rating-set(i + 1); }
                }
            }
            Line { text: @tr("Colour (select the current colour again to clear)"); }
            for row in 2: HorizontalLayout {
                spacing: Theme.space-sm;
                for col in 4: Chip {
                    text: [@tr("Pink"), @tr("Red"), @tr("Orange"), @tr("Yellow"), @tr("Green"), @tr("Aqua"), @tr("Blue"), @tr("Purple")][row * 4 + col];
                    active: TrackInfoState.color == row * 4 + col + 1;
                    clicked => { TrackInfoState.color-set(row * 4 + col + 1); }
                }
            }
            Line { text: @tr("Comment"); }
        }
        TextField {
            text <=> TrackInfoState.comment;
            placeholder-text: @tr("comment (Enter saves)");
            accepted(t) => { if root.expanded { root.save-details(); } else { TrackInfoState.comment-edited(t); } }
            init => { if root.expanded { self.focus-field(); } }
        }
        if root.expanded && TrackInfoState.metadata-writable: VerticalLayout {
            spacing: Theme.space-sm;
            Line { text: @tr("Title"); }
            TextField { text <=> TrackInfoState.edit-title; accepted => { root.save-details(); } }
            Line { text: @tr("Artist"); }
            TextField { text <=> TrackInfoState.edit-artist; accepted => { root.save-details(); } }
            Line { text: @tr("Album"); }
            TextField { text <=> TrackInfoState.edit-album; accepted => { root.save-details(); } }
            Line { text: @tr("Genre"); }
            TextField { text <=> TrackInfoState.edit-genre; accepted => { root.save-details(); } }
            Line { text: @tr("Label"); }
            TextField { text <=> TrackInfoState.edit-label; accepted => { root.save-details(); } }
        }
        if root.expanded && !TrackInfoState.metadata-writable: Note { text: @tr("Descriptive fields need a local file. Comments, rating and colour are still editable."); }
    }
}

/// The same metadata controls, reachable from a browser row even when the sidebar is hidden.
export component TrackInfoEditor inherits Rectangle {
    DialogFrame {
        title: @tr("EDIT TRACK DETAILS");
        card-width: min(480px, root.width - 16px);
        card-height: min(560px, root.height - 16px);
        body-padding: Theme.space-md;
        closed => { TrackInfoState.editor-closed(); }
        Flickable {
            content-width: self.width;
            content-height: editor-content.preferred-height;
            editor-content := VerticalLayout {
                width: parent.content-width;
                spacing: Theme.space-md;
                alignment: start;
                track-details := TrackInfo { expanded: true; vertical-stretch: 0; }
                Note { text: @tr("Enter or Save stores fields and comments in OpenFadeR. Rating and colour save immediately. Close discards unsaved text. BPM/key stay in their grid/analysis controls. Audio-file tags are not changed; opted-in two-way library connections keep their normal write-back behavior."); }
                if TrackInfoState.edit-status != "": Note { text: TrackInfoState.edit-status; }
                HorizontalLayout {
                    spacing: Theme.space-sm;
                    Chip { text: @tr("Save fields and comment"); active: true; clicked => { track-details.save-details(); } }
                    Chip { text: @tr("Close"); clicked => { TrackInfoState.editor-closed(); } }
                }
            }
        }
    }
}
