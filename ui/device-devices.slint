import { ListView } from "std-widgets.slint";
import { Chip } from "widgets.slint";
import { Theme } from "theme.slint";
import { Caption, DeviceState } from "device-state.slint";

/// DEVICES tab: the mounted USB drives and SD cards a library plugin handles (file system, free space, what library they hold,
/// the file-system warning) and what can be done with the chosen one: the buttons are the plugin's.
export component DevicesPage inherits VerticalLayout {
    spacing: Theme.space-lg;
    property <bool> picked: DeviceState.current >= 0 && DeviceState.current < DeviceState.devices.length;
    property <bool> writable: root.picked && DeviceState.devices[DeviceState.current].writable;
    property <bool> has-library: root.picked && DeviceState.devices[DeviceState.current].has-library;
    property <bool> can-export: root.picked && DeviceState.devices[DeviceState.current].can-export;
    property <bool> can-update: root.picked && DeviceState.devices[DeviceState.current].can-update;
    property <bool> can-histories: root.picked && DeviceState.devices[DeviceState.current].can-histories;
    property <bool> can-backup: root.picked && DeviceState.devices[DeviceState.current].can-backup;
    property <bool> can-settings: root.picked && DeviceState.devices[DeviceState.current].can-settings;
    Caption { text: "DEVICES"; }
    Rectangle {
        background: Theme.bg-deep;
        border-color: Theme.line-strong;
        border-width: 1px;
        if DeviceState.devices.length == 0: Text {
            x: Theme.space-xl;
            width: parent.width - 2 * Theme.space-xl;
            height: parent.height;
            text: "No USB drive or SD card is mounted. Insert one: it shows up here as soon as it is mounted.";
            wrap: word-wrap;
            vertical-alignment: center;
            color: Theme.text-faint;
            font-family: Theme.font;
            font-size: Theme.font-size;
        }
        ListView {
            for d[i] in DeviceState.devices: Rectangle {
                height: d.warning != "" ? 64px : 50px;
                background: i == DeviceState.current ? Theme.select : area.has-hover ? Theme.hover-row : transparent;
                VerticalLayout {
                    padding: Theme.space-md;
                    padding-left: Theme.space-xl;
                    spacing: Theme.space-xs;
                    HorizontalLayout {
                        spacing: Theme.space-lg;
                        Text { text: d.name; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.font-md; font-weight: Theme.weight-bold; overflow: elide; }
                        Text { text: d.library; horizontal-alignment: right; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-size; horizontal-stretch: 0; }
                    }
                    Text { text: d.summary; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-size; overflow: elide; }
                    if d.warning != "": Text { text: d.warning; color: d.writable ? Theme.cue : Theme.danger; font-family: Theme.font; font-size: Theme.font-size; overflow: elide; }
                    Rectangle {
                        height: 3px;
                        background: Theme.panel-high;
                        Rectangle { width: parent.width * d.used; background: d.used > 0.9 ? Theme.danger : Theme.accent; }
                    }
                }
                area := TouchArea { clicked => { DeviceState.select(i); } }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.space-md;
        vertical-stretch: 0;
        Chip { text: "EXPORT…"; enabled: root.writable && root.can-export; tooltip: "Create or extend the library on this device"; clicked => { DeviceState.tab = 1; DeviceState.opened(); } }
        Chip { text: "SYNC MANAGER"; enabled: root.writable && root.can-export; clicked => { DeviceState.tab = 2; DeviceState.opened(); } }
        Chip { text: "BACKUPS"; enabled: root.can-backup; clicked => { DeviceState.tab = 3; DeviceState.opened(); } }
        Chip { text: "SETTINGS"; enabled: root.can-settings; tooltip: "The device's settings (Preferences > DEVICE)"; clicked => { DeviceState.edit-settings(); } }
    }
    HorizontalLayout {
        spacing: Theme.space-md;
        vertical-stretch: 0;
        Chip { text: "UPDATE COLLECTION"; enabled: root.has-library && root.can-update && !DeviceState.busy; tooltip: "Import cues, grids, ratings, colours and comments edited on the player"; clicked => { DeviceState.update-collection(); } }
        Chip { text: "IMPORT HISTORIES"; enabled: root.has-library && root.can-histories && !DeviceState.busy; clicked => { DeviceState.import-histories(); } }
        for a in DeviceState.actions: Chip { text: a.label; enabled: a.enabled && (!a.writes || root.writable) && !DeviceState.busy; tooltip: a.help; clicked => { DeviceState.run-action(a.id); } }
        Chip { text: "EJECT"; enabled: root.picked && !DeviceState.busy; active: false; clicked => { DeviceState.eject(); } }
    }
}
