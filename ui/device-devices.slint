import { ListView } from "std-widgets.slint";
import { Chip, Dropdown, Glyph, Icon, Toggle } from "widgets.slint";
import { Theme } from "theme.slint";
import { Note } from "dialog.slint";
import { Caption, DeviceState, FormatItem } from "device-state.slint";

/// One of the two answers to "what is this device for": a title and a line under it, lit when it is the current one.
component ModeCard inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    height: Theme.layout-profile == 1 ? 104px : 62px;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.line-strong;
    background: root.active ? Theme.select : ta.has-hover && root.enabled ? Theme.hover-row : Theme.bg-deep;
    VerticalLayout {
        padding: Theme.space-lg;
        padding-left: Theme.space-xl;
        spacing: Theme.space-xs;
        Text { text: root.title; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.font-md; font-weight: Theme.weight-bold; }
        Text { text: root.text; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-sm; wrap: word-wrap; }
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

/// A library format of the chosen device: its switch and title, what of it the device holds, what reads it, and its options.
component FormatRow inherits Rectangle {
    in property <FormatItem> f;
    in property <int> index;
    in property <bool> enabled;
    background: root.f.on ? Theme.panel-raised : transparent;
    border-radius: Theme.radius;
    VerticalLayout {
        padding: Theme.space-md;
        padding-left: Theme.space-lg;
        spacing: Theme.space-xs;
        HorizontalLayout {
            spacing: Theme.space-md;
            Toggle {
                checked: root.f.on;
                enabled: root.enabled;
                horizontal-stretch: 0;
                toggled(on) => { DeviceState.format-toggle(root.index); }
            }
            Text { text: root.f.title; horizontal-stretch: 1; vertical-alignment: center; color: root.f.on ? Theme.text-bright : Theme.text; font-family: Theme.font; font-size: Theme.font-md; font-weight: Theme.weight-bold; }
            Text {
                text: root.f.held != "" ? @tr("ON THE DEVICE: {}", root.f.held) : root.f.on ? @tr("WRITTEN BY THE NEXT EXPORT") : @tr("OFF");
                horizontal-alignment: right;
                vertical-alignment: center;
                color: root.f.held != "" ? Theme.accent-hi : Theme.text-faint;
                font-family: Theme.font;
                font-size: Theme.font-sm;
                font-weight: Theme.weight-bold;
                overflow: elide;
                horizontal-stretch: 0;
            }
        }
        HorizontalLayout { padding-left: 22px; Note { text: root.f.about; color: Theme.text-dim; } }
        for o[k] in root.f.options: VerticalLayout {
            padding-left: 22px;
            spacing: Theme.space-xs;
            HorizontalLayout {
                spacing: Theme.space-md;
                alignment: start;
                if o.choices.length == 0: Toggle {
                    text: o.label;
                    checked: o.on;
                    enabled: root.enabled && root.f.on;
                    toggled(on) => { DeviceState.format-option(root.index, k, on ? 1 : 0); }
                }
                if o.choices.length > 0: Text { text: o.label; vertical-alignment: center; color: Theme.text; font-family: Theme.font; font-size: Theme.font-size; }
                if o.choices.length > 0: Dropdown {
                    options: o.choices;
                    current: o.current;
                    enabled: root.enabled && root.f.on;
                    width: 320px;
                    list-width: 320px;
                    chose(c) => { DeviceState.format-option(root.index, k, c); }
                }
            }
            HorizontalLayout { Note { text: o.hint; } }
        }
    }
}

/// A row of buttons with a dim caption in front.
component ActionRow inherits Rectangle {
    in property <string> label;
    height: Theme.h-ctl;
    vertical-stretch: 0;
    HorizontalLayout {
        spacing: Theme.space-md;
        Text { text: root.label; width: 128px; vertical-alignment: center; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-sm; font-weight: Theme.weight-bold; }
        viewport := Flickable {
            content-width: Theme.layout-profile == 1 ? max(self.width, controls.preferred-width) : self.width;
            content-height: self.height;
            controls := HorizontalLayout {
                width: viewport.content-width;
                height: viewport.height;
                spacing: Theme.space-md;
                @children
            }
        }
    }
}

/// DEVICES tab: the mounted USB drives and SD cards a library plugin handles on the left; on the right the chosen one: what it
/// is for (UNIVERSAL: every format, so any app or player reads it; DEDICATED: the ticked formats), the formats with what reads
/// each and their options, and what can be done with it (the plugin's buttons among them).
export component DevicesPage inherits HorizontalLayout {
    spacing: Theme.space-xl;
    property <bool> picked: DeviceState.current >= 0 && DeviceState.current < DeviceState.devices.length;
    property <bool> writable: root.picked && DeviceState.devices[DeviceState.current].writable;
    property <bool> has-library: root.picked && DeviceState.devices[DeviceState.current].has-library;
    property <bool> can-export: root.picked && DeviceState.devices[DeviceState.current].can-export;
    property <bool> can-update: root.picked && DeviceState.devices[DeviceState.current].can-update;
    property <bool> can-histories: root.picked && DeviceState.devices[DeviceState.current].can-histories;
    property <bool> can-backup: root.picked && DeviceState.devices[DeviceState.current].can-backup;
    property <bool> can-settings: root.picked && DeviceState.devices[DeviceState.current].can-settings;
    property <bool> formats-enabled: root.writable && !DeviceState.busy;
    VerticalLayout {
        width: 236px;
        spacing: Theme.space-sm;
        Caption { text: @tr("CONNECTED"); }
        Rectangle {
            background: Theme.bg-deep;
            border-color: Theme.line-strong;
            border-width: 1px;
            if DeviceState.devices.length == 0: Text {
                x: Theme.space-xl;
                width: parent.width - 2 * Theme.space-xl;
                height: parent.height;
                text: !DeviceState.has-plugin ? @tr("No device plugin is on. Switch one on in PREFERENCES > EXTENSIONS, then restart.") : @tr("No USB drive or SD card is mounted. Insert one: it shows up here, and as a USB icon on the left of the browser, as soon as it is mounted.");
                wrap: word-wrap;
                vertical-alignment: center;
                color: Theme.text-faint;
                font-family: Theme.font;
                font-size: Theme.font-size;
            }
            ListView {
                for d[i] in DeviceState.devices: Rectangle {
                    height: Theme.layout-profile == 1 ? (d.warning != "" ? 112px : 92px) : (d.warning != "" ? 78px : 62px);
                    background: i == DeviceState.current ? Theme.select : area.has-hover ? Theme.hover-row : transparent;
                    HorizontalLayout {
                        padding: Theme.space-md;
                        spacing: Theme.space-md;
                        Glyph { icon: Icon.usb; tint: i == DeviceState.current ? Theme.text-bright : Theme.text-dim; }
                        VerticalLayout {
                            spacing: Theme.space-xs;
                            Text { text: d.name; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.font-md; font-weight: Theme.weight-bold; overflow: elide; }
                            Text { text: d.library; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-sm; overflow: elide; }
                            Text { text: d.summary; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-sm; overflow: elide; }
                            if d.warning != "": Text { text: d.warning; color: d.writable ? Theme.cue : Theme.danger; font-family: Theme.font; font-size: Theme.font-sm; overflow: elide; }
                            Rectangle {
                                height: 3px;
                                background: Theme.panel-high;
                                Rectangle { x: 0; width: parent.width * d.used; background: d.used > 0.9 ? Theme.danger : Theme.accent; }
                            }
                        }
                    }
                    area := TouchArea { clicked => { DeviceState.select(i); } }
                }
            }
        }
    }
    if !root.picked && DeviceState.devices.length > 0: Text {
        text: @tr("Choose a device on the left.");
        vertical-alignment: center;
        horizontal-alignment: center;
        color: Theme.text-faint;
        font-family: Theme.font;
        font-size: Theme.font-md;
    }
    if !root.picked && DeviceState.devices.length == 0: Rectangle {}
    if root.picked: VerticalLayout {
        spacing: Theme.space-lg;
        HorizontalLayout {
            spacing: Theme.space-md;
            vertical-stretch: 0;
            VerticalLayout {
                spacing: Theme.space-xs;
                Text { text: DeviceState.devices[DeviceState.current].name; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.font-lg; font-weight: Theme.weight-bold; overflow: elide; }
                Text { text: DeviceState.devices[DeviceState.current].summary; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-sm; }
            }
            Chip { text: @tr("EJECT"); width: 72px; horizontal-stretch: 0; enabled: !DeviceState.busy; tooltip: @tr("Unmount it safely (a backup first, when Preferences ask for one)"); clicked => { DeviceState.eject(); } }
        }
        Caption { text: @tr("WHAT IS THIS DEVICE FOR?"); }
        HorizontalLayout {
            spacing: Theme.space-md;
            vertical-stretch: 0;
            ModeCard {
                title: @tr("UNIVERSAL");
                text: @tr("Every format below on one device: it works in each app and on each player they list. The music is stored once.");
                active: DeviceState.universal;
                enabled: root.formats-enabled;
                clicked => { DeviceState.format-universal(true); }
            }
            ModeCard {
                title: @tr("DEDICATED");
                text: @tr("Only the formats you tick below: for one app or one family of players. Exports are quicker.");
                active: !DeviceState.universal;
                enabled: root.formats-enabled;
                clicked => { DeviceState.format-universal(false); }
            }
        }
        Caption { text: @tr("FORMATS"); }
        // A Flickable over a layout, not a ListView: rows of wrapped text get their height for the width they are shown at.
        formats := Flickable {
            min-height: Theme.layout-profile == 1 ? 240px : 0px;
            content-width: self.width;
            content-height: rows.preferred-height;
            rows := VerticalLayout {
                width: formats.width;
                alignment: start;
                spacing: Theme.space-xs;
                for f[i] in DeviceState.formats: FormatRow { f: f; index: i; enabled: root.formats-enabled; }
            }
        }
        Note { text: @tr("Ticked formats are written by EXPORT, SYNC and the cue sync. Formats share one copy of each track, so ticking more costs little space."); vertical-stretch: 0; }
        ActionRow {
            label: @tr("PUT MUSIC ON IT");
            Chip { text: @tr("EXPORT…"); min-width: Theme.layout-profile == 1 ? Theme.target-size(self.fit-width) : 28px; enabled: root.writable && root.can-export; tooltip: @tr("Create or extend the libraries on this device"); clicked => { DeviceState.tab = 1; DeviceState.opened(); } }
            Chip { text: @tr("SYNC MANAGER"); min-width: Theme.layout-profile == 1 ? Theme.target-size(self.fit-width) : 28px; enabled: root.writable && root.can-export; tooltip: @tr("Keep chosen playlists up to date on this device"); clicked => { DeviceState.tab = 2; DeviceState.opened(); } }
        }
        ActionRow {
            label: @tr("BRING BACK");
            Chip { text: @tr("UPDATE COLLECTION"); min-width: Theme.layout-profile == 1 ? Theme.target-size(self.fit-width) : 28px; enabled: root.has-library && root.can-update && !DeviceState.busy; tooltip: @tr("Import cues, grids, ratings, colours and comments edited on the player"); clicked => { DeviceState.update-collection(); } }
            Chip { text: @tr("IMPORT HISTORIES"); min-width: Theme.layout-profile == 1 ? Theme.target-size(self.fit-width) : 28px; enabled: root.has-library && root.can-histories && !DeviceState.busy; tooltip: @tr("Import what the players played"); clicked => { DeviceState.import-histories(); } }
        }
        ActionRow {
            label: @tr("KEEP IT SAFE");
            Chip { text: @tr("BACKUPS"); min-width: Theme.layout-profile == 1 ? Theme.target-size(self.fit-width) : 28px; enabled: root.can-backup; tooltip: @tr("Back up or restore this device's library"); clicked => { DeviceState.tab = 3; DeviceState.opened(); } }
            Chip { text: @tr("SETTINGS"); min-width: Theme.layout-profile == 1 ? Theme.target-size(self.fit-width) : 28px; enabled: root.can-settings; tooltip: @tr("The player settings this device carries (Preferences > DJ SYSTEM)"); clicked => { DeviceState.edit-settings(); } }
        }
        if DeviceState.actions.length > 0: ActionRow {
            label: @tr("MORE");
            for a in DeviceState.actions: Chip { text: a.label; min-width: Theme.layout-profile == 1 ? Theme.target-size(self.fit-width) : 28px; enabled: a.enabled && (!a.writes || root.writable) && !DeviceState.busy; tooltip: a.help; clicked => { DeviceState.run-action(a.id); } }
        }
    }
}
