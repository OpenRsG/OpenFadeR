import { ListView } from "std-widgets.slint";
import { Chip } from "widgets.slint";
import { Theme } from "theme.slint";
import { DeviceState } from "device-state.slint";

/// The device panel docked into the browser's left tree (EXPORT mode): the mounted devices with their use, and
/// what can be done with the chosen one. EXPORT, SYNC MANAGER and BACKUPS open the device window (src/app/device) on their tab;
/// a running job shows its progress here too.
export component ExportDock inherits Rectangle {
    property <bool> picked: DeviceState.current >= 0 && DeviceState.current < DeviceState.devices.length;
    property <bool> writable: root.picked && DeviceState.devices[DeviceState.current].writable;
    property <bool> has-library: root.picked && DeviceState.devices[DeviceState.current].has-library;
    property <bool> can-export: root.picked && DeviceState.devices[DeviceState.current].can-export;
    property <bool> can-update: root.picked && DeviceState.devices[DeviceState.current].can-update;
    property <bool> can-backup: root.picked && DeviceState.devices[DeviceState.current].can-backup;
    property <bool> can-settings: root.picked && DeviceState.devices[DeviceState.current].can-settings;
    background: Theme.panel;
    init => { DeviceState.opened(); }
    VerticalLayout {
        padding: 3px;
        spacing: 2px;
        Text { text: @tr("DEVICES"); height: Theme.layout-profile == 1 ? 22px : 14px; color: Theme.text-dim; font-size: Theme.font-sm; font-weight: Theme.weight-bold; vertical-alignment: center; vertical-stretch: 0; }
        Rectangle {
            vertical-stretch: 1;
            min-height: Theme.layout-profile == 1 ? 2 * max(52px, Theme.target-size(30px)) : 0px;
            background: Theme.bg-deep;
            if DeviceState.devices.length == 0: Text {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                text: @tr("No USB drive or SD card is mounted.");
                wrap: word-wrap;
                vertical-alignment: center;
                color: Theme.text-faint;
                font-size: Theme.font-sm;
            }
            ListView {
                for d[i] in DeviceState.devices: Rectangle {
                    height: Theme.layout-profile == 1 ? max(52px, Theme.target-size(30px)) : 30px;
                    background: i == DeviceState.current ? Theme.select : area.has-hover ? Theme.hover-row : transparent;
                    VerticalLayout {
                        padding-left: 6px;
                        padding-right: 4px;
                        padding-top: 2px;
                        spacing: 1px;
                        Text { text: d.name; color: Theme.text-bright; font-size: Theme.font-size; font-weight: Theme.weight-bold; overflow: elide; }
                        Text { text: d.summary; color: Theme.text-dim; font-size: Theme.font-xs; overflow: elide; }
                        Rectangle {
                            height: 2px;
                            background: Theme.panel-high;
                            Rectangle { width: parent.width * d.used; background: d.used > 0.9 ? Theme.danger : Theme.accent; }
                        }
                    }
                    area := TouchArea { clicked => { DeviceState.select(i); } }
                }
            }
        }
        HorizontalLayout {
            spacing: 2px;
            vertical-stretch: 0;
            Chip { text: @tr("EXPORT"); min-width: Theme.target-size(28px); font-size: Theme.font-xs; height: Theme.target-size(20px); enabled: root.writable && root.can-export; tooltip: @tr("Create or extend the library on this device"); clicked => { DeviceState.tab = 1; DeviceState.visible = true; DeviceState.opened(); } }
            Chip { text: @tr("SYNC"); min-width: Theme.target-size(28px); font-size: Theme.font-xs; height: Theme.target-size(20px); enabled: root.writable && root.can-export; tooltip: @tr("SYNC MANAGER"); clicked => { DeviceState.tab = 2; DeviceState.visible = true; DeviceState.opened(); } }
            Chip { text: @tr("BACKUPS"); min-width: Theme.target-size(28px); font-size: Theme.font-xs; height: Theme.target-size(20px); enabled: root.can-backup; clicked => { DeviceState.tab = 3; DeviceState.visible = true; DeviceState.opened(); } }
        }
        HorizontalLayout {
            spacing: 2px;
            vertical-stretch: 0;
            Chip { text: @tr("UPDATE"); min-width: Theme.target-size(28px); font-size: Theme.font-xs; height: Theme.target-size(20px); enabled: root.has-library && root.can-update && !DeviceState.busy; tooltip: @tr("UPDATE COLLECTION: import the edits made on the player"); clicked => { DeviceState.update-collection(); } }
            Chip { text: @tr("SETTINGS"); min-width: Theme.target-size(28px); font-size: Theme.font-xs; height: Theme.target-size(20px); enabled: root.can-settings; clicked => { DeviceState.edit-settings(); } }
            Chip { text: @tr("EJECT"); min-width: Theme.target-size(28px); font-size: Theme.font-xs; height: Theme.target-size(20px); enabled: root.picked && !DeviceState.busy; clicked => { DeviceState.eject(); } }
        }
        Rectangle {
            height: Theme.layout-profile == 1 ? 22px : 14px;
            vertical-stretch: 0;
            background: DeviceState.busy ? Theme.panel-raised : transparent;
            if DeviceState.busy: Rectangle { width: parent.width * DeviceState.progress; background: Theme.accent; }
            Text {
                x: 3px;
                width: parent.width - 6px;
                text: DeviceState.busy ? DeviceState.phase + " " + round(DeviceState.progress * 100) + "%" : DeviceState.status;
                color: DeviceState.busy ? Theme.text-bright : (DeviceState.failed ? Theme.danger : Theme.text-dim);
                font-size: Theme.font-xs;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
