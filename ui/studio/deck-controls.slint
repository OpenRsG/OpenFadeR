import { Chip, Dropdown, Fader, Icon, Knob } from "../widgets.slint";
import { Theme } from "../theme.slint";
import { DeckState, DeckView } from "../deck-state.slint";
import { FxState, FxUnit } from "../fx.slint";
import { JogWheel } from "../deck-controls.slint";
import { PadGrid, PadOptions, PadsState } from "../pads.slint";
import { BigButton, Caption, PillTabs } from "parts.slint";

/// The three Beat FX slots of the deck's unit (deck A: FX1, deck B: FX2): ON, the effect drop-down and the level knob of each,
/// then the unit's channel (CH n / MST) over its BEAT ◀ ▶ selector, which steps the lit slot's beat fraction.
export component StudioFx inherits Rectangle {
    in property <int> index;
    /// The FX unit of this deck's side (FX1 left, FX2 right), whichever deck the slot draws; `index` is the deck whose channel it takes.
    property <int> unit: Math.mod(root.index, 2);
    property <FxUnit> u: FxState.units[root.unit];
    property <length> gap: Theme.studio-gap;
    HorizontalLayout {
        spacing: root.gap;
        for s[i] in root.u.slots: Rectangle {
            background: Theme.bg-deep;
            border-radius: Theme.studio-radius-ctl;
            HorizontalLayout {
                padding: Theme.space-sm;
                spacing: Theme.space-sm;
                Chip {
                    text: "" + (i + 1);
                    width: 22px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 0;
                    font-size: Theme.font-xs;
                    active: s.on;
                    active-color: Theme.play;
                    tooltip: @tr("FX{}-{} ON", root.unit + 1, i + 1);
                    clicked => { FxState.toggled(root.unit, i); }
                }
                Dropdown {
                    options: FxState.effects;
                    current: s.effect;
                    font-size: Theme.font-xs;
                    min-width: 40px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    chose(e) => { FxState.effect-selected(root.unit, i, e); }
                }
                Knob {
                    width: 30px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 0;
                    value: s.level;
                    arc-color: Theme.accent;
                    edited(v) => { FxState.level-edited(root.unit, i, v); }
                }
            }
        }
        VerticalLayout {
            width: 88px;
            horizontal-stretch: 0;
            alignment: center;
            spacing: Theme.space-sm;
            Chip {
                text: root.u.assign == 4 ? @tr("MST") : @tr("CH{}", root.u.assign + 1);
                height: 20px;
                font-size: Theme.font-xs;
                active: root.u.assign == root.index;
                tooltip: @tr("The unit's channel: this deck, or the master (click to switch)");
                clicked => { FxState.assign-selected(root.unit, root.u.assign == root.index ? 4 : root.index); }
            }
            HorizontalLayout {
                height: 22px;
                spacing: 2px;
                Chip { text: "◀"; width: 24px; horizontal-stretch: 0; tooltip: @tr("BEAT down (the lit slot)"); clicked => { FxState.beat-step(root.unit, -1); } }
                Text {
                    text: root.u.slots.length > root.u.target ? root.u.slots[root.u.target].beat-text : "";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Theme.text-bright;
                    font-family: Theme.font;
                    font-size: Theme.font-xs;
                    font-weight: Theme.weight-bold;
                }
                Chip { text: "▶"; width: 24px; horizontal-stretch: 0; tooltip: @tr("BEAT up (the lit slot)"); clicked => { FxState.beat-step(root.unit, 1); } }
            }
        }
    }
}

/// LOOP: ◀ and ▶ halve and double the running loop (or the length the box shows while none runs), the box starts and leaves a loop
/// of that many beats, IN and OUT set a manual loop, RELOOP goes back into the last one.
component StudioLoop inherits VerticalLayout {
    in property <int> index;
    property <DeckView> v: DeckState.decks[root.index];
    property <int> auto-n: 4;
    /// The ◀ ▶ chips picked a length here; until then the box shows and starts the PREFS > Auto Beat Loop length.
    property <bool> custom;
    property <int> shown: root.custom ? root.auto-n : (root.v.auto-beats > 0 ? root.v.auto-beats : root.auto-n);
    spacing: Theme.space-md;
    alignment: center;
    Caption { text: @tr("LOOP"); height: 14px; horizontal-alignment: center; }
    HorizontalLayout {
        spacing: Theme.space-sm;
        Chip {
            text: "◀";
            width: 26px;
            horizontal-stretch: 0;
            tooltip: @tr("Halve the loop");
            enabled: root.v.loaded;
            clicked => { if (root.v.loop-active) { DeckState.loop-halve(root.index); } else { root.auto-n = Math.max(1, Math.floor(root.shown / 2)); root.custom = true; } }
        }
        Rectangle {
            background: Theme.bg-deep;
            border-radius: Theme.studio-radius-ctl;
            border-width: 1px;
            border-color: root.v.loop-active ? Theme.accent : Theme.line;
            opacity: root.v.loaded ? 1 : 0.5;
            Text {
                text: root.v.loop-active ? (root.v.loop-beats > 0 ? "" + root.v.loop-beats : @tr("LOOP")) : "" + root.shown;
                color: root.v.loop-active ? Theme.accent-hi : Theme.text-bright;
                font-family: Theme.font;
                font-size: Theme.font-lg;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                enabled: root.v.loaded;
                clicked => { if (root.v.loop-active) { DeckState.reloop(root.index); } else { DeckState.auto-loop(root.index, root.custom ? root.auto-n : 0); } }
            }
        }
        Chip {
            text: "▶";
            width: 26px;
            horizontal-stretch: 0;
            tooltip: @tr("Double the loop");
            enabled: root.v.loaded;
            clicked => { if (root.v.loop-active) { DeckState.loop-double(root.index); } else { root.auto-n = Math.min(16, root.shown * 2); root.custom = true; } }
        }
    }
    HorizontalLayout {
        spacing: Theme.space-sm;
        Chip { text: @tr("IN"); enabled: root.v.loaded; tooltip: @tr("Loop in at the playhead"); clicked => { DeckState.loop-in(root.index); } }
        Chip { text: @tr("OUT"); enabled: root.v.loaded; tooltip: @tr("Loop out at the playhead: the loop starts"); clicked => { DeckState.loop-out(root.index); } }
    }
    Chip { text: @tr("RELOOP"); active: root.v.loop-active; enabled: root.v.loaded; tooltip: @tr("Leave the loop, or go back into the last one"); clicked => { DeckState.reloop(root.index); } }
}

/// The middle row of a deck: the loop block, the round jog (BPM, tempo, elapsed and remaining; drag it to scratch), the tempo fader
/// with − and +, and PLAY, CUE and SYNC. Odd decks are mirrored.
export component StudioMid inherits Rectangle {
    in property <int> index;
    property <DeckView> v: DeckState.decks[root.index];
    property <bool> mirror: Math.mod(root.index, 2) == 1;
    property <length> loop-w: 112px;
    property <length> tempo-w: 52px;
    property <length> btn-w: 108px;
    property <length> jog-d: min(root.height, 200px);
    /// What the blocks leave over, shared between the three gaps.
    property <length> space: max(6px, (root.width - root.loop-w - root.jog-d - root.tempo-w - root.btn-w) / 3);
    property <length> last-x;
    /// The x of a block `w` wide that sits at `x` in the unmirrored row.
    pure function px(x: length, w: length) -> length { return root.mirror ? root.width - x - w : x; }
    StudioLoop { index: root.index; x: root.px(0px, root.loop-w); width: root.loop-w; height: root.height; }
    // The jog: a drag on it scratches (under the readout's own double-click and range click).
    jog := Rectangle {
        x: root.px(root.loop-w + root.space, root.jog-d);
        y: (root.height - root.jog-d) / 2;
        width: root.jog-d;
        height: root.jog-d;
        TouchArea {
            enabled: root.v.loaded;
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
            pointer-event(e) => {
                if e.button == PointerEventButton.left {
                    if e.kind == PointerEventKind.down { root.last-x = self.mouse-x; DeckState.scratch-begin(root.index); }
                    if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { DeckState.scratch-end(root.index); }
                }
            }
            moved => {
                if self.pressed {
                    DeckState.scratch-move(root.index, self.mouse-x - root.last-x);
                    root.last-x = self.mouse-x;
                }
            }
        }
        JogWheel { index: root.index; width: root.jog-d; height: root.jog-d; }
        Text {
            x: 0px;
            y: parent.height * 0.75;
            width: parent.width;
            text: root.v.elapsed-text;
            color: Theme.jog-text;
            font-family: Theme.font;
            font-size: root.jog-d > 170px ? Theme.font-md : Theme.font-xs;
            font-weight: Theme.weight-bold;
            horizontal-alignment: center;
        }
        Text {
            x: 0px;
            y: parent.height * 0.75 + (root.jog-d > 170px ? 16px : 12px);
            width: parent.width;
            text: root.v.remain-text;
            color: Theme.jog-text;
            font-family: Theme.font;
            font-size: root.jog-d > 170px ? Theme.font-md : Theme.font-xs;
            horizontal-alignment: center;
        }
    }
    Rectangle {
        x: root.px(root.loop-w + root.space + root.jog-d + root.space, root.tempo-w);
        width: root.tempo-w;
        height: root.height;
        property <length> ch: 28px;
        // The fader's top is the faster end unless PREFS > VIEW turns it round (the fader position then runs the other way).
        Chip { y: 0px; height: parent.ch; width: parent.width; text: DeckState.tempo-reverse ? "−" : "+"; min-width: 0px; enabled: root.v.loaded; tooltip: DeckState.tempo-reverse ? @tr("Slower") : @tr("Faster"); clicked => { DeckState.tempo(root.index, clamp(root.v.tempo + (DeckState.tempo-reverse ? -0.01 : 0.01), 0, 1)); } }
        Fader {
            y: parent.ch + Theme.space-sm;
            width: parent.width;
            height: max(0px, parent.height - 2 * (parent.ch + Theme.space-sm));
            vertical: true;
            detent: true;
            value: DeckState.tempo-fader(root.v.tempo);
            edited(p) => { DeckState.tempo(root.index, DeckState.tempo-fader(p)); }
        }
        Chip { y: parent.height - parent.ch; height: parent.ch; width: parent.width; text: DeckState.tempo-reverse ? "+" : "−"; min-width: 0px; enabled: root.v.loaded; tooltip: DeckState.tempo-reverse ? @tr("Faster") : @tr("Slower"); clicked => { DeckState.tempo(root.index, clamp(root.v.tempo + (DeckState.tempo-reverse ? 0.01 : -0.01), 0, 1)); } }
    }
    VerticalLayout {
        x: root.px(root.loop-w + root.space + root.jog-d + root.space + root.tempo-w + root.space, root.btn-w);
        width: root.btn-w;
        height: root.height;
        alignment: center;
        spacing: Theme.space-lg;
        property <length> bh: clamp((root.height - 2 * Theme.space-lg) / 3, 30px, Theme.studio-button);
        BigButton {
            height: parent.bh;
            text: root.v.playing ? @tr("PAUSE") : @tr("PLAY");
            icon: root.v.playing ? Icon.pause : Icon.play;
            tone: Theme.play;
            lit: root.v.playing;
            enabled: root.v.loaded;
            tooltip: @tr("Play / pause");
            clicked => { DeckState.play-pause(root.index); }
        }
        BigButton {
            height: parent.bh;
            text: @tr("CUE");
            tone: Theme.cue;
            lit: root.v.at-cue;
            enabled: root.v.loaded;
            tooltip: @tr("Cue: hold to preview, release to return");
            pressed => { DeckState.cue(root.index); }
            released => { DeckState.cue-released(root.index); }
        }
        BigButton {
            height: parent.bh;
            text: @tr("SYNC");
            tone: Theme.sync;
            lit: root.v.synced;
            enabled: root.v.loaded;
            tooltip: @tr("Beat sync to the master");
            clicked => { DeckState.sync(root.index); }
        }
    }
}

/// The pad area: HOT CUES / PAD FX / BEAT JUMP / SAMPLER tabs (the drop-down reaches every other pad mode, × deletes a hot cue),
/// the eight pads of the mode, and the mode's option chips (SAMPLER bank and so on) when it has any.
export component StudioPads inherits Rectangle {
    in property <int> index;
    property <DeckView> v: DeckState.decks[root.index];
    /// Pad modes of the four tabs: HOT CUE, PAD FX, BEAT JUMP, SAMPLER.
    property <[int]> tab-modes: [0, 4, 1, 9];
    property <int> tab: root.v.pad-mode == 0 ? 0 : root.v.pad-mode == 4 ? 1 : root.v.pad-mode == 1 ? 2 : root.v.pad-mode == 9 ? 3 : -1;
    property <bool> options: PadsState.options.length > root.index && PadsState.options[root.index].length > 0;
    VerticalLayout {
        spacing: Theme.space-md;
        HorizontalLayout {
            height: Theme.h-ctl;
            spacing: Theme.space-md;
            PillTabs {
                options: [@tr("HOT CUES"), @tr("PAD FX"), @tr("BEAT JUMP"), @tr("SAMPLER")];
                current: root.tab;
                chose(i) => { DeckState.pad-mode(root.index, root.tab-modes[i]); }
            }
            Dropdown {
                width: 64px;
                horizontal-stretch: 0;
                label: @tr("MORE");
                list-width: 130px;
                options: root.v.stems ? DeckState.pad-mode-names-stems : DeckState.pad-mode-names;
                current: !root.v.stems && root.v.pad-mode > 11 ? root.v.pad-mode - 1 : root.v.pad-mode;
                chose(m) => { DeckState.pad-mode(root.index, !root.v.stems && m >= 11 ? m + 1 : m); }
            }
            Chip { text: "×"; width: Theme.h-ctl; horizontal-stretch: 0; tooltip: @tr("Delete a hot cue: press its pad"); active: root.v.delete-mode; active-color: Theme.danger; enabled: root.v.loaded && root.v.pad-mode == 0; clicked => { DeckState.cue-delete(root.index); } }
        }
        PadGrid {
            vertical-stretch: 1;
            min-height: 0px;
            pads: root.v.pads;
            mode: root.v.pad-mode;
            enabled: root.v.loaded;
            delete-mode: root.v.delete-mode;
            fx-color: DeckState.pad-fx-color;
            pad(p) => { DeckState.pad(root.index, p); }
            pad-released => { DeckState.pad-released(root.index); }
        }
        if root.options: PadOptions { index: root.index; height: Theme.h-ctl; }
    }
}
