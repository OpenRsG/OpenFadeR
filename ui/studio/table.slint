import { ListView } from "std-widgets.slint";
import { Chip, Glyph, Icon, MenuItem } from "../widgets.slint";
import { Theme } from "../theme.slint";
import { BrowserState } from "../browser-state.slint";
import { DeckState } from "../deck-state.slint";
import { DragState } from "../dnd.slint";
import { LibraryState } from "../library.slint";
import { StudioState } from "../studio-state.slint";

/// A sortable column title of the track list.
component Head inherits Rectangle {
    in property <string> title;
    in property <bool> sorted;
    in property <bool> right;
    callback clicked;
    background: ta.has-hover ? Theme.panel-raised : transparent;
    border-radius: Theme.studio-radius-ctl;
    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: 2px;
        alignment: root.right ? LayoutAlignment.end : LayoutAlignment.start;
        Text {
            text: root.title;
            vertical-alignment: center;
            overflow: elide;
            color: root.sorted ? Theme.text-bright : Theme.text-dim;
            font-family: Theme.font;
            font-size: Theme.font-xs;
            font-weight: Theme.weight-bold;
        }
        if root.sorted: Glyph { width: 12px; height: 12px; y: (parent.height - self.height) / 2; icon: BrowserState.sort-asc ? Icon.tri-up : Icon.tri-down; tint: Theme.accent; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Cell inherits Text {
    in property <bool> right;
    vertical-alignment: center;
    horizontal-alignment: root.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
    overflow: elide;
    color: Theme.text;
    font-family: Theme.font;
    font-size: Theme.list-font;
}

/// The studio track list: a thumbnail, the rating, title, artist, length, BPM, the key in its Camelot colour and the genre of
/// each row of `BrowserState.tracks`; the chosen row is lit. A click chooses a row (two quick ones load it, as in the desktop list),
/// a right click opens the track menu, a row can be dragged onto a deck. The columns sort from their titles.
export component StudioTable inherits Rectangle {
    in property <length> row-h: Theme.studio-row;
    callback focused;
    out property <bool> has-focus: fs.has-focus;
    public function focus-list() { fs.focus(); }
    property <bool> wide: root.width >= 640px;
    property <length> pad: Theme.studio-gap;
    property <length> w-thumb: root.row-h;
    property <length> w-rating: 82px;
    property <length> w-artist: root.wide ? 150px : 110px;
    property <length> w-time: 56px;
    property <length> w-bpm: 56px;
    property <length> w-key: 48px;
    property <length> w-genre: root.wide ? 96px : 0px;
    property <length> w-scroll: 14px;
    property <length> w-title: max(80px, root.width - 2 * root.pad - root.w-scroll - root.w-thumb - root.w-rating - root.w-artist - root.w-time - root.w-bpm - root.w-key - root.w-genre);
    property <length> x-rating: root.pad + root.w-thumb;
    property <length> x-title: root.x-rating + root.w-rating;
    property <length> x-artist: root.x-title + root.w-title;
    property <length> x-time: root.x-artist + root.w-artist;
    property <length> x-bpm: root.x-time + root.w-time;
    property <length> x-key: root.x-bpm + root.w-bpm;
    property <length> x-genre: root.x-key + root.w-key;
    property <length> menu-x;
    property <length> menu-y;
    property <int> cover-generation: BrowserState.cover-generation;
    property <int> current: BrowserState.current-row;
    // Rows move under the selection from outside too (the keyboard, MIDI, Rust): keep the chosen one in view.
    changed current => { root.reveal(root.current); }
    function reveal(i: int) {
        if (i < 0) { return; }
        if (i * root.row-h + list.content-y < 0) { list.content-y = -i * root.row-h; }
        else if ((i + 1) * root.row-h + list.content-y > list.height) { list.content-y = list.height - (i + 1) * root.row-h; }
    }
    function choose(i: int) {
        BrowserState.current-row = i;
        BrowserState.track-selected(i);
    }
    function move(d: int) {
        if (BrowserState.tracks.length > 0) { root.choose(max(0, min(BrowserState.tracks.length - 1, BrowserState.current-row + d))); }
    }
    function place-menu(x: length, y: length) {
        root.menu-x = min(x, root.width - 200px);
        root.menu-y = min(y, max(0px, root.height - 9 * Theme.h-row - 4px));
    }
    init => { StudioState.rows = max(1, floor((root.height - Theme.h-header) / root.row-h)); }
    changed height => { StudioState.rows = max(1, floor((root.height - Theme.h-header) / root.row-h)); }
    forward-focus: fs;
    background: Theme.panel;
    border-radius: Theme.studio-radius;
    clip: true;
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.UpArrow) { root.move(-1); return accept; }
            if (e.text == Key.DownArrow) { root.move(1); return accept; }
            if (e.text == Key.PageUp) { root.move(-10); return accept; }
            if (e.text == Key.PageDown) { root.move(10); return accept; }
            if (e.text == Key.Home) { root.choose(0); return accept; }
            if (e.text == Key.End) { root.choose(max(0, BrowserState.tracks.length - 1)); return accept; }
            reject
        }
        VerticalLayout {
            Rectangle {
                height: Theme.h-header + Theme.space-sm;
                Head { x: root.x-rating; width: root.w-rating; height: Theme.h-header; y: Theme.space-sm; title: @tr("RATING"); sorted: BrowserState.sort-col == 6; clicked => { StudioState.sort-by(6); } }
                Head { x: root.x-title; width: root.w-title; height: Theme.h-header; y: Theme.space-sm; title: @tr("TITLE"); sorted: BrowserState.sort-col == 0; clicked => { StudioState.sort-by(0); } }
                Head { x: root.x-artist; width: root.w-artist; height: Theme.h-header; y: Theme.space-sm; title: @tr("ARTIST"); sorted: BrowserState.sort-col == 1; clicked => { StudioState.sort-by(1); } }
                Head { x: root.x-time; width: root.w-time; height: Theme.h-header; y: Theme.space-sm; title: @tr("LENGTH"); right: true; sorted: BrowserState.sort-col == 5; clicked => { StudioState.sort-by(5); } }
                Head { x: root.x-bpm; width: root.w-bpm; height: Theme.h-header; y: Theme.space-sm; title: "BPM"; right: true; sorted: BrowserState.sort-col == 4; clicked => { StudioState.sort-by(4); } }
                Head { x: root.x-key; width: root.w-key; height: Theme.h-header; y: Theme.space-sm; title: @tr("KEY"); sorted: BrowserState.sort-col == 3; clicked => { StudioState.sort-by(3); } }
                if root.w-genre > 0px: Head { x: root.x-genre; width: root.w-genre; height: Theme.h-header; y: Theme.space-sm; title: @tr("GENRE"); sorted: BrowserState.sort-col == 2; clicked => { StudioState.sort-by(2); } }
            }
            list := ListView {
                for cells[i] in BrowserState.tracks: Rectangle {
                    height: root.row-h;
                    property <bool> current: i == BrowserState.current-row;
                    property <int> gen: root.cover-generation;
                    property <bool> on-deck: cells[0].text != "" && (DeckState.decks[0].title == cells[0].text || DeckState.decks[1].title == cells[0].text);
                    changed gen => { BrowserState.cover-wanted(i); }
                    init => { BrowserState.cover-wanted(i); }
                    Rectangle {
                        x: root.pad / 2;
                        y: 1px;
                        width: parent.width - root.pad - root.w-scroll + root.pad / 2;
                        height: parent.height - 2px;
                        border-radius: Theme.studio-radius-ctl;
                        background: current ? Theme.select : row-ta.has-hover ? Theme.hover-row : transparent;
                    }
                    Rectangle {
                        x: root.pad;
                        y: (parent.height - self.height) / 2;
                        width: root.row-h - 6px;
                        height: self.width;
                        border-radius: 4px;
                        background: Theme.panel-raised;
                        clip: true;
                        Text { text: "♪"; color: Theme.panel-high; font-size: (root.row-h - 6px) * 0.6; horizontal-alignment: center; vertical-alignment: center; }
                        Image { source: BrowserState.covers[i]; image-fit: cover; }
                    }
                    Text { x: root.x-rating + Theme.space-md; height: parent.height; text: @tr("★★★★★"); vertical-alignment: center; color: Theme.text-disabled; font-size: 10px; letter-spacing: 1px; }
                    Text { x: root.x-rating + Theme.space-md; height: parent.height; text: cells[6].text; vertical-alignment: center; color: Theme.accent-hi; font-size: 10px; letter-spacing: 1px; }
                    Cell { x: root.x-title; width: root.w-title - Theme.space-md; text: cells[0].text; font-weight: Theme.weight-semi; color: on-deck ? Theme.accent-hi : cells[10].text == "1" ? Theme.text-dim : Theme.text-bright; }
                    Cell { x: root.x-artist; width: root.w-artist - Theme.space-md; text: cells[1].text; color: Theme.row-dim; }
                    Cell { x: root.x-time; width: root.w-time - Theme.space-md; text: cells[5].text; right: true; color: Theme.row-dim; }
                    Cell { x: root.x-bpm; width: root.w-bpm - Theme.space-md; text: cells[4].text; right: true; color: cells[9].text == "b" || cells[9].text == "kb" ? Theme.play : Theme.text; }
                    Cell { x: root.x-key + Theme.space-md; width: root.w-key - Theme.space-md; text: cells[3].text; font-weight: Theme.weight-bold; color: cells[8].text == "0" ? Theme.text-dim : Colors.hsv(cells[8].text.to-float() * 30, Theme.key-sat, Theme.key-val); }
                    if root.w-genre > 0px: Cell { x: root.x-genre; width: root.w-genre - Theme.space-md; text: cells[2].text; color: Theme.row-dim; }
                    DragArea {
                        data: BrowserState.drag-track(i);
                        allow-copy: true;
                        changed dragging => { DragState.drag-changed(self.dragging, BrowserState.drag-track(i)); }
                        row-ta := TouchArea {
                            pointer-event(e) => {
                                if (e.kind != PointerEventKind.down) { return; }
                                root.focused();
                                fs.focus();
                                if (e.button == PointerEventButton.left) {
                                    root.choose(i);
                                    BrowserState.track-pressed(i);
                                } else if (e.button == PointerEventButton.right) {
                                    root.choose(i);
                                    root.place-menu(self.absolute-position.x - root.absolute-position.x + self.mouse-x, self.absolute-position.y - root.absolute-position.y + self.mouse-y);
                                    menu.show();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if BrowserState.tracks.length == 0: Text {
        y: Theme.h-header;
        height: parent.height - Theme.h-header;
        text: @tr("No tracks");
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.text-faint;
        font-family: Theme.font;
        font-size: Theme.font-size;
    }
    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 200px;
        height: 9 * Theme.h-row + 4px;
        Rectangle {
            background: Theme.panel-raised;
            border-width: 1px;
            border-color: Theme.line-strong;
            border-radius: Theme.studio-radius-ctl;
            VerticalLayout {
                padding: 1px;
                MenuItem { text: @tr("Load to deck 1"); activated => { DeckState.load(0); menu.close(); } }
                MenuItem { text: @tr("Load to deck 2"); activated => { DeckState.load(1); menu.close(); } }
                MenuItem { text: @tr("Edit track details…"); activated => { LibraryState.action("track-edit"); menu.close(); } }
                MenuItem { text: @tr("Add to Tag List (T)"); activated => { BrowserState.tag-add(); menu.close(); } }
                MenuItem { text: @tr("Add to playlist…"); activated => { BrowserState.panel-request(0); menu.close(); } }
                MenuItem { text: @tr("Tags…"); activated => { BrowserState.panel-request(1); menu.close(); } }
                MenuItem { text: BrowserState.related ? @tr("Hide related tracks") : @tr("Related tracks"); activated => { BrowserState.related-toggled(!BrowserState.related); menu.close(); } }
                MenuItem { text: @tr("Analyze track"); activated => { LibraryState.action("track-analyze"); menu.close(); } }
                MenuItem { text: @tr("Show in file manager"); activated => { LibraryState.action("track-show"); menu.close(); } }
            }
        }
    }
}
