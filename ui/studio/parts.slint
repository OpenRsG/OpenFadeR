import { Glyph, Icon, Tooltip } from "../widgets.slint";
import { Theme } from "../theme.slint";

/// PLAY, CUE and SYNC: a big rounded button with a `tone` outline that fills while `lit`. Momentary like a Chip: `pressed` and
/// `released` carry the pointer, `clicked` the click.
export component BigButton inherits Rectangle {
    in property <string> text;
    in property <Icon> icon;
    in property <color> tone: Theme.accent;
    in property <bool> lit;
    in property <bool> enabled: true;
    in property <string> tooltip;
    callback clicked;
    callback pressed;
    callback released;
    height: Theme.studio-button;
    min-width: 40px;
    accessible-role: button;
    accessible-label: root.tooltip != "" ? root.tooltip : root.text;
    accessible-action-default => { if root.enabled { root.pressed(); root.released(); root.clicked(); } }
    face := Rectangle {
        border-radius: Theme.studio-radius-ctl;
        border-width: 1.5px;
        border-color: root.enabled ? root.tone : root.tone.with-alpha(0.35);
        background: !root.enabled ? Theme.panel
            : root.lit ? (ta.pressed ? root.tone.darker(0.25) : ta.has-hover ? root.tone.brighter(0.15) : root.tone)
            : ta.pressed ? Theme.bg-deep : ta.has-hover ? Theme.panel-high : Theme.panel-raised;
        animate background { duration: Theme.t-fast; }
    }
    HorizontalLayout {
        alignment: center;
        spacing: Theme.space-md;
        if root.icon != Icon.none: Glyph {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            icon: root.icon;
            tint: !root.enabled ? Theme.text-disabled : root.lit ? Theme.bg-deep : root.tone;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: !root.enabled ? Theme.text-disabled : root.lit ? Theme.bg-deep : Theme.text-bright;
            font-family: Theme.font;
            font-size: Theme.font-md;
            font-weight: Theme.weight-bold;
        }
    }
    ta := TouchArea {
        property <bool> momentary-held;
        enabled: root.enabled;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                self.momentary-held = true;
                root.pressed();
            }
            if self.momentary-held && (e.kind == PointerEventKind.cancel || (e.button == PointerEventButton.left && e.kind == PointerEventKind.up)) {
                self.momentary-held = false;
                root.released();
            }
        }
    }
    if root.tooltip != "": Tooltip { width: root.width; height: root.height; text: root.tooltip; hovered: ta.has-hover && !ta.pressed; }
}

/// A row of tabs in one rounded track: the chosen one is filled in `accent` (HOT CUES / PAD FX / BEAT JUMP / SAMPLER, MIXER /
/// SETTINGS, Automix / Sidelist / Linked). A pure function of `current` (-1 = none lit); `chose` carries the clicked index.
export component PillTabs inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <length> font-size: Theme.font-sm;
    callback chose(int);
    height: Theme.h-ctl;
    background: Theme.bg-deep;
    border-radius: Theme.studio-radius-ctl;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            border-radius: Theme.studio-radius-ctl - 2px;
            background: i == root.current ? Theme.accent : ta.has-hover ? Theme.panel-raised : transparent;
            Text {
                text: o;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                color: i == root.current ? Theme.text-bright : Theme.text-dim;
                font-family: Theme.font;
                font-size: root.font-size;
                font-weight: Theme.weight-bold;
            }
            ta := TouchArea { clicked => { root.chose(i); } }
        }
    }
}

/// A dim bold caption (HIGH, LOOP, MASTER).
export component Caption inherits Text {
    color: Theme.text-dim;
    font-family: Theme.font;
    font-size: Theme.font-xs;
    font-weight: Theme.weight-bold;
    vertical-alignment: center;
    overflow: elide;
}
