import { Chip } from "../widgets.slint";
import { Theme } from "../theme.slint";
import { DeckState, DeckView } from "../deck-state.slint";
import { DeckOverview } from "../deck-wave.slint";
import { Jacket } from "../deck-header.slint";
import { DeckDropTarget } from "../dnd.slint";

/// The top of a studio deck panel: cover art, title, artist, BPM and the key with its ± shift, the big remaining time with the
/// track length under it, and the overview waveform across the bottom. Mirrored for the odd decks. `cover` is the cover's side;
/// the overview takes the height the panel has left.
export component StudioHead inherits Rectangle {
    in property <int> index;
    in property <length> cover;
    property <DeckView> v: DeckState.decks[root.index];
    property <bool> mirror: Math.mod(root.index, 2) == 1;
    property <length> pad: Theme.studio-gap;
    property <length> time-w: Theme.font-xxl * 5.6;
    property <length> col-w: root.width - 4 * root.pad - root.cover - root.time-w;
    property <length> row-h: min(Theme.h-ctl, 24px);
    /// The x of a block `w` wide that sits at `x` in the unmirrored panel.
    pure function px(x: length, w: length) -> length { return root.mirror ? root.width - x - w : x; }
    background: Theme.panel;
    border-radius: Theme.studio-radius;
    Rectangle {
        x: root.px(root.pad, root.cover);
        y: root.pad;
        width: root.cover;
        height: root.cover;
        border-radius: Theme.studio-radius-ctl;
        clip: true;
        Jacket { index: root.index; size: root.cover; }
    }
    VerticalLayout {
        x: root.px(2 * root.pad + root.cover, root.col-w);
        y: root.pad;
        width: root.col-w;
        height: root.cover;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.v.title != "" ? root.v.title : (root.v.loading ? @tr("loading…") : @tr("LOAD A TRACK"));
            color: root.v.title != "" ? Theme.text-bright : Theme.text-faint;
            font-family: Theme.font;
            font-size: Theme.deck-title;
            font-weight: Theme.weight-bold;
            horizontal-alignment: root.mirror ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            overflow: elide;
        }
        Text {
            text: root.v.title != "" ? root.v.artist : root.v.status;
            color: Theme.text-dim;
            font-family: Theme.font;
            font-size: Theme.deck-sub;
            horizontal-alignment: root.mirror ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            overflow: elide;
        }
        HorizontalLayout {
            height: root.row-h;
            alignment: root.mirror ? LayoutAlignment.end : LayoutAlignment.start;
            spacing: Theme.space-md;
            Text {
                text: root.v.bpm-text;
                color: root.v.synced ? Theme.accent-hi : Theme.text;
                font-family: Theme.font;
                font-size: Theme.font-md;
                font-weight: Theme.weight-bold;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            Chip { text: "−"; width: root.row-h; height: root.row-h; horizontal-stretch: 0; tooltip: @tr("Key down"); enabled: root.v.loaded; clicked => { DeckState.key-step(root.index, -1); } }
            Chip {
                text: root.v.key-eff == "" ? @tr("KEY") : root.v.key-eff;
                width: 42px;
                height: root.row-h;
                horizontal-stretch: 0;
                tooltip: @tr("Key: a click returns to the track's key");
                active: root.v.key-shifted;
                enabled: root.v.loaded;
                clicked => { DeckState.key-reset(root.index); }
            }
            Chip { text: "+"; width: root.row-h; height: root.row-h; horizontal-stretch: 0; tooltip: @tr("Key up"); enabled: root.v.loaded; clicked => { DeckState.key-step(root.index, 1); } }
            Text {
                text: root.v.key-shift != "" ? root.v.key-shift : "±0";
                color: root.v.key-shifted ? Theme.accent-hi : Theme.text-faint;
                font-family: Theme.font;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            Chip { text: @tr("MT"); width: 30px; height: root.row-h; horizontal-stretch: 0; font-size: Theme.font-xs; tooltip: @tr("Master tempo (key lock)"); active: root.v.key-lock; clicked => { DeckState.key-lock(root.index); } }
        }
    }
    VerticalLayout {
        x: root.px(3 * root.pad + root.cover + root.col-w, root.time-w);
        y: root.pad;
        width: root.time-w;
        height: root.cover;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.v.remain-text != "" ? root.v.remain-text : "--:--.-";
            color: root.v.ending ? Theme.danger : Theme.text-bright;
            font-family: Theme.font;
            font-size: Theme.font-xxl;
            font-weight: Theme.weight-bold;
            horizontal-alignment: root.mirror ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
        }
        Text {
            text: root.v.total-text != "" ? @tr("TOTAL {}", root.v.total-text) : "";
            color: Theme.text-dim;
            font-family: Theme.font;
            font-size: Theme.font-sm;
            horizontal-alignment: root.mirror ? TextHorizontalAlignment.left : TextHorizontalAlignment.right;
        }
    }
    Rectangle {
        x: root.pad;
        y: root.pad + root.cover + Theme.space-md;
        width: root.width - 2 * root.pad;
        height: root.height - self.y - root.pad;
        border-radius: Theme.studio-radius-ctl;
        clip: true;
        DeckOverview { index: root.index; }
    }
    DeckDropTarget { index: root.index; }
}
