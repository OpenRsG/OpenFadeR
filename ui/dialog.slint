import { Theme } from "theme.slint";
import { Icon, IconButton } from "widgets.slint";

/// Dialog frame: scrim over the window, a centred `panel` card with a 1 px `line-strong` border, a 28 px `bg` title
/// bar (12 px bold title, close button) and the body (`@children`, a VerticalLayout) under it. A click on the scrim or on the
/// close button reports `closed`; the owner hides the dialog. `card-height` 0 = as tall as the body wants, else fixed.
export component DialogFrame inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 680px;
    in property <length> card-height: 0px;
    in property <length> body-padding: Theme.space-xl;
    callback closed;
    background: Theme.scrim;
    TouchArea { clicked => { root.closed(); } }
    // Whole-pixel size and position: centred at a half pixel (an odd leftover, or a card sized in % of the window), every
    // line of text in the card is antialiased across two pixel columns and looks blurred.
    Rectangle {
        width: round(min(parent.width - 16px, root.card-width) / 1px) * 1px;
        height: round(min(parent.height - 16px, root.card-height > 0px ? root.card-height : Theme.h-bar + body.preferred-height + 2 * root.body-padding) / 1px) * 1px;
        x: floor((parent.width - self.width) / 2px) * 1px;
        y: floor((parent.height - self.height) / 2px) * 1px;
        background: Theme.panel;
        border-color: Theme.line-strong;
        border-width: 1px;
        border-radius: Theme.radius-lg;
        clip: true;
        TouchArea {}
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: Theme.h-bar;
            background: Theme.bg;
            Text {
                x: Theme.space-xl;
                text: root.title;
                vertical-alignment: center;
                color: Theme.text;
                font-family: Theme.font;
                font-size: Theme.font-md;
                font-weight: Theme.weight-bold;
            }
            IconButton {
                x: parent.width - self.width - Theme.space-sm;
                y: (parent.height - self.height) / 2;
                icon: Icon.close;
                tooltip: "Close";
                clicked => { root.closed(); }
            }
        }
        viewport := Flickable {
            x: 0;
            y: Theme.h-bar;
            width: parent.width;
            height: parent.height - Theme.h-bar;
            content-width: Theme.layout-profile == 1 ? max(self.width, root.card-width) : self.width;
            content-height: Theme.layout-profile == 1 ? max(self.height, body.preferred-height) : self.height;
            body := VerticalLayout {
                width: viewport.content-width;
                height: viewport.content-height;
                padding: root.body-padding;
                spacing: Theme.space-lg;
                @children
            }
        }
    }
}

/// A settings label beside its controls on desktop, above a scrollable control row in touch themes.
export component FormRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    property <bool> stacked: Theme.layout-profile == 1;
    height: Theme.h-ctl + Theme.space-xs + (root.stacked ? 24px : 0px);
    horizontal-stretch: 1;
    Text {
        x: 0px;
        y: 0px;
        text: root.label;
        width: root.stacked ? parent.width : 224px;
        height: root.stacked ? 24px : parent.height;
        vertical-alignment: center;
        color: Theme.text-dim;
        font-family: Theme.font;
        font-size: Theme.font-md;
        font-weight: Theme.weight-bold;
        overflow: elide;
    }
    viewport := Flickable {
        x: root.stacked ? 0px : 224px + Theme.space-sm;
        y: root.stacked ? 24px : 0px;
        width: max(0px, root.width - self.x);
        height: Theme.h-ctl + Theme.space-xs;
        content-width: root.stacked ? max(self.width, controls.preferred-width) : self.width;
        content-height: self.height;
        controls := HorizontalLayout {
            width: viewport.content-width;
            height: viewport.height;
            spacing: Theme.space-sm;
            @children
            Text {
                text: root.hint;
                min-width: 0px;
                preferred-width: 0px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                color: Theme.text-faint;
                font-family: Theme.font;
                font-size: Theme.font-sm;
                overflow: elide;
            }
        }
    }
}

/// Small dim explanatory paragraph under a form.
export component Note inherits Text {
    color: Theme.text-faint;
    font-family: Theme.font;
    font-size: Theme.font-sm;
    wrap: word-wrap;
}
