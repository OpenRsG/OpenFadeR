import { IconButton, Icon, MixFlag } from "widgets.slint";
import { Theme } from "theme.slint";
import { DeckState, DeckScroll } from "deck-state.slint";
import { MixPointState } from "mixpoint-state.slint";
import { ExportModeState } from "exportmode-state.slint";
import { DeckDropTarget } from "dnd.slint";

/// Waveform buffer shown 1:1: Rust renders it at this element's physical size, so nothing is
/// scaled; `pixelated` keeps a sub-pixel size mismatch (fractional scale factors) from smoothing.
export component WaveView inherits Image {
    callback resized(length, length);
    width: 100%;
    height: 100%;
    image-fit: contain;
    image-rendering: pixelated;
    init => { self.resized(self.width, self.height); }
    changed width => { self.resized(self.width, self.height); }
    changed height => { self.resized(self.width, self.height); }
}

/// The enlarged waveform of deck `index`: Rust's still picture (`DeckView.detail`, `DeckScroll.strip-w` wide) slid by
/// `strip-x` under the fixed playhead at the centre, with the slip ghost and the beat counter over it. Only `DeckScroll`
/// changes while a deck plays (src/app/deck/frame.rs), so a frame moves one image and redraws nothing else. Reports its
/// size like [`WaveView`]; Rust draws the picture at that height and three times that width.
export component WaveStrip inherits Rectangle {
    in property <int> index;
    callback resized(length, length);
    property <DeckScroll> s: DeckState.scroll[root.index];
    clip: true;
    init => { self.resized(self.width, self.height); }
    changed width => { self.resized(self.width, self.height); }
    changed height => { self.resized(self.width, self.height); }
    changed index => { self.resized(self.width, self.height); }
    Image {
        x: root.s.strip-x;
        y: 0;
        width: root.s.strip-w;
        height: root.height;
        source: DeckState.decks[root.index].detail;
        image-fit: fill;
        image-rendering: pixelated;
    }
    if root.s.slip-x >= 0: Rectangle { x: root.s.slip-x; width: 1px; background: Theme.slip-ghost; }
    // The playhead: 2 px, white, on the centre.
    Rectangle { x: root.width / 2 - 1px; width: 2px; background: Theme.wave-playhead; }
    if root.s.beat-text != "": Text {
        x: root.width / 2 + 6px;
        y: root.height - 12px;
        text: root.s.beat-text;
        color: Theme.accent;
        font-family: Theme.font;
        font-size: Theme.font-xs;
        font-weight: Theme.weight-bold;
    }
}

/// The 14×14 deck number badge: `panel-raised` square, bold digit in the deck's colour.
export component DeckBadge inherits Rectangle {
    in property <int> index;
    width: 14px;
    height: 14px;
    background: Theme.panel-raised;
    Text {
        text: root.index + 1;
        color: [Theme.deck1, Theme.deck2, Theme.deck3, Theme.deck4][root.index];
        font-size: Theme.font-sm;
        font-weight: Theme.weight-bold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// A MIX POINT LINK marker on the enlarged waveform: a 2 px line in `tone` with a small flag (OUT left of the line, IN right of it).
component MixMarker inherits Rectangle {
    in property <string> label;
    in property <color> tone;
    in property <bool> flag-left;
    width: 2px;
    background: root.tone;
    MixFlag {
        x: root.flag-left ? 2px - self.width : 0px;
        y: 0;
        label: root.label;
        tone: root.tone;
    }
}

/// Scrolling detail waveform of one deck, full width: number gutter left, expander gutter right that opens
/// the zoom column. Rust renders the image at the size of the middle part.
export component DeckDetail inherits Rectangle {
    in property <int> index;
    property <length> last-x;
    property <length> down-x;
    property <bool> scratching;
    property <bool> zoom-open;
    background: Theme.wave-bg;
    min-height: 30px;
    preferred-height: DeckState.count == 4 ? Theme.h-wave-4 : Theme.h-wave-2;
    // Left gutter: deck badge.
    Rectangle {
        x: 0;
        width: 24px;
        background: Theme.panel;
        DeckBadge { index: root.index; y: 4px; x: (parent.width - self.width) / 2; }
    }
    // Middle: the wave, with the phase meter (4 beats; the other deck's marker orange, this deck's green in time, blue off) under it.
    wave := VerticalLayout {
        x: 24px;
        width: root.width - 24px - 14px;
        WaveStrip {
            index: root.index;
            resized(w, h) => { DeckState.detail-resized(root.index, w, h); }
        }
        Rectangle {
            height: 4px;
            background: Theme.panel;
            for i in [1, 2, 3]: Rectangle { x: parent.width * i / 4; width: 1px; background: Theme.line-strong; }
            if DeckState.scroll[root.index].phase-show: Rectangle {
                x: parent.width * DeckState.scroll[root.index].phase-ref - self.width / 2;
                width: 3px;
                background: Theme.deck2;
            }
            if DeckState.scroll[root.index].phase-show: Rectangle {
                x: parent.width * DeckState.scroll[root.index].phase-own - self.width / 2;
                width: 3px;
                background: abs(DeckState.scroll[root.index].phase-off) < 0.1 ? Theme.play : Theme.accent-hi;
            }
        }
    }
    // MIX POINT LINK (panel open): the blue frame of the MIX OUT / MIX IN deck and its points; blue once they are linked.
    if MixPointState.active && (MixPointState.decks[root.index].sel-out || MixPointState.decks[root.index].sel-in): Rectangle {
        x: 24px;
        width: root.width - 24px - 14px;
        border-width: 2px;
        border-color: Theme.accent-hi;
    }
    if MixPointState.active && MixPointState.decks[root.index].out-set && MixPointState.decks[root.index].out-x >= 0 && MixPointState.decks[root.index].out-x <= 1: MixMarker {
        x: 24px + (root.width - 24px - 14px) * MixPointState.decks[root.index].out-x - 1px;
        height: root.height;
        label: @tr("OUT");
        flag-left: true;
        tone: MixPointState.decks[root.index].linked ? Theme.accent-hi : Theme.cue;
    }
    if MixPointState.active && MixPointState.decks[root.index].in-set && MixPointState.decks[root.index].in-x >= 0 && MixPointState.decks[root.index].in-x <= 1: MixMarker {
        x: 24px + (root.width - 24px - 14px) * MixPointState.decks[root.index].in-x - 1px;
        height: root.height;
        label: @tr("IN");
        tone: MixPointState.decks[root.index].linked ? Theme.accent-hi : Theme.cue;
    }
    if MixPointState.active && MixPointState.decks[root.index].silent-set && MixPointState.decks[root.index].silent-x >= 0 && MixPointState.decks[root.index].silent-x <= 1: MixMarker {
        x: 24px + (root.width - 24px - 14px) * MixPointState.decks[root.index].silent-x - 1px;
        y: root.height - 11px;
        height: 11px;
        label: @tr("SILENT");
        tone: Theme.danger;
    }
    // Drag = scratch: press holds the platter, the waveform follows the hand, release lets go. With VIEW > Click on the
    // waveform for PLAY and CUE on, a left click without a drag is PLAY / PAUSE and the right button is the CUE button.
    TouchArea {
        x: 24px;
        width: wave.width;
        mouse-cursor: crosshair;
        enabled: DeckState.decks[root.index].loaded;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    root.last-x = self.mouse-x;
                    root.down-x = self.mouse-x;
                    root.scratching = true;
                    DeckState.scratch-begin(root.index);
                }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    root.scratching = false;
                    DeckState.scratch-end(root.index);
                    if (e.kind == PointerEventKind.up && abs(self.mouse-x - root.down-x) < 4px) {
                        // With the MIX POINT LINK panel open a click picks the deck and its MIX POINT instead of PLAY / PAUSE.
                        if (MixPointState.active) { MixPointState.wave-click(root.index, self.mouse-x / self.width); }
                        else if (DeckState.click-wave) { DeckState.play-pause(root.index); }
                    }
                }
            }
            if (e.button == PointerEventButton.right && DeckState.click-wave) {
                if (e.kind == PointerEventKind.down) { DeckState.cue(root.index); }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) { DeckState.cue-released(root.index); }
            }
        }
        moved => {
            if (self.pressed && root.scratching) {
                DeckState.scratch-move(root.index, self.mouse-x - root.last-x);
                root.last-x = self.mouse-x;
            }
        }
    }
    // Zoom column (drawn after the scratch area, so it keeps its clicks): – readout + while open.
    if root.zoom-open: Rectangle {
        x: root.width - 14px - self.width;
        y: 2px;
        width: 86px;
        height: 20px;
        background: Theme.panel.with-alpha(0.85);
        border-radius: Theme.radius;
        HorizontalLayout {
            padding: 1px;
            spacing: 2px;
            IconButton { icon: Icon.minus; width: 20px; height: 18px; solid: true; tooltip: @tr("Zoom out"); clicked => { DeckState.zoom(root.index, -1); } }
            Text { text: DeckState.decks[root.index].zoom-text; color: Theme.text; font-size: Theme.font-size; vertical-alignment: center; horizontal-alignment: center; horizontal-stretch: 1; }
            IconButton { icon: Icon.plus; width: 20px; height: 18px; solid: true; tooltip: @tr("Zoom in"); clicked => { DeckState.zoom(root.index, 1); } }
        }
    }
    // Right gutter: the expander.
    Rectangle {
        x: root.width - 14px;
        width: 14px;
        background: ex.has-hover ? Theme.panel-high : Theme.panel;
        Text { text: root.zoom-open ? "›" : "‹"; color: Theme.text-dim; font-size: Theme.font-lg; horizontal-alignment: center; vertical-alignment: center; }
        ex := TouchArea { clicked => { root.zoom-open = !root.zoom-open; } }
    }
    DeckDropTarget { index: root.index; }
}

/// The overview waveform and its phrase strip (one image, Rust draws both) with the playhead; click to seek. It blinks
/// red in the last 30 s of a playing track.
export component DeckOverview inherits Rectangle {
    in property <int> index;
    property <bool> blink;
    property <bool> loaded: DeckState.decks[root.index].loaded;
    /// The deck's PHRASE EDIT row is open in EXPORT mode and the edit is allowed.
    property <bool> editing: ExportModeState.visible && DeckState.decks[root.index].grid-edit && ExportModeState.decks[root.index].phrase-panel && ExportModeState.decks[root.index].phrase-enabled;
    background: Theme.wave-bg;
    // `init` and the first layout pass run before Rust connects the callback, so report again once a track loads.
    changed loaded => { DeckState.overview-resized(root.index, self.width, self.height); }
    changed index => { DeckState.overview-resized(root.index, self.width, self.height); }
    WaveView {
        source: DeckState.decks[root.index].overview;
        resized(w, h) => { DeckState.overview-resized(root.index, w, h); }
    }
    Rectangle {
        background: Theme.danger;
        opacity: !DeckState.decks[root.index].ending ? 0 : (root.blink ? 0.5 : 0.12);
    }
    Timer {
        interval: 400ms;
        running: DeckState.decks[root.index].ending;
        triggered => { root.blink = !root.blink; }
    }
    // PHRASE EDIT (EXPORT mode GRID panel): dividers (white) and the selected phrase over the strip, and its clicks go to the phrase edit.
    if root.editing: Rectangle {
        y: root.height * 36 / 50;
        height: root.height * 14 / 50;
        for seg[i] in ExportModeState.decks[root.index].phrase-segs: Rectangle {
            x: root.width * seg.x0;
            width: root.width * (seg.x1 - seg.x0);
            border-width: seg.selected ? 2px : 0px;
            border-color: Colors.white;
            background: seg.selected ? Colors.white.with-alpha(0.25) : transparent;
            Rectangle { visible: i > 0; x: 0; width: 2px; background: Colors.white; }
        }
    }
    TouchArea {
        enabled: DeckState.decks[root.index].loaded;
        clicked => {
            if (!(root.editing && self.mouse-y >= root.height * 36 / 50)) { DeckState.seek(root.index, self.mouse-x / self.width); }
        }
        pointer-event(e) => {
            if (root.editing && e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down && self.mouse-y >= root.height * 36 / 50) {
                    ExportModeState.phrase-press(root.index, self.mouse-x / self.width, 5px / self.width);
                }
                if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                    ExportModeState.phrase-release(root.index, self.mouse-x / self.width);
                }
            }
        }
        moved => {
            if (root.editing && self.pressed) { ExportModeState.phrase-drag(root.index, self.mouse-x / self.width); }
        }
    }
}
