import { Theme } from "../theme.slint";
import { BrowserState } from "../browser-state.slint";
import { EditState } from "../edit.slint";
import { ExportModeState } from "../exportmode-state.slint";
import { LightingState } from "../lighting.slint";
import { VideoState } from "../video.slint";

/// What the Stage workspace's parts (bar, mixer, strip, library) share: the colour of a deck's controls, the mode switch, the clock Rust
/// writes (src/app/stage.rs) and what the window's keyboard / MIDI entry points (ui/app.slint) reach the library through: the panels are
/// built only while the workspace shows, so nothing outside can name them.
export global StageState {
    /// Wall-clock time of the top bar, "14:05".
    in property <string> clock;
    /// The folder tree has the keyboard focus (else the track list or the search box).
    in-out property <bool> tree-focus;
    /// Track rows the track list has room for.
    in-out property <int> rows: 6;
    /// `focus(target)` moves the keyboard focus: 0 search box, 1 folder tree, 2 track list. The library panel follows `focus-pulse`.
    in-out property <int> focus-target;
    in-out property <int> focus-pulse;
    public function focus(target: int) {
        root.focus-target = target;
        root.focus-pulse += 1;
    }
    /// Moves the track selection (the tree's row while the tree has the focus) by `d` rows, clamped, and tells Rust (the list scrolls to follow `BrowserState.current-row`).
    public function browse(d: int) {
        if root.tree-focus {
            if BrowserState.playlists.length > 0 {
                BrowserState.tree-row = max(0, min(BrowserState.playlists.length - 1, BrowserState.tree-row + d));
                BrowserState.playlist-selected(BrowserState.tree-row);
            }
            return;
        }
        if BrowserState.tracks.length == 0 { return; }
        BrowserState.current-row = max(0, min(BrowserState.tracks.length - 1, BrowserState.current-row + d));
        BrowserState.track-selected(BrowserState.current-row);
    }
    /// Sorts by `col` as a click on the column header does: the direction flips on the sorted column.
    public function sort-by(col: int) {
        BrowserState.sort-asc = BrowserState.sort-col == col ? !BrowserState.sort-asc : true;
        BrowserState.sort-col = col;
        BrowserState.sort(col, BrowserState.sort-asc);
    }
    /// The colour a deck's controls wear: its `deckN` colour when the theme tints (`deck-tint` 1), else the shared accent.
    public pure function tone(deck: int) -> color {
        return Theme.deck-tint == 1 ? [Theme.deck1, Theme.deck2, Theme.deck3, Theme.deck4][deck] : Theme.accent;
    }
    /// The same for a meter: transparent keeps the meter's own green / amber / red.
    public pure function meter-tone(deck: int) -> color {
        return Theme.deck-tint == 1 ? [Theme.deck1, Theme.deck2, Theme.deck3, Theme.deck4][deck] : transparent;
    }
    /// Mode selector: 0 EXPORT, 1 PERFORMANCE, 2 EDIT, 3 LIGHTING, 4 VIDEO (the window's own switch in app.slint).
    public function set-mode(n: int) {
        ExportModeState.visible = n == 0;
        EditState.visible = n == 2;
        LightingState.visible = n == 3;
        VideoState.visible = n == 4;
    }
}

/// What the window needs of the Stage workspace before it is built, and the sizes its parts share: the smallest window the tokens fit
/// in, the mixer's width and the room its rows need.
export global StageMetrics {
    out property <length> bar-h: max(Theme.h-bar, 36px);
    /// The enlarged waveforms of a window under 900 px high shrink to 3/4 of `stage-wave-h`.
    out property <length> wave-min: max(40px, Theme.stage-wave-h * 0.75);
    /// Height of the ruler row over a waveform (`wave-ruler` 1).
    out property <length> ruler-h: Theme.wave-ruler == 1 ? 14px : 0px;
    out property <length> deck-min: 300px;
    /// The strip of effects, colour FX and sampler under the decks.
    out property <length> strip-h: 124px;
    out property <length> lib-min: 170px;
    /// Knob rows of a channel: the smallest height of one, and what the fader, the headphone row, the header, the bus knobs, the crossfader
    /// and the paddings of a mixer panel need besides them (without its tabs).
    out property <length> row-min: 22px;
    out property <length> fader-min: 90px;
    out property <length> mixer-fixed: 143px + root.fader-min;
    out property <length> tabs-h: Theme.stage-tabs == 0 ? 0px : 27px;
    /// The mixer panel's height at its smallest.
    out property <length> mixer-min: root.mixer-fixed + root.tabs-h + 5 * root.row-min;
    /// The mixer is as wide as the theme says, or as its channels need: the decks give way.
    out property <length> mixer-w: max(Theme.stage-mixer-w, Theme.stage-mixer == 1 ? 330px : 230px);
    /// The centre waveforms never get thinner than this (a ruler row included).
    out property <length> col-wave-min: 40px;
    /// The row of decks (and strip) at least; with the centre waveforms the mixer under them needs its minimum too.
    out property <length> body-min: max(root.deck-min + (Theme.stage-strip == 1 ? root.strip-h + Theme.stage-gap : 0px), root.mixer-min + (Theme.stage-wave == 1 ? 2 * root.col-wave-min + 4px + Theme.stage-gap : 0px));
    out property <length> min-w: max(1100px, 2 * 380px + root.mixer-w + 4 * Theme.stage-gap);
    out property <length> min-h: max(720px, root.bar-h + Theme.stage-gap + (Theme.stage-wave == 0 ? 2 * root.wave-min + 4px + Theme.stage-gap : 0px) + root.body-min + Theme.stage-gap + root.lib-min + Theme.h-status);
}
