import { Icon, IconButton, Meter } from "../widgets.slint";
import { Theme } from "../theme.slint";
import { DeckState } from "../deck-state.slint";
import { DeviceState } from "../device-state.slint";
import { LightingState } from "../lighting.slint";
import { MidiState } from "../midi.slint";
import { MixerState } from "../mixer.slint";
import { PrefsState } from "../prefs-state.slint";
import { VideoState } from "../video.slint";
import { StageButton, StageTabs } from "controls.slint";
import { StageState } from "state.slint";

/// The Stage top bar: the logo, the modes of the app (EXPORT, PERFORMANCE, EDIT and the LIGHTING / VIDEO extensions when on), the
/// 2 DECKS / 4 DECKS chips (4 DECKS leaves for the desktop workspace, whose own bar brings you back), MIDI and DEVICES, the master
/// meter and tempo, REC, the clock and the gear that opens PREFERENCES.
export component StageBar inherits Rectangle {
    property <length> g: Theme.stage-gap;
    property <bool> wide: root.width >= 1240px;
    /// The app's mode numbers (0 EXPORT, 1 PERFORMANCE, 2 EDIT, 3 LIGHTING, 4 VIDEO) in the order of the tabs.
    property <[int]> modes: LightingState.enabled && VideoState.enabled ? [0, 1, 2, 3, 4] : LightingState.enabled ? [0, 1, 2, 3] : VideoState.enabled ? [0, 1, 2, 4] : [0, 1, 2];
    property <[string]> names: LightingState.enabled && VideoState.enabled ? [@tr("EXPORT"), @tr("PERFORMANCE"), @tr("EDIT"), @tr("LIGHTING"), @tr("VIDEO")]
        : LightingState.enabled ? [@tr("EXPORT"), @tr("PERFORMANCE"), @tr("EDIT"), @tr("LIGHTING")]
        : VideoState.enabled ? [@tr("EXPORT"), @tr("PERFORMANCE"), @tr("EDIT"), @tr("VIDEO")]
        : [@tr("EXPORT"), @tr("PERFORMANCE"), @tr("EDIT")];
    property <int> master: DeckState.master;
    background: Theme.bg;
    HorizontalLayout {
        padding-left: root.g;
        padding-right: root.g;
        padding-top: Theme.space-sm;
        padding-bottom: Theme.space-sm;
        spacing: Theme.space-lg;
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Theme.space-md;
            Image { source: @image-url("../../assets/icon.png"); width: root.height - 12px; height: self.width; y: 2px; horizontal-stretch: 0; image-fit: contain; }
            Text { text: "OpenFadeR"; vertical-alignment: center; color: Theme.text-bright; font-family: Theme.display-font; font-size: Theme.font-xl; font-weight: Theme.weight-display; }
        }
        StageTabs {
            width: root.names.length * 104px;
            horizontal-stretch: 0;
            tabs: root.names;
            current: 1;
            picked(i) => { StageState.set-mode(root.modes[i]); }
        }
        if root.wide: HorizontalLayout {
            horizontal-stretch: 0;
            spacing: Theme.space-sm;
            for label[i] in [@tr("2 DECKS"), @tr("4 DECKS")]: StageButton {
                width: 82px;
                text: label;
                active: i == 0;
                clicked => { if i == 1 { PrefsState.chose("decks", 1); } }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.wide: Text { text: @tr("MASTER"); horizontal-stretch: 0; vertical-alignment: center; color: Theme.text-dim; font-family: Theme.font; font-size: Theme.font-xs; font-weight: Theme.weight-bold; }
        Rectangle {
            width: 110px;
            horizontal-stretch: 0;
            Meter { y: (parent.height - self.height) / 2; width: parent.width; height: 8px; level: MixerState.bus.level; peak: MixerState.bus.peak; }
        }
        Text {
            width: 82px;
            horizontal-stretch: 0;
            text: root.master >= 0 && DeckState.decks[root.master].bpm > 0 ? DeckState.decks[root.master].bpm-text : "";
            vertical-alignment: center;
            horizontal-alignment: right;
            color: Theme.text-bright;
            font-family: Theme.display-font;
            font-size: Theme.font-md;
            font-weight: Theme.weight-display;
        }
        IconButton {
            icon: Icon.rec;
            solid: true;
            active: MixerState.bus.rec;
            active-color: Theme.rec;
            tooltip: @tr("REC (master out)");
            clicked => { MixerState.rec-toggled(); }
        }
        if MixerState.bus.rec: Text { text: MixerState.bus.rec-text; vertical-alignment: center; horizontal-stretch: 0; color: Theme.rec.brighter(0.4); font-family: Theme.font; font-size: Theme.font-md; font-weight: Theme.weight-bold; }
        StageButton { width: 48px; horizontal-stretch: 0; text: "MIDI"; active: MidiState.mapped > 0; tooltip: @tr("Controller mapping and MIDI learn"); clicked => { MidiState.captured = ""; MidiState.visible = true; } }
        StageButton { width: 78px; horizontal-stretch: 0; text: @tr("DEVICES"); active: DeviceState.busy; clicked => { DeviceState.visible = true; DeviceState.opened(); } }
        Text {
            text: StageState.clock;
            width: 52px;
            horizontal-stretch: 0;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: Theme.text;
            font-family: Theme.display-font;
            font-size: Theme.font-lg;
            font-weight: Theme.weight-display;
        }
        IconButton { icon: Icon.gear; icon-size: 18px; solid: true; tooltip: @tr("PREFERENCES"); clicked => { PrefsState.visible = true; } }
    }
}
