import { Theme } from "../theme.slint";
import { AutomixState, BrowserState } from "../browser-state.slint";
import { DeckDetail } from "../deck-wave.slint";
import { DeckScroll, DeckState } from "../deck-state.slint";
import { DeviceProgress } from "../device.slint";
import { DragTracker } from "../dnd.slint";
import { KeysState } from "../help.slint";
import { PrefsState } from "../prefs-state.slint";
import { StudioState } from "../studio-state.slint";
import { TrackInfoState } from "../trackinfo.slint";
import { Glyph, Icon } from "../widgets.slint";
import { StageBar } from "bar.slint";
import { StageDeck, StageDeckSize } from "deck.slint";
import { StageLibrary } from "library.slint";
import { StageMixer } from "mixer.slint";
import { StageColorSampler, StageEffects } from "strip.slint";
import { StageMetrics } from "state.slint";

/// The row of bar numbers over one waveform: Rust gives the number of the first labelled bar, the x of its line and the distance
/// between labels (`DeckScroll.ruler-*`, src/app/deck/ruler.rs); the row repeats one label at that distance, so a frame moves a few
/// numbers and nothing is drawn by Rust. Empty while the track has no beat grid.
component Ruler inherits Rectangle {
    in property <int> deck;
    property <DeckScroll> s: DeckState.scroll[root.deck];
    clip: true;
    background: Theme.bg-deep;
    for k in 48: Rectangle {
        property <int> bar: root.s.ruler-bar + k * root.s.ruler-step;
        x: root.s.ruler-x + k * root.s.ruler-w;
        width: 1px;
        visible: root.s.ruler-w > 0px && self.bar <= root.s.ruler-last && self.x < root.width;
        background: Theme.line-strong;
        Text {
            x: 3px;
            width: 44px;
            height: root.height;
            text: parent.bar;
            vertical-alignment: center;
            color: Theme.text-dim;
            font-family: Theme.font;
            font-size: Theme.font-sm;
            font-weight: Theme.weight-bold;
        }
    }
}

/// One enlarged waveform in a rounded frame (click / drag / zoom as everywhere: the desktop's `DeckDetail`), with, under
/// `Theme.wave-ruler`, the bar ruler over it.
component Wave inherits Rectangle {
    in property <int> deck;
    property <length> rh: StageMetrics.ruler-h;
    /// The picture's own left edge and right gutter in the deck's waveform (its number gutter left, the expander right).
    property <length> gl: 24px;
    property <length> gr: 14px;
    border-radius: Theme.stage-radius-ctl;
    clip: true;
    background: Theme.wave-bg;
    DeckDetail { y: root.rh; index: root.deck; width: parent.width; height: parent.height - root.rh; }
    Ruler { x: root.gl; y: 0px; width: parent.width - root.gl - root.gr; height: root.rh; deck: root.deck; visible: root.rh > 0px; }
}

/// The Stage presentation (`Theme.layout-profile` 3) of the PERFORMANCE mode with two decks: one window, laid out from the Stage tokens.
/// The top bar; the enlarged waveforms stacked across the top (`stage-wave` 0), in a column between the decks over the mixer (1) or
/// inside the decks (2); a deck panel per side round the mixer; the optional strip of effects, colour FX and sampler under the decks;
/// the library, its side bar and the status line. It drives the same globals as the desktop and studio workspaces, so switching
/// profiles keeps every setting and the playing decks. Every big part is its own permanent `if true` item tree (docs/code-structure.md).
export component StageWorkspace inherits Rectangle {
    property <length> g: Theme.stage-gap;
    /// Windows from 900 px high get the token sizes; shorter ones shrink the waveforms.
    property <bool> roomy: root.height >= 900px;
    /// The browse view (W): the library takes the window under the bar.
    property <bool> browse: BrowserState.browse-max;
    property <length> bar-h: StageMetrics.bar-h;
    property <length> status-h: Theme.h-status;
    property <length> wave-h: root.roomy ? Theme.stage-wave-h : StageMetrics.wave-min;
    property <bool> top-waves: Theme.stage-wave == 0;
    property <bool> col-waves: Theme.stage-wave == 1;
    property <bool> strip-on: Theme.stage-strip == 1;
    property <length> y-top: root.bar-h + root.g;
    property <length> y-deck: root.y-top + (root.top-waves ? 2 * root.wave-h + 4px + root.g : 0px);
    property <length> strip-part: root.strip-on ? StageMetrics.strip-h + root.g : 0px;
    /// What the row of decks (with the strip) wants: the decks' natural height, and the mixer's minimum under the centre waveforms.
    property <length> body-want: max(StageDeckSize.natural + root.strip-part, StageMetrics.mixer-min + (root.col-waves ? 2 * root.wave-h + 4px + root.g : 0px));
    /// The decks stop at their natural height and the library gets the rest; a short window takes it from the decks first, down to
    /// the least the window's minimum size left them.
    property <length> body-h: root.browse ? 0px : min(root.body-want, max(StageMetrics.body-min, root.height - root.status-h - root.y-deck - 2 * root.g - StageMetrics.lib-min));
    property <length> lib-h: root.browse ? root.height - root.y-top - root.status-h : root.height - root.status-h - root.y-deck - root.g - root.body-h;
    property <length> y-lib: root.height - root.status-h - root.lib-h;
    property <length> strip-h: root.strip-on ? StageMetrics.strip-h : 0px;
    property <length> deck-h: root.body-h - root.strip-part;
    property <length> mixer-w: StageMetrics.mixer-w;
    property <length> deck-w: (root.width - 4 * root.g - root.mixer-w) / 2;
    property <length> x-mixer: 2 * root.g + root.deck-w;
    property <length> x-right: 3 * root.g + root.deck-w + root.mixer-w;
    /// The centre column's waveforms leave the mixer its minimum (the faders keep their height before the waveforms do).
    property <length> col-wave-h: max(StageMetrics.col-wave-min, min(root.wave-h, (root.body-h - StageMetrics.mixer-min - 4px - root.g) / 2));
    property <length> y-mixer: root.y-deck + (root.col-waves ? 2 * root.col-wave-h + 4px + root.g : 0px);
    background: Theme.bg;
    DragTracker { x: 0px; y: 0px; width: root.width; height: root.height; }
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            // Arrows reach here only when neither the search box nor the track list has focus.
            if (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                StudioState.browse(e.text == Key.DownArrow ? 1 : -1);
                return accept;
            }
            // Held keys repeat; a shortcut fires once per press.
            if (!e.repeat && KeysState.key(e.text, e.modifiers.shift, e.modifiers.control)) { accept } else { reject }
        }
        key-released(e) => {
            if (KeysState.key-released(e.text, e.modifiers.shift, e.modifiers.control)) { accept } else { reject }
        }
        if true: StageBar { x: 0px; y: 0px; width: root.width; height: root.bar-h; }
        for i in root.browse || !root.top-waves ? 0 : 2: Wave {
            x: root.g;
            y: root.y-top + i * (root.wave-h + 4px);
            width: root.width - 2 * root.g;
            height: root.wave-h;
            deck: DeckState.slots[PrefsState.wave-order[i]];
        }
        for i in root.browse || !root.col-waves ? 0 : 2: Wave {
            x: root.x-mixer;
            y: root.y-deck + i * (root.col-wave-h + 4px);
            width: root.mixer-w;
            height: root.col-wave-h;
            deck: DeckState.slots[PrefsState.wave-order[i]];
        }
        if !root.browse: StageDeck { slot: 0; x: root.g; y: root.y-deck; width: root.deck-w; height: root.deck-h; }
        if !root.browse: StageMixer { x: root.x-mixer; y: root.y-mixer; width: root.mixer-w; height: root.y-deck + root.body-h - root.y-mixer; }
        if !root.browse: StageDeck { slot: 1; mirrored: true; x: root.x-right; y: root.y-deck; width: root.deck-w; height: root.deck-h; }
        if !root.browse && root.strip-on: StageEffects { x: root.g; y: root.y-deck + root.deck-h + root.g; width: root.deck-w; height: root.strip-h; }
        if !root.browse && root.strip-on: StageColorSampler { x: root.x-right; y: root.y-deck + root.deck-h + root.g; width: root.deck-w; height: root.strip-h; }
        if true: StageLibrary { x: root.g; y: root.y-lib; width: root.width - 2 * root.g; height: root.lib-h; }
        // Status line: a device loading, a track being analysed, a device job; the browser's own messages are over the track list.
        Rectangle {
            x: 0px;
            y: root.height - root.status-h;
            width: root.width;
            height: root.status-h;
            background: Theme.bg-deep;
            Text { x: root.g; width: 70px; height: parent.height; text: "OpenFadeR"; vertical-alignment: center; color: Theme.text-dim; font-size: Theme.font-size; font-weight: Theme.weight-bold; }
            if BrowserState.load-progress >= 0: Rectangle {
                x: 90px;
                y: (parent.height - self.height) / 2;
                width: 160px;
                height: 10px;
                background: Theme.panel-raised;
                border-radius: self.height / 2;
                Rectangle { width: parent.width * BrowserState.load-progress; background: Theme.accent; border-radius: parent.border-radius; }
            }
            Text {
                x: BrowserState.load-progress >= 0 ? 260px : 90px;
                width: parent.width - self.x - prog.width - 120px;
                height: parent.height;
                text: BrowserState.load-progress >= 0 ? BrowserState.load-text : AutomixState.running ? AutomixState.status : "";
                vertical-alignment: center;
                overflow: elide;
                color: Theme.text-bright;
                font-size: Theme.font-size;
            }
            if TrackInfoState.progress != "": Glyph { x: parent.width - prog.width - 28px - root.g; y: (parent.height - self.height) / 2; width: 14px; height: 14px; icon: Icon.info; tint: Theme.accent; }
            prog := Text { x: parent.width - self.width - root.g; height: parent.height; text: TrackInfoState.progress; vertical-alignment: center; color: Theme.accent; font-size: Theme.font-size; }
            DeviceProgress { x: parent.width - self.width - prog.width - 60px; y: (parent.height - self.height) / 2; }
        }
    }
}
