import { Chip, Dropdown, Fader, Knob } from "widgets.slint";
import { Theme } from "theme.slint";
import { DeckState } from "deck.slint";
import { MixerState } from "mixer.slint";
import { FxDivider, FxLabel, FxRack } from "fxrack.slint";

/// Two Beat FX units, FX1 and FX2 (src/app/fx/, audio in src/audio/fx/), each with three effect slots (MULTI mode:
/// FX1-1 … FX1-3). Rust owns every value here; the callbacks carry the user's request and Rust writes the result back. Every
/// callback names its unit (0, 1) and, where it matters, the slot (0..2).
export struct FxSlot {
    /// Index into `FxState.effects`.
    effect: int,
    /// Position in the beat-fraction list 1/16 … 32, and its label.
    beat: int,
    beat-text: string,
    /// LEVEL / DEPTH knob, 0..1.
    level: float,
    on: bool,
}

export struct FxUnit {
    /// The three slots, FX1-1 … FX1-3.
    slots: [FxSlot],
    /// The BEAT target: the slot the BEAT ◁ / ▷ buttons step and the controller's beat display shows (FX SELECT on a controller).
    target: int,
    /// 0..3 = CH A..D, 4 = MASTER.
    assign: int,
    /// Tempo the unit follows, "128.00 BPM"; `no-bpm` when no deck gave one and 120 is the fallback;
    /// `tapped` when TAP set the tempo (AUTO goes back to the master deck's).
    bpm-text: string,
    no-bpm: bool,
    tapped: bool,
    /// RELEASE is held.
    releasing: bool,
    /// MERGE FX side of this row (MFX1 on row 0 = deck A, MFX2 on row 1 = deck B): preset index and its name
    /// (src/audio/merge/), build-up knob and noise (SAMPLE) volume 0..1, and whether it is held ON.
    merge-preset: int,
    merge-name: string,
    merge-knob: float,
    merge-volume: float,
    merge-on: bool,
    /// FX PART SELECT (needs STEMS and a channel assignment): 0 = ALL (the whole channel), 1 VOCAL, 2 INST, 3 BASS, 4 DRUMS; the effect runs on that stem only.
    part: int,
}

export global FxState {
    /// Panel shown (the global bar's FX toggle).
    in-out property <bool> open;
    out property <length> panel-h: Theme.layout-profile == 1 ? 7 * Theme.touch-target + 46px : 110px;
    in-out property <[FxUnit]> units;
    /// Beat FX selector labels: the nine built-ins, then the effects of the plugin libraries (set from Rust at start).
    in-out property <[string]> effects;
    /// The unit the panel and the keyboard shortcuts edit.
    in-out property <int> unit;
    /// Panel tab: 0 BEAT FX, 1 RELEASE FX, 2 MERGE FX, 3 SEND FX, 4 LEVER FX, 5 MIC FX (the last three show `FxRack`). Rust opens 0 to 2 with VIEW > Effect Panel; the tab chips switch it.
    in-out property <int> view;
    /// CONTROLLER > Effect > Enable MERGE FX: off greys the MERGE FX controls (Rust refuses their callbacks too).
    in-out property <bool> merge-enabled: true;
    /// EXTENSIONS > STEMS: the STEM FX (FX PART SELECT) chip is shown.
    in-out property <bool> stem-fx: true;
    /// (unit, slot, effect index).
    callback effect-selected(int, int, int);
    /// (unit, ±1) steps the beat fraction of the unit's BEAT target slot (the ←/→ keys too).
    callback beat-step(int, int);
    /// (unit, slot) makes the slot the BEAT target.
    callback target-selected(int, int);
    /// (unit, slot, 0..1).
    callback level-edited(int, int, float);
    /// (unit, slot) switches the slot ON / OFF; (unit, slot, held) a momentary ON button: on while held.
    callback toggled(int, int);
    callback held(int, int, bool);
    callback assign-selected(int, int);
    /// Tap the beat: the series' tempo overrides the master deck's for this unit.
    callback tapped(int);
    /// Back to the master deck's tempo.
    callback auto-beat(int);
    /// (unit, held) momentary echo-out: held = ECHO at full level on, released = the feed stops and the tail rings out.
    callback release(int, bool);
    /// MERGE FX, every callback names its side (0 = MFX1 / deck A, 1 = MFX2 / deck B): (side, held) the build-up runs while held,
    /// (side) instant off, (side, ±1) next / previous preset (wraps), (side, 0..1) build-up knob, (side, 0..1) noise volume.
    callback merge-on(int, bool);
    callback merge-abort(int);
    callback merge-preset(int, int);
    callback merge-knob(int, float);
    callback merge-volume(int, float);
    /// (unit) the next part (ALL → VOCAL → INST → BASS → DRUMS), (unit, part) a controller's part button: selects it, again = ALL.
    callback part-step(int);
    callback part-selected(int, int);
}

/// One effect slot of a unit: ON (the slot number), effect, beat (lit = the BEAT target; a click makes it the target) and LEVEL / DEPTH.
component FxSlotView inherits HorizontalLayout {
    in property <int> unit;
    in property <int> i;
    in property <FxSlot> s;
    in property <bool> target;
    in property <length> ctl-h;
    property <bool> touch: Theme.layout-profile == 1;
    spacing: root.touch ? 6px : 3px;
    Chip { text: "" + (root.i + 1); font-size: Theme.font-xs; min-width: root.ctl-h; max-width: root.ctl-h; horizontal-stretch: 0; height: root.ctl-h; active: root.s.on; active-color: Theme.play; tooltip: @tr("FX{}-{} ON", root.unit + 1, root.i + 1); clicked => { FxState.toggled(root.unit, root.i); } }
    Dropdown {
        options: FxState.effects;
        current: root.s.effect;
        font-size: Theme.font-xs;
        min-width: root.touch ? 80px : 56px;
        list-width: root.touch ? 6 * root.ctl-h : 0px;
        height: root.ctl-h;
        chose(e) => { FxState.effect-selected(root.unit, root.i, e); }
    }
    Chip { text: root.s.beat-text; font-size: Theme.font-xs; min-width: root.touch ? root.ctl-h : 32px; max-width: root.touch ? root.ctl-h : 32px; horizontal-stretch: 0; height: root.ctl-h; active: root.target; tooltip: @tr("Beat (lit: BEAT ◀ ▶ step this slot)"); clicked => { FxState.target-selected(root.unit, root.i); } }
    Knob { width: root.ctl-h; height: root.ctl-h; value: root.s.level; edited(v) => { FxState.level-edited(root.unit, root.i, v); } }
}

/// One Beat FX unit, two rows split into labelled groups: the unit chip, its three slots (MULTI mode)
/// and the tempo; then BEAT ◀ ▶ (the target slot), TAP / AUTO / REL, the channel targets with FX PART, and the unit's
/// MERGE FX side (preset, build-up, GO).
component Unit inherits Rectangle {
    in property <int> n;
    property <FxUnit> u: FxState.units[root.n];
    property <bool> touch: Theme.layout-profile == 1;
    property <length> ctl-h: root.touch ? Theme.touch-target : 20px;
    property <length> button-w: root.touch ? Theme.touch-target : 32px;
    background: Theme.panel;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Chip { text: @tr("FX{}", root.n + 1); font-size: Theme.font-xs; min-width: root.touch ? root.ctl-h : 36px; max-width: root.touch ? root.ctl-h : 36px; height: root.touch ? 2 * root.ctl-h + 8px : 46px; active: FxState.unit == root.n; tooltip: @tr("Unit the keyboard edits"); clicked => { FxState.unit = root.n; } }
        }
        VerticalLayout {
            alignment: center;
            spacing: root.touch ? 8px : 6px;
            if FxState.view == 0: HorizontalLayout {
                height: root.ctl-h;
                spacing: 10px;
                for s[i] in u.slots: HorizontalLayout {
                    spacing: 10px;
                    if i > 0: FxDivider { }
                    FxSlotView { unit: root.n; i: i; s: s; ctl-h: root.ctl-h; target: u.target == i; }
                }
                FxDivider { }
                // Tempo the unit follows; ~ = no deck gave one (120 fallback), blue = tapped. Never elided.
                Text {
                    text: u.no-bpm ? "~" + u.bpm-text : u.bpm-text;
                    color: u.tapped ? Theme.accent-hi : u.no-bpm ? Theme.cue : Theme.text-bright;
                    font-family: Theme.font;
                    font-size: Theme.font-size;
                    font-weight: Theme.weight-bold;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    min-width: self.preferred-width;
                    horizontal-stretch: 0;
                }
            }
            if FxState.view == 1: HorizontalLayout {
                height: root.ctl-h;
                spacing: 10px;
                Chip {
                    text: @tr("HOLD: RELEASE FX");
                    font-size: Theme.font-xs;
                    min-width: 80px;
                    height: root.ctl-h;
                    active: u.releasing;
                    active-color: Theme.play;
                    tooltip: @tr("Hold: echo-out");
                    pressed => { FxState.release(root.n, true); }
                    released => { FxState.release(root.n, false); }
                }
                Text { text: u.no-bpm ? "~" + u.bpm-text : u.bpm-text; color: Theme.text-bright; font-family: Theme.font; font-size: Theme.font-size; font-weight: Theme.weight-bold; vertical-alignment: center; horizontal-alignment: right; min-width: self.preferred-width; horizontal-stretch: 0; }
            }
            if FxState.view == 2: HorizontalLayout {
                height: root.ctl-h;
                spacing: 4px;
                FxLabel { text: @tr("PRESET"); }
                Chip { text: @tr("M{} {}", root.n + 1, u.merge-name); font-size: Theme.font-xs; min-width: 80px; horizontal-stretch: 0; height: root.ctl-h; enabled: FxState.merge-enabled; tooltip: @tr("MERGE FX preset (click: next)"); clicked => { FxState.merge-preset(root.n, 1); } }
                Rectangle { width: 6px; }
                FxLabel { text: @tr("BUILD-UP"); }
                Fader { min-width: root.touch ? 3 * root.ctl-h : 60px; height: root.ctl-h; opacity: FxState.merge-enabled ? 1 : 0.4; value: u.merge-knob; edited(v) => { FxState.merge-knob(root.n, v); } }
                Chip {
                    text: @tr("GO");
                    font-size: Theme.font-xs;
                    min-width: root.button-w;
                    horizontal-stretch: 0;
                    height: root.ctl-h;
                    enabled: FxState.merge-enabled;
                    active: u.merge-on;
                    active-color: Theme.play;
                    tooltip: @tr("Hold: MERGE FX build-up");
                    pressed => { FxState.merge-on(root.n, true); }
                    released => { FxState.merge-on(root.n, false); }
                }
                Chip { text: @tr("ABORT"); font-size: Theme.font-xs; min-width: 48px; horizontal-stretch: 0; height: root.ctl-h; enabled: FxState.merge-enabled; tooltip: @tr("Stop the effect at once"); clicked => { FxState.merge-abort(root.n); } }
            }
            if FxState.view == 2: HorizontalLayout {
                height: root.ctl-h;
                spacing: 4px;
                FxLabel { text: @tr("SAMPLE"); }
                Fader { min-width: root.touch ? 3 * root.ctl-h : 60px; height: root.ctl-h; detent: true; opacity: FxState.merge-enabled ? 1 : 0.4; value: u.merge-volume; edited(v) => { FxState.merge-volume(root.n, v); } }
            }
            if FxState.view != 2: HorizontalLayout {
                height: root.ctl-h;
                spacing: root.touch ? 6px : 10px;
                if FxState.view == 0: HorizontalLayout {
                    spacing: 3px;
                    horizontal-stretch: 0;
                    FxLabel { text: @tr("BEAT"); }
                    Rectangle { width: 2px; }
                    Chip { text: "◀"; font-size: Theme.font-xs; min-width: root.ctl-h; max-width: root.ctl-h; horizontal-stretch: 0; height: root.ctl-h; tooltip: @tr("BEAT down (the lit slot)"); clicked => { FxState.beat-step(root.n, -1); } }
                    Chip { text: "▶"; font-size: Theme.font-xs; min-width: root.ctl-h; max-width: root.ctl-h; horizontal-stretch: 0; height: root.ctl-h; tooltip: @tr("BEAT up (the lit slot)"); clicked => { FxState.beat-step(root.n, 1); } }
                }
                if FxState.view == 0: FxDivider { }
                if FxState.view == 0: HorizontalLayout {
                    spacing: 3px;
                    horizontal-stretch: 0;
                    FxLabel { text: @tr("TEMPO"); }
                    Rectangle { width: 2px; }
                    Chip { text: @tr("TAP"); font-size: Theme.font-xs; min-width: root.button-w; horizontal-stretch: 0; height: root.ctl-h; tooltip: @tr("Tap the tempo"); clicked => { FxState.tapped(root.n); } }
                    Chip { text: @tr("AUTO"); font-size: Theme.font-xs; min-width: root.touch ? root.ctl-h : 38px; horizontal-stretch: 0; height: root.ctl-h; active: !u.tapped; tooltip: @tr("Follow the master deck's tempo"); clicked => { FxState.auto-beat(root.n); } }
                    Chip {
                        text: @tr("REL");
                        font-size: Theme.font-xs;
                        min-width: root.button-w;
                        horizontal-stretch: 0;
                        height: root.ctl-h;
                        active: u.releasing;
                        tooltip: @tr("Hold: RELEASE FX (echo-out)");
                        pressed => { FxState.release(root.n, true); }
                        released => { FxState.release(root.n, false); }
                    }
                }
                if FxState.view == 0: FxDivider { }
                HorizontalLayout {
                    spacing: 3px;
                    horizontal-stretch: 0;
                    FxLabel { text: @tr("CH"); }
                    Rectangle { width: 2px; }
                    for name[i] in DeckState.count == 4 ? ["1", "2", "3", "4", "M"] : ["1", "2", "M"]: Chip {
                        text: name;
                        font-size: Theme.font-xs;
                        min-width: root.touch ? root.ctl-h : 22px;
                        max-width: root.touch ? root.ctl-h : 22px;
                        horizontal-stretch: 0;
                        height: root.ctl-h;
                        tooltip: name == "M" ? @tr("Apply to the master") : @tr("Apply to channel {}", name);
                        active: u.assign == (name == "M" ? 4 : i);
                        clicked => { FxState.assign-selected(root.n, name == "M" ? 4 : i); }
                    }
                    if DeckState.decks[0].stems && FxState.stem-fx: Chip {
                        text: [@tr("ALL"), @tr("VOCAL"), @tr("INST"), @tr("BASS"), @tr("DRUMS")][u.part];
                        font-size: Theme.font-xs;
                        min-width: 44px;
                        horizontal-stretch: 0;
                        height: root.ctl-h;
                        enabled: u.assign != 4;
                        active: u.part != 0 && u.assign != 4;
                        active-color: Theme.stem-vocal;
                        tooltip: @tr("FX PART: the stem the effect runs on");
                        clicked => { FxState.part-step(root.n); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if FxState.view == 0: FxDivider { }
                if FxState.view == 0: HorizontalLayout {
                    spacing: 3px;
                    horizontal-stretch: 0;
                    FxLabel { text: @tr("MERGE"); }
                    Rectangle { width: 2px; }
                    Chip {
                        text: @tr("M{} {}", root.n + 1, u.merge-name);
                        font-size: Theme.font-xs;
                        min-width: 64px;
                        horizontal-stretch: 0;
                        height: root.ctl-h;
                        enabled: FxState.merge-enabled;
                        tooltip: @tr("MERGE FX preset (click: next)");
                        clicked => { FxState.merge-preset(root.n, 1); }
                    }
                    Fader { min-width: root.touch ? root.ctl-h : 40px; max-width: 80px; height: root.ctl-h; opacity: FxState.merge-enabled ? 1 : 0.4; value: u.merge-knob; edited(v) => { FxState.merge-knob(root.n, v); } }
                    Chip {
                        text: @tr("GO");
                        font-size: Theme.font-xs;
                        min-width: root.touch ? root.ctl-h : 30px;
                        horizontal-stretch: 0;
                        height: root.ctl-h;
                        enabled: FxState.merge-enabled;
                        active: u.merge-on;
                        active-color: Theme.play;
                        tooltip: @tr("Hold: MERGE FX build-up");
                        pressed => { FxState.merge-on(root.n, true); }
                        released => { FxState.merge-on(root.n, false); }
                    }
                }
            }
        }
    }
}

/// FX panel, top to bottom: the effect-family tabs (they switch the area under them), FX1 | FX2 side by side (or the
/// SEND / LEVER / MIC rack), and the COLOR FX controls. Touch stacks the units and separates COLOR type selection from its channel knobs.
export component FxPanel inherits Rectangle {
    property <bool> touch: Theme.layout-profile == 1;
    property <length> ctl-h: root.touch ? Theme.touch-target : 20px;
    background: Theme.bg;
    VerticalLayout {
        spacing: 2px;
        Rectangle {
            height: root.touch ? root.ctl-h + 12px : 26px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                padding-top: root.touch ? 6px : 3px;
                padding-bottom: root.touch ? 6px : 3px;
                spacing: root.touch ? 6px : 2px;
                alignment: start;
                for name[i] in [@tr("BEAT FX"), @tr("RELEASE FX"), @tr("MERGE FX"), @tr("SEND FX"), @tr("LEVER FX"), @tr("MIC FX")]: Chip {
                    text: name;
                    font-size: Theme.font-xs;
                    height: root.ctl-h;
                    min-width: self.fit-width + 16px;
                    horizontal-stretch: 0;
                    active: FxState.view == i;
                    clicked => { FxState.view = i; }
                }
            }
        }
        Rectangle {
            height: root.touch ? 4 * root.ctl-h + 20px : 54px;
            if !root.touch: HorizontalLayout {
                spacing: 2px;
                if FxState.view < 3: Unit { n: 0; }
                if FxState.view < 3: Unit { n: 1; }
                if FxState.view >= 3: FxRack { rack: FxState.view - 3; }
            }
            if root.touch: VerticalLayout {
                spacing: 4px;
                if FxState.view < 3: Unit { n: 0; }
                if FxState.view < 3: Unit { n: 1; }
                if FxState.view >= 3: FxRack { rack: FxState.view - 3; }
            }
        }
        Rectangle {
            height: root.touch ? 2 * root.ctl-h + 10px : 26px;
            background: Theme.panel;
            if !root.touch: HorizontalLayout {
                padding-left: 6px;
                padding-right: 8px;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: 2px;
                FxLabel { text: @tr("COLOR FX"); }
                Rectangle { width: 6px; horizontal-stretch: 0; }
                for name[i] in MixerState.cfx-names: Chip {
                    text: name;
                    font-size: Theme.font-xs;
                    height: 20px;
                    min-width: 0px;
                    horizontal-stretch: name.character-count;
                    active: MixerState.cfx-type == i;
                    active-color: Theme.cue;
                    clicked => { MixerState.cfx-selected(i); }
                }
                Rectangle { width: 8px; horizontal-stretch: 0; }
                for n in DeckState.count: HorizontalLayout {
                    spacing: 3px;
                    padding-left: 4px;
                    horizontal-stretch: 0;
                    FxLabel { text: "" + (n + 1); }
                    Knob {
                        width: 20px;
                        height: 20px;
                        detent: true;
                        arc-color: Theme.cue;
                        stop: MixerState.cfx-stop;
                        value: MixerState.channels[n].knobs[4];
                        edited(v) => { MixerState.knob(n, 4, v); }
                    }
                }
            }
            if root.touch: VerticalLayout {
                padding: 4px;
                spacing: 2px;
                HorizontalLayout {
                    height: root.ctl-h;
                    spacing: 8px;
                    FxLabel { text: @tr("COLOR FX"); }
                    Flickable {
                        content-width: max(self.width, color-types.preferred-width);
                        content-height: self.height;
                        color-types := HorizontalLayout {
                            width: parent.content-width;
                            height: root.ctl-h;
                            spacing: 6px;
                            for name[i] in MixerState.cfx-names: Chip {
                                text: name;
                                tooltip: name;
                                font-size: Theme.font-xs;
                                height: root.ctl-h;
                                min-width: max(root.ctl-h, self.fit-width + 12px);
                                active: MixerState.cfx-type == i;
                                active-color: Theme.cue;
                                clicked => { MixerState.cfx-selected(i); }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: root.ctl-h;
                    spacing: 12px;
                    alignment: start;
                    for n in DeckState.count: HorizontalLayout {
                        spacing: 6px;
                        horizontal-stretch: 0;
                        FxLabel { text: @tr("CH {}", n + 1); }
                        Knob {
                            width: root.ctl-h;
                            height: root.ctl-h;
                            detent: true;
                            arc-color: Theme.cue;
                            stop: MixerState.cfx-stop;
                            value: MixerState.channels[n].knobs[4];
                            edited(v) => { MixerState.knob(n, 4, v); }
                        }
                    }
                }
            }
        }
    }
}
