/// Design tokens. The defaults are Catppuccin Mocha (dark base) and Catppuccin Latte (light base). Sections use these names and
/// never a literal colour, size or font.
/// Every `in-out` property is a skin token: src/app/skin/ sets each one from the chosen skin file (docs/skins.md), so the values
/// below are the built-in defaults and a new token needs no Rust edit (ui/build.rs lists them). `in` properties are pref-driven.
/// A `// @group <name>` comment starts a group of the theme editor (PREFS > THEMES): every token after it, up to the next marker,
/// is listed there under that name, with its `///` doc comment as the hint. Keep the groups contiguous.
/// The line `// @values a | b | c` before an int token names its options (the editor's choices; a theme file may write the name or its
/// number, and `check` in src/app/skin/file.rs refuses others); `// @range lo..hi` bounds a float. A token whose default is `root.other`
/// follows that token. This file is the one source of the editor, the validation and docs/skins.md's tables.
export global Theme {
    // Skin (VIEW > Color > Skin, set from Rust): false = Catppuccin Mocha, true = Catppuccin Latte.
    in property <bool> light: false;
    /// Hover tooltips on / off (VIEW > Tooltips).
    in property <bool> tooltips: true;
    /// Decimal places in BPM readouts (VIEW > TEMPO DECIMAL PLACES), independent of the skin.
    in property <int> tempo-decimals: 2;
    /// Where the deck number sits in its box on the waveforms (VIEW > DECK NUMBER): 0 = at the top left, 1 = centred.
    in property <int> deck-number: 1;

    // @group Surfaces
    // Surfaces
    /// Window and the 1-2 px gaps between panels.
    in-out property <color> bg: root.light ? #dce0e8 : #11111b;
    /// Waveform, track list and status bar background.
    in-out property <color> bg-deep: root.light ? #eff1f5 : #181825;
    /// Panel body (deck panel, mixer, browser toolbar, tree).
    in-out property <color> panel: root.light ? #e6e9ef : #1e1e2e;
    /// Idle button / pad / input fill.
    in-out property <color> panel-raised: root.light ? #ccd0da : #313244;
    /// Hovered button, fader groove, thumb-less borders.
    in-out property <color> panel-high: root.light ? #bcc0cc : #45475a;
    /// The deck panels' body (the header, overview, pads and jog sit on it).
    in-out property <color> deck-bg: root.light ? #e6e9ef : #1e1e2e;
    /// Odd track-list row (even rows are `bg-deep`).
    in-out property <color> row-alt: root.light ? #eaecf1 : #1b1b2a;
    /// Column header strip of the track list.
    in-out property <color> list-head: root.light ? #ccd0da : #313244;
    /// Hairline between panels / table cells.
    in-out property <color> line: root.light ? #ccd0da : #313244;
    /// Checkbox / radio / input border.
    in-out property <color> line-strong: root.light ? #9ca0b0 : #585b70;
    /// Selected track-list row and tree entry.
    in-out property <color> select: root.light ? #b0c7f5 : #425173;
    /// Row under the pointer.
    in-out property <color> hover-row: root.light ? #d6e0f5 : #282e43;
    /// Dim overlay behind dialogs.
    in-out property <color> scrim: root.light ? #dce0e8b0 : #11111bb0;
    /// Fader cap face.
    in-out property <color> fader-cap: root.light ? #8c8fa1 : #a6adc8;
    /// Outline of a deck panel (see `deck-frame-w`; transparent = none). A themed accent colour draws one around each deck.
    in-out property <color> deck-frame: #00000000;
    // Learn overlay and toast: fixed dark in both skins, so they use their own text colours.
    /// Dim overlay behind the MIDI learn screen.
    in-out property <color> overlay-scrim: root.light ? #dce0e8cc : #11111bcc;
    /// Card of the MIDI learn overlay.
    in-out property <color> overlay-bg: root.light ? #1c1c1c : #181825;
    /// Border of the learn overlay's card.
    in-out property <color> overlay-border: root.light ? #fe640b : #fab387;
    /// Title of the learn overlay.
    in-out property <color> overlay-title: root.light ? #fe640b : #fab387;
    /// Main text of the learn overlay.
    in-out property <color> overlay-text: root.light ? #ffffff : #cdd6f4;
    /// Secondary text of the learn overlay.
    in-out property <color> overlay-soft: root.light ? #cccccc : #bac2de;
    /// Dim text of the learn overlay.
    in-out property <color> overlay-dim: root.light ? #888888 : #7f849c;
    /// Faintest text of the learn overlay.
    in-out property <color> overlay-faint: root.light ? #666666 : #6c7086;
    /// A mapped control in the learn overlay.
    in-out property <color> overlay-ok: root.light ? #79bc6b : #a6e3a1;
    /// A control that is bound in the learn overlay.
    in-out property <color> overlay-bound: root.light ? #40a02b : #94e2d5;
    /// A warning in the learn overlay.
    in-out property <color> overlay-warn: root.light ? #fe640b : #f9e2af;
    /// Background of the toast (the notice that fades in over the window).
    in-out property <color> toast-bg: root.light ? #2a2a2af2 : #313244f2;
    /// Text of the toast.
    in-out property <color> toast-text: root.light ? #eeeeee : #cdd6f4;
    /// Shadow of the toast.
    in-out property <color> toast-shadow: root.light ? #000000aa : #11111baa;

    // @group Text
    // Text
    /// The strongest text: titles, the label of a lit button, the track title. Must read on `accent` and `select`.
    in-out property <color> text-bright: root.light ? #11111b : #cdd6f4;
    /// Default text of lists, inputs and values.
    in-out property <color> text: root.light ? #4c4f69 : #bac2de;
    /// Labels (TRIM, HIGH, MID, LOW), artist, secondary values.
    in-out property <color> text-dim: root.light ? #6c6f85 : #9399b2;
    /// Disabled-looking glyphs, unit text.
    in-out property <color> text-faint: root.light ? #8c8fa1 : #7f849c;
    /// Text of a disabled control.
    in-out property <color> text-disabled: root.light ? #acb0be : #585b70;
    /// Secondary cells of the track list (artist, genre, comment, time).
    in-out property <color> row-dim: root.light ? #6c6f85 : #9399b2;
    /// The cells of a track list row whose track a deck has loaded.
    in-out property <color> row-loaded: root.light ? #11111b : #cdd6f4;

    // @group Accents
    // Functional accents
    /// ON state of nearly every toggle: SYNC, MASTER, Q, MT, AU, bank, panel toggles.
    in-out property <color> accent: root.light ? #1e66f5 : #59719e;
    /// A lighter accent: headings of the preferences, a synced BPM, glyphs on dark.
    in-out property <color> accent-hi: root.light ? #209fb5 : #89b4fa;
    /// PLAY / PAUSE ring and glyph. The loaded track's title is also this green.
    in-out property <color> play: root.light ? #40a02b : #a6e3a1;
    /// CUE ring and cue point marker.
    in-out property <color> cue: root.light ? #fe640b : #fab387;
    /// The SYNC button when it is on.
    in-out property <color> sync: root.light ? #1e66f5 : #59719e;
    /// The MASTER button when it is on.
    in-out property <color> master: root.light ? #1e66f5 : #59719e;
    /// BPM SYNC icon when on.
    in-out property <color> bpm-sync: root.light ? #df8e1d : #f9e2af;
    /// Alerts, SLIP lit, memory cue passed.
    in-out property <color> danger: root.light ? #d20f39 : #f38ba8;
    /// REC button and recording indicator.
    in-out property <color> rec: root.light ? #e64553 : #c6738c;
    /// Memory cue not yet reached.
    in-out property <color> memory-cue: root.light ? #ea76cb : #f5c2e7;
    /// Sampler slot play arrow.
    in-out property <color> sampler: root.light ? #8839ef : #cba6f7;

    // @group Waveform
    // Waveforms
    /// Background of the waveforms and overviews (drawn by Rust).
    in-out property <color> wave-bg: root.light ? #eff1f5 : #11111b;
    /// Low (bass) band of the waveforms.
    in-out property <color> wave-low: root.light ? #1e66f5 : #89b4fa;
    /// Mid band of the waveforms.
    in-out property <color> wave-mid: root.light ? #fe640b : #fab387;
    /// High band of the waveforms.
    in-out property <color> wave-high: root.light ? #5c5f77 : #cdd6f4;
    /// Playhead of the enlarged waveform and the slip ghost (the shadow playhead while SLIP diverges).
    in-out property <color> wave-playhead: root.light ? #4c4f69 : #f5e0dc;
    /// The shadow playhead drawn while SLIP diverges.
    in-out property <color> slip-ghost: root.light ? #04a5e5 : #89dceb;
    /// How much each waveform band darkens towards its outer edge (0..1): 0 = one flat colour per band, 1 = black at the edge, so the bright core stands out. Applies to every waveform.
    // @range 0..1
    in-out property <float> wave-fade: 0.0;

    // @group Decks and meters
    /// Stem accents: VOCAL green, INST red, DRUMS blue.
    in-out property <color> stem-vocal: root.light ? #40a02b : #a6e3a1;
    /// INST stem.
    in-out property <color> stem-inst: root.light ? #d20f39 : #f38ba8;
    /// DRUMS stem.
    in-out property <color> stem-drums: root.light ? #1e66f5 : #89b4fa;
    /// BASS stem (4 stems).
    in-out property <color> stem-bass: root.light ? #fe640b : #fab387;
    /// Deck number badges and "loaded on deck n" markers only.
    in-out property <color> deck1: root.light ? #1e66f5 : #89b4fa;
    /// Deck 2.
    in-out property <color> deck2: root.light ? #fe640b : #fab387;
    /// Deck 3.
    in-out property <color> deck3: root.light ? #8839ef : #cba6f7;
    /// Deck 4.
    in-out property <color> deck4: root.light ? #179299 : #94e2d5;
    /// The jog's outer ring and the disc inside it.
    in-out property <color> jog-ring: root.light ? #bcc0cc : #45475a;
    /// The disc inside the jog's ring.
    in-out property <color> jog-face: root.light ? #eff1f5 : #11111b;
    /// The playhead arc on the jog's ring.
    in-out property <color> jog-arc: root.light ? #d20f39 : #f38ba8;
    /// The big BPM figure in the jog.
    in-out property <color> jog-bpm: root.light ? #4c4f69 : #cdd6f4;
    /// The tempo offset text in the jog.
    in-out property <color> jog-text: root.light ? #6c6f85 : #a6adc8;
    /// The tempo range text (±6 %) in the jog.
    in-out property <color> jog-range: root.light ? #40a02b : #a6e3a1;
    /// Hot cue pads: 0 = a list (2 columns of 4 rows, a letter badge and the cue time), 1 = a grid (4 columns of
    /// 2 rows, every pad filled in its cue's colour).
    // @values list | grid
    in-out property <int> pad-style: 0;
    /// Saturation and brightness (0..1) of the key column's Camelot colours (the hue is the key's).
    // @range 0..1
    in-out property <float> key-sat: root.light ? 0.75 : 0.45;
    /// Brightness (0..1) of the key column's colours.
    // @range 0..1
    in-out property <float> key-val: root.light ? 0.75 : 1.0;
    /// Size of the deck header's title.
    in-out property <length> deck-title: 14px;
    /// Size of the artist line under the deck title.
    in-out property <length> deck-sub: 12px;
    /// Size of the BPM next to the artist (above `deck-sub` it is bold).
    in-out property <length> deck-bpm: 12px;
    // Level meters
    /// Level meters: the quiet part.
    in-out property <color> meter-lo: root.light ? #40a02b : #a6e3a1;
    /// Level meters: the middle part.
    in-out property <color> meter-mid: root.light ? #df8e1d : #f9e2af;
    /// Level meters: the loud part.
    in-out property <color> meter-hi: root.light ? #d20f39 : #f38ba8;

    // @group Typography
    // Typography
    /// Family of every text. A name that is not installed falls back to the system's default sans-serif.
    in-out property <string> font: "Liberation Sans";
    /// Smallest text: badges and tiny labels.
    in-out property <length> font-xs: 9px;
    /// Small text: labels, buttons, hints.
    in-out property <length> font-sm: 10px;
    /// Default text (track list, tree, inputs).
    in-out property <length> font-size: 11px;
    /// Medium text: headings of the preferences, dialog titles.
    in-out property <length> font-md: 12px;
    /// Deck title, elapsed / remaining time.
    in-out property <length> font-lg: 14px;
    /// Large text.
    in-out property <length> font-xl: 18px;
    /// Jog-centre BPM integer part.
    in-out property <length> font-xxl: 22px;
    /// Normal font weight.
    in-out property <int> weight: 400;
    /// Bold font weight (buttons, labels).
    in-out property <int> weight-bold: 700;
    /// Text size of the toast.
    in-out property <length> font-toast: 13px;
    /// Semi-bold font weight.
    in-out property <int> weight-semi: 600;

    // @group Sizes
    /// Presentation profile: 0 desktop workspace, 1 touch workspace, 2 stage workspace (one window: waveforms, a deck panel per side, a central mixer, the library under them; its look is the Stage tokens below). Same application features in all three.
    // @values desktop | touch | stage
    in-out property <int> layout-profile: 0;
    /// Width below which the touch workspace presents one selected deck instead of two columns.
    in-out property <length> touch-breakpoint: 760px;
    /// Minimum primary control size in the touch presentation.
    in-out property <length> touch-target: 44px;
    /// Glyph size inside shared buttons, independent of the control's hit area.
    in-out property <length> icon-size: 14px;
    // Spacing and radii
    /// Gap between panels.
    in-out property <length> gap: 2px;
    /// Spacing, smallest step.
    in-out property <length> space-xs: 2px;
    /// Spacing, small step.
    in-out property <length> space-sm: 4px;
    /// Spacing, medium step.
    in-out property <length> space-md: 6px;
    /// Spacing, large step.
    in-out property <length> space-lg: 8px;
    /// Spacing, largest step.
    in-out property <length> space-xl: 12px;
    /// Corner radius of buttons and inputs.
    in-out property <length> radius: 2px;
    /// Corner radius of cards and dialogs.
    in-out property <length> radius-lg: 4px;
    /// Corner radius, largest.
    in-out property <length> radius-xl: 6px;
    /// Thickness of the `deck-frame` outline around each deck panel.
    in-out property <length> deck-frame-w: 0px;

    // Heights and widths of the shared regions
    /// Height of the global bar (and dialog title bars).
    in-out property <length> h-bar: 28px;
    /// Height of the status bar.
    in-out property <length> h-status: 22px;
    /// Height of buttons and inputs.
    in-out property <length> h-ctl: 22px;
    /// Height of small buttons.
    in-out property <length> h-ctl-sm: 18px;
    /// Height of panel and column headers.
    in-out property <length> h-header: 20px;
    /// Row height of the browse lists (VIEW > Browse > Line Space); set from Rust.
    in property <length> h-row: 22px;
    /// Character size / weight of the browse lists (VIEW > Browse > FontSize, bold); set from Rust.
    in property <length> list-font: 11px;
    in property <int> list-weight: 400;
    /// Height of the browser tabs.
    in-out property <length> h-tab: 22px;
    /// Height of the browser toolbar and the mixer strip.
    in-out property <length> h-toolbar: 28px;
    /// Height of each enlarged waveform with 2 decks (horizontal layout).
    in-out property <length> h-wave-2: 56px;
    /// Height of each enlarged waveform with 4 decks (horizontal layout).
    in-out property <length> h-wave-4: 44px;
    /// Height of the deck's full-track waveform.
    in-out property <length> h-overview: 36px;
    /// Height of the phrase strip under it.
    in-out property <length> h-phrase: 14px;
    /// Height of a deck panel with 2 decks.
    in-out property <length> h-deck-2: 240px;
    /// Height of a deck panel with 4 decks.
    in-out property <length> h-deck-4: 132px;
    /// Optional panels (toggled from the global bar).
    in-out property <length> h-fx: 110px;
    /// Height of the MIX POINT LINK panel.
    in-out property <length> h-mixpoint: 96px;
    /// Height of the sampler panel.
    in-out property <length> h-sampler: 96px;
    /// Width of one mixer channel.
    in-out property <length> w-channel: 52px;
    /// Diameter of the jog.
    in-out property <length> jog: 112px;
    /// Diameter of the CUE and PLAY buttons.
    in-out property <length> ring: 36px;

    // @group Stage
    /// Stage workspace (layout-profile 2): where the enlarged waveforms sit. 0 = stacked across the top, 1 = in a centre column between the decks (above the mixer), 2 = inside each deck panel.
    // @values top | centre | decks
    in-out property <int> stage-wave: 0;
    /// Stage deck panel: 0 = performance (pad grid, LOOP, BEAT FX, jog ring), 1 = turntable (big platter with the cover art, hot cue list, tempo fader), 2 = controller (a row of EQ / filter knobs, big CUE / PLAY / SYNC buttons), 3 = ring (a large tempo ring with the BPM, round PLAY / CUE, tempo fader).
    // @values performance | turntable | controller | ring
    in-out property <int> stage-deck: 0;
    /// Stage hot cue pads: 0 = numbered grid (1-8, outlined, the lit one in the deck colour), 1 = cue list (A-F rows with the cue time and a delete cross), 2 = grid filled in each cue's colour.
    // @values numbered grid | cue list | coloured grid
    in-out property <int> stage-pads: 0;
    /// Stage mixer: 0 = two channels, 1 = four channels (decks 3 and 4 follow the controller's layers).
    // @values two channels | four channels
    in-out property <int> stage-mixer: 0;
    /// Tabs over the Stage mixer: 0 = none, 1 = MIXER / FX / REC, 2 = MIXER / VIDEO / LIGHTING.
    // @values none | MIXER FX REC | MIXER VIDEO LIGHTING
    in-out property <int> stage-tabs: 0;
    /// A strip under the Stage decks: 0 = none, 1 = EFFECTS (left), SOUND COLOR FX and SAMPLER (right).
    // @values none | effects and sampler
    in-out property <int> stage-strip: 0;
    /// Stage track list: 1 = a waveform preview column and a badge naming the deck a track is loaded on.
    // @values off | on
    in-out property <int> stage-list-wave: 0;
    /// Stage library side bar: 0 = icon and label per entry, 1 = icons only.
    // @values labels | icons only
    in-out property <int> stage-sidebar: 0;
    /// Stage right-hand deck: 0 = the same left-to-right arrangement as the left deck, 1 = mirrored (jog and buttons on the outer side).
    // @values same | mirrored
    in-out property <int> stage-mirror: 1;
    /// Width of the Stage mixer.
    in-out property <length> stage-mixer-w: 280px;
    /// Height of each enlarged waveform in the Stage workspace.
    in-out property <length> stage-wave-h: 64px;
    /// Spacing between the Stage panels (and the window edge).
    in-out property <length> stage-gap: 8px;
    /// Corner radius of the Stage panels.
    in-out property <length> stage-radius: 10px;
    /// Corner radius of the Stage buttons, pads, tabs and fields.
    in-out property <length> stage-radius-ctl: 6px;
    /// Side of the cover art in the Stage deck panels.
    in-out property <length> stage-cover: 80px;
    /// Row height of the Stage track list.
    in-out property <length> stage-row: 30px;
    /// Height of the Stage big CUE / PLAY / SYNC buttons (diameter when round).
    in-out property <length> stage-button: 44px;
    /// Diameter of the Stage jog (ring or platter).
    in-out property <length> stage-jog: 180px;

    // @group Style
    /// Neon glow (0..1) around lit controls, the jog ring and the playheads of the Stage workspace; 0 = none.
    // @range 0..1
    in-out property <float> glow: 0.0;
    /// Raised / inset shading (0..1) of the Stage buttons, knobs and panels; 0 = flat.
    // @range 0..1
    in-out property <float> bevel: 0.0;
    /// Stage buttons: 0 = filled, 1 = outlined (the lit one glows in its colour), 2 = raised (bevelled caps).
    // @values filled | outlined | raised
    in-out property <int> button-style: 0;
    /// Stage jog: 0 = ring with the BPM inside, 1 = vinyl platter showing the cover art, 2 = thin ring with the beat ticks.
    // @values ring | platter | ticks
    in-out property <int> jog-style: 0;
    /// Top colour of the Stage panels' vertical gradient (the bottom is `panel`); `panel` = no gradient.
    in-out property <color> panel-top: root.panel;
    /// Outline of the Stage panels; transparent = none.
    in-out property <color> panel-border: #00000000;
    /// 1 = each deck's controls take its deck colour (jog arc, PLAY / CUE rims, lit pads, knob arcs, meters, deck badge); 0 = the shared accents.
    // @values off | on
    in-out property <int> deck-tint: 0;
    /// Second colour of each deck: gradients and the mid band of its waveform when `wave-style` is 1.
    in-out property <color> deck1-hi: root.light ? #04a5e5 : #b4befe;
    /// Deck 2's second colour.
    in-out property <color> deck2-hi: root.light ? #df8e1d : #f9e2af;
    /// Deck 3's second colour.
    in-out property <color> deck3-hi: root.light ? #ea76cb : #f5c2e7;
    /// Deck 4's second colour.
    in-out property <color> deck4-hi: root.light ? #40a02b : #a6e3a1;
    /// Waveform colours: 0 = the shared bands (`wave-low`, `wave-mid`, `wave-high`), 1 = per deck (low = `deckN`, mid = `deckN-hi`, high = `wave-high`).
    // @values shared | per deck
    in-out property <int> wave-style: 0;
    /// Stage workspace: 1 = a bar ruler (the bar numbers, stepping with the zoom) along the top of the enlarged waveforms stacked across the top or in the centre column; hidden while a track has no beat grid.
    // @values off | on
    in-out property <int> wave-ruler: 0;
    /// Family of the big figures (BPM, times, deck numbers); empty = `font`.
    in-out property <string> font-display: "";
    /// Weight of the big figures.
    in-out property <int> weight-display: 600;
    /// `font-display`, or `font` when that is empty: the family UI code uses for the big figures (not a token: it follows the two).
    out property <string> display-font: root.font-display == "" ? root.font : root.font-display;

    public pure function target-size(size: length) -> length {
        return root.layout-profile == 1 ? max(size, root.touch-target) : size;
    }

    // @group Library tree and track menu
    // Library tree and track menu
    /// How much bigger than a list row the text of a tree heading (My Playlists, History, Devices …) is.
    in-out property <length> tree-heading-grow: 2px;
    /// How much taller than a list row a tree heading is.
    in-out property <length> tree-heading-extra: 10px;
    /// Text of the tree headings.
    in-out property <color> tree-heading: root.text-bright;
    /// Glyph of the tree headings.
    in-out property <color> tree-heading-icon: root.accent-hi;
    /// Indent of each level of the tree.
    in-out property <length> tree-indent: 14px;
    /// The glyph before every list of the tree (playlist, folder, history day, stick …); headings keep theirs.
    // @values off | on
    in-out property <int> tree-icons: 1;
    /// A hairline above each tree heading.
    // @values off | on
    in-out property <int> tree-lines: 1;
    /// Track right-click menu: its six groups side by side in two columns, or one under the other.
    // @values two columns | one column
    in-out property <int> menu-layout: 0;
    /// Width of a column of the track menu.
    in-out property <length> menu-col-w: 210px;
    /// Group titles of the track menu (PLAY, PLAYLISTS, USB …) and their glyphs.
    in-out property <color> menu-heading: root.accent-hi;
    /// The item the controller's browse knob (or the arrow keys) is on in an open menu.
    in-out property <color> menu-focus: root.accent;
    /// A line between the groups of the track menu.
    // @values off | on
    in-out property <int> menu-lines: 1;

    // @group Motion
    // Motion
    /// Hover and press fades of buttons.
    in-out property <duration> t-fast: 80ms;
    /// Toast fade.
    in-out property <duration> t-fade: 180ms;
    /// Hover time before a tooltip shows.
    in-out property <duration> tooltip-delay: 600ms;
}
