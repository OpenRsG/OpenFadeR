<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="OpenFadeR" android:icon="@drawable/openfader"
        android:hasCode="true" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:enableOnBackInvokedCallback="true">
        <activity android:name=".OpenFaderActivity" android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:resizeableActivity="false" android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="openfader_mobile" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
