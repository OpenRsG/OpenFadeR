import { ComboBox } from "std-widgets.slint";
import { Theme, DeckState, DeckView, MobileState } from "state.slint";
import { DJButton, TouchFader, Icon } from "widgets.slint";
import { Platter } from "platter.slint";

export component DeckPanel inherits Rectangle {
    in property <int> index;
    in property <bool> compact;
    in property <DeckView> deck: DeckState.decks[root.index];
    property <color> tone: root.index == 0 ? Theme.deck1 : Theme.deck2;
    in property <bool> tight;
    vertical-stretch: 1;
    background: Theme.deck-bg;
    VerticalLayout {
        padding: 6px; spacing: 2px;
        Rectangle {
            height: 44px;
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 28px; height: 28px; border-radius: 4px;
                    background: root.tone.darker(4);
                    Text { text: root.index == 0 ? "A" : "B"; color: root.tone; font-size: 18px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                }
                VerticalLayout {
                    min-width: 0px; spacing: 2px; alignment: center;
                    Text { text: root.deck.loading ? "Loading…" : root.deck.title; color: root.deck.ready ? Theme.text-bright : Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
                    Text { text: root.deck.ready ? root.deck.artist : "Tap here to load music"; color: Theme.text-dim; font-size: 12px; overflow: elide; }
                }
                VerticalLayout {
                    min-width: 64px; horizontal-stretch: 0; alignment: center; spacing: 0px;
                    Text { text: root.deck.bpm; color: root.tone; font-size: 22px; font-weight: 700; horizontal-alignment: right; }
                    Text { text: root.deck.ready ? root.deck.key : "BPM"; color: Theme.text; font-size: 12px; horizontal-alignment: right; }
                }
            }
            TouchArea { clicked => { MobileState.view = 1; } }
            accessible-role: button;
            accessible-label: "Open library for deck " + (root.index == 0 ? "A" : "B");
        }
        Rectangle {
            min-height: 44px; preferred-height: 44px; max-height: root.compact ? 10000px : 44px;
            vertical-stretch: root.compact ? 1 : 0; background: Theme.wave-bg;
            Image { width: parent.width; height: parent.height - 18px; source: root.deck.wave; image-fit: fill; }
            Rectangle { y: parent.height - 3px; height: 3px; width: parent.width * root.deck.position; background: root.tone; }
            Rectangle { x: clamp(parent.width * root.deck.position - 1px, 0px, parent.width - 2px); width: 2px; background: Theme.wave-playhead; }
            Text { x: 4px; y: parent.height - 17px; height: 14px; text: root.deck.ready ? root.deck.time : "— / —"; color: Theme.text-bright; font-size: 12px; }
            if !root.deck.ready: Text {
                text: root.deck.loading ? "Decoding and detecting beats…" : "Load a track from Library";
                color: Theme.text; font-size: 13px; horizontal-alignment: center; vertical-alignment: center;
            }
            accessible-role: slider;
            accessible-label: "Seek deck " + (root.index == 0 ? "A" : "B");
            accessible-value: root.deck.time;
            TouchArea {
                enabled: root.deck.ready;
                pointer-event(e) => {
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                        DeckState.seek(root.index, clamp(self.mouse-x / self.width, 0, 1));
                    }
                }
                moved => { if self.pressed { DeckState.seek(root.index, clamp(self.mouse-x / self.width, 0, 1)); } }
            }
        }
        if !root.tight: HorizontalLayout {
            height: 44px; spacing: 2px;
            DJButton { text: "SYNC"; width: 52px; enabled: root.deck.ready; tone: root.tone; clicked => { DeckState.sync(root.index); } }
            DJButton { icon: Icon.lock; width: 44px; label: "Key lock deck " + (root.index == 0 ? "A" : "B"); active: root.deck.key-lock; enabled: root.deck.ready; tone: root.tone; clicked => { DeckState.key-lock(root.index); } }
            ComboBox {
                min-width: 64px; height: 44px;
                model: ["1 beat", "2 beats", "4 beats", "8 beats", "16 beats"];
                current-index: root.deck.loop-index; accessible-label: "Loop length in beats";
                selected(v) => { DeckState.loop-size(root.index, self.current-index); }
            }
            DJButton {
                width: 44px; icon: Icon.loop; active: root.deck.looping; enabled: root.deck.ready; tone: root.tone;
                label: (root.deck.looping ? "Exit loop deck " : "Enable beat loop deck ") + (root.index == 0 ? "A" : "B");
                clicked => { DeckState.loop(root.index, root.deck.loop-index); }
            }
        }
        if !root.compact: HorizontalLayout {
            min-height: 96px; vertical-stretch: 1; spacing: 4px;
            Platter { index: root.index; horizontal-stretch: 1; }
            VerticalLayout {
                width: 48px; horizontal-stretch: 0; spacing: 0px;
                Text { height: 18px; text: "±16%"; color: Theme.text-dim; font-size: 11px; horizontal-alignment: center; }
                TouchFader {
                    vertical: true; vertical-stretch: 1; detent: true;
                    value: (16 - root.deck.tempo) / 32; tone: root.tone; enabled: root.deck.ready;
                    label: "Tempo deck " + (root.index == 0 ? "A" : "B");
                    edited(v) => { DeckState.tempo(root.index, 16 - v * 32); }
                }
                Text { height: 18px; text: (root.deck.tempo > 0 ? "+" : "") + round(root.deck.tempo * 10) / 10 + "%"; color: Theme.text; font-size: 12px; horizontal-alignment: center; }
            }
        }
        if root.compact: HorizontalLayout {
            height: 44px; spacing: 4px;
            Text { text: "Pitch"; color: Theme.text; font-size: 12px; horizontal-stretch: 0; }
            TouchFader {
                detent: true; value: (root.deck.tempo + 16) / 32; tone: root.tone; enabled: root.deck.ready;
                label: "Tempo deck " + (root.index == 0 ? "A" : "B") + ", minus to plus 16 percent";
                edited(v) => { DeckState.tempo(root.index, v * 32 - 16); }
            }
            Text { min-width: 42px; text: (root.deck.tempo > 0 ? "+" : "") + round(root.deck.tempo * 10) / 10 + "%"; color: Theme.text; font-size: 12px; horizontal-alignment: right; }
        }
        HorizontalLayout {
            height: 44px; spacing: 4px;
            DJButton {
                width: 48px; icon: root.deck.playing ? Icon.pause : Icon.play; round-face: true;
                active: root.deck.playing; enabled: root.deck.ready; tone: Theme.play;
                label: (root.deck.playing ? "Pause deck " : "Play deck ") + (root.index == 0 ? "A" : "B");
                clicked => { DeckState.play(root.index); }
            }
            DJButton { text: "CUE"; tone: Theme.cue; enabled: root.deck.ready; clicked => { DeckState.cue(root.index, false); } }
            DJButton { text: "SET CUE"; tone: Theme.cue; enabled: root.deck.ready; clicked => { DeckState.cue(root.index, true); } }
        }
    }
}
